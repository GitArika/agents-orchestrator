#!/usr/bin/env python3
"""orq — orquestrador de esteiras: despacha agentes auto-contidos por unidade
de trabalho.

Divisão de autoridade, de propósito:
  * o banco SQLite (por esteira, fora do repositório) -> status, dependências,
    configuração e o rastro de eventos — a ÚNICA fonte de verdade da esteira.
  * o ClickUp -> conteúdo de cada tarefa (descrição, comentários). O motor não
    fala com ele; quem lê e escreve é o agente, por `orq-clickup`.
  * os processos -> o que está vivo agora (derivado por checagem do sistema
    operacional — tmux/PID —, nunca gravado como autoridade).

Isto substitui o motor anterior, guiado por `pipeline.toml` e pelo ClickUp em
todo ciclo — removido em 22/09/2026 (OA-04,
docs/specs/orquestrador-agil/OA-04-motor-sem-clickup.md). `orq doctor` ainda
não existe: dependia do motor removido, e volta com checagem de verdade
contra o banco em OA-12.

MAPA DO ARQUIVO. Este motor é um arquivo só de propósito: é o que faz a
instalação ser um symlink e não haver dependência para dar errado na máquina de
outra pessoa. As seções abaixo são a divisão interna; localize-as por
`grep -n '^# ---' bin/orq`, que devolve a linha de cada uma.

  estado (SQLite)          esquema, transação, versionamento — o núcleo (OA-01)
  estado — verbos          init/task/dep/config/export/validate (OA-02)
  estado — máquina         as cinco transições legais, sessão viva, fila de
  de cinco estados         despacho, board/next/status/show (com o ⚠ de
                           espelho divergente — OA-07), hold/release/
                           reopen/advance/tick (OA-03)
  estado — sessão e        worktree, briefing único (contrato do ClickUp —
  lançamento               OA-07), cerca, capacidade, run/dispatch/attach/
                           log/stop (OA-05)
  estado — vigia de PR     consulta ao gh, transições que ela dispara,
                           encerramento em 'pronto' e o espelho no ClickUp
                           (OA-07/OA-08)
  estado — roteamento      uma origem só (transacao()) para todo aviso —
  de avisos                roteamento, antirrepetição, avisos_silenciados
                           (OA-11)
  estado — retrabalho a    escopo a partir da revisão de verdade, relança
  partir do PR             na mesma worktree/branch, o teto (OA-09)
  estado — laço autônomo   vigia → recolhe → despacha a cada ciclo, e a
                           parada por ociosidade — comando `loop` (OA-08)
  pré-voo                  cada prova por chamada real, nunca por declaração
                           — comando `doctor` (OA-12)
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import threading
import time
import unicodedata
from contextlib import contextmanager
from pathlib import Path

# O repositório resolve os PRÓPRIOS recursos em relação a si mesmo (hooks/,
# modelos/): instalar é um symlink para bin/orq, e `git pull` tem de atualizar
# tudo junto. Nada usa isto ainda depois de OA-04 tirar o ClickUp e o
# pipeline.toml daqui — fica pronto para quando OA-05/OA-06 precisarem de
# novo achar `hooks/cerca.sh`.
ORQ_REPO = Path(__file__).resolve().parent.parent

# O ESTADO fica onde sempre esteve. Mudar este caminho transformaria a adoção nas
# máquinas que já rodam a versão anterior numa migração, com risco de perder o
# rastro de uma sessão viva.
ORQ_HOME = Path.home() / ".claude" / "orchestrator"
STATE = ORQ_HOME / "state"

C = {"r": "\033[0m", "b": "\033[1m", "d": "\033[2m", "red": "\033[31m",
     "grn": "\033[32m", "yel": "\033[33m", "blu": "\033[34m",
     "mag": "\033[35m", "cyn": "\033[36m"}
if not sys.stdout.isatty():
    C = {k: "" for k in C}


def die(msg: str, code: int = 1):
    print(f"{C['red']}erro:{C['r']} {msg}", file=sys.stderr)
    sys.exit(code)


def slugify(text: str, maxlen: int = 40) -> str:
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    text = re.sub(r"[^a-zA-Z0-9]+", "-", text).strip("-").lower()
    return re.sub(r"-{2,}", "-", text)[:maxlen].strip("-")


def norm(s: str) -> str:
    """Compara status sem tropeçar em acento, caixa ou espaço extra."""
    s = unicodedata.normalize("NFKD", str(s)).encode("ascii", "ignore").decode()
    return re.sub(r"\s+", " ", s).strip().lower()


# ---------------------------------------------------------------- estado (SQLite)
#
# Substituiu TRÊS lugares que não se coordenavam entre si: o `pipeline.toml`
# versionado (grafo), o ClickUp (status) e `state/loop-<esteira>.json` (strikes,
# quarentena, bloqueios) — o terceiro sem lock nenhum: `tick()` lia o arquivo,
# gastava minutos em rede e lançamento de sessão, e só então gravava por cima
# com `write_text`, que apaga o arquivo antes de escrever. Uma queda no meio
# deixava JSON inválido, e `loop_state` engolia a exceção e devolvia estado
# VAZIO — quarentena e bloqueios sumindo em silêncio. Ver
# docs/specs/orquestrador-agil/OA-01-nucleo-sqlite.md.
#
# OA-02 (verbos), OA-03 (máquina de estados) e OA-04 (remoção do
# pipeline.toml/ClickUp) já ligaram tudo isto aos comandos — não há mais motor
# nenhum por trás.

VERSAO_ESQUEMA = 3

BANCOS = Path.home() / ".config" / "orquestrador" / "esteiras"

ESQUEMA_SQL = """
CREATE TABLE esquema (versao INTEGER NOT NULL);
INSERT INTO esquema (versao) VALUES (3);

CREATE TABLE config (
  chave TEXT PRIMARY KEY,
  valor TEXT NOT NULL
);

CREATE TABLE unidade (
  id            INTEGER PRIMARY KEY,
  chave         TEXT NOT NULL UNIQUE,
  clickup_id    TEXT UNIQUE,
  titulo        TEXT NOT NULL,
  status        TEXT NOT NULL DEFAULT 'backlog'
                CHECK (status IN ('backlog','em_progresso','revisao','pronto','bloqueado')),
  motivo        TEXT NOT NULL DEFAULT '',
  modo          TEXT NOT NULL DEFAULT 'autonomous',
  prioridade    INTEGER NOT NULL DEFAULT 2,
  branch        TEXT,
  pr_numero     INTEGER,
  pr_url        TEXT,
  strikes       INTEGER NOT NULL DEFAULT 0,
  retrabalho    INTEGER NOT NULL DEFAULT 0,
  retrabalho_em TEXT,     -- carimbo do último relançamento (OA-09) — só
                          -- revisão/comentário POSTERIOR a isto entra no
                          -- próximo briefing; NULL nunca filtra nada
  solta_em      TEXT,     -- bilhete de uso único do `orq release` (OA-03):
                          -- consumido pelo primeiro recolhimento, para uma
                          -- unidade liberada não contar falta antes de ter
                          -- a chance de ser despachada de novo
  vigia_falhas  INTEGER NOT NULL DEFAULT 0,   -- falhas SEGUIDAS do `gh` nesta
                          -- unidade (OA-08); zera na primeira consulta que
                          -- responde
  pr_draft      INTEGER NOT NULL DEFAULT 0,   -- `isDraft` da última consulta
                          -- do vigia (OA-08) — só para o quadro mostrar
                          -- "rascunho"; nunca decide transição
  criado_em     TEXT NOT NULL,
  atualizado_em TEXT NOT NULL
);

CREATE TABLE dependencia (
  unidade_id INTEGER NOT NULL REFERENCES unidade(id) ON DELETE CASCADE,
  depende_de INTEGER NOT NULL REFERENCES unidade(id) ON DELETE CASCADE,
  PRIMARY KEY (unidade_id, depende_de),
  CHECK (unidade_id <> depende_de)
);

-- Append-only: é o rastro. Nenhuma escrita aqui é apagada ou reescrita, só
-- inserida — é o que permite reconstruir o que aconteceu quando o resto
-- divergir (o cartão do ClickUp, uma pessoa perguntando "o que houve aqui?").
CREATE TABLE evento (
  id          INTEGER PRIMARY KEY,
  unidade_id  INTEGER REFERENCES unidade(id) ON DELETE SET NULL,
  tipo        TEXT NOT NULL,
  de_status   TEXT,
  para_status TEXT,
  texto       TEXT NOT NULL DEFAULT '',
  ts          TEXT NOT NULL
);

CREATE TABLE sessao (
  id           INTEGER PRIMARY KEY,
  unidade_id   INTEGER NOT NULL REFERENCES unidade(id) ON DELETE CASCADE,
  tmux         TEXT,
  pid          INTEGER,
  worktree     TEXT NOT NULL,
  branch       TEXT NOT NULL,
  iniciada_em  TEXT NOT NULL,
  encerrada_em TEXT,
  desfecho     TEXT
);
"""


class ErroEstado(Exception):
    """Banco ilegível, corrompido, ou de versão que este binário não conhece.

    Nunca é engolida em silêncio: o defeito que este módulo substitui é
    justamente `loop_state` devolvendo `{}` quando o JSON não abria, e a
    esteira seguindo em frente como se quarentena e bloqueios não existissem.
    """


def caminho_banco_padrao(nome: str) -> Path:
    """Onde o banco de uma esteira mora, por convenção.

    Um arquivo por esteira, fora do repositório: esteira travada não segura a
    outra, e o descarte — apagar o arquivo — é por esteira.

    A resolução COMPLETA (--db, $ORQ_DB, casar com o repositório atual, o
    último banco usado) é `resolver_banco` (OA-03). Esta função só sabe o
    nome canônico do arquivo.
    """
    return BANCOS / f"{slugify(nome, 40)}.db"


def _pragmas(con: sqlite3.Connection) -> None:
    """As três garantias que fazem a fila existir sem daemon nenhum.

    WAL: leitor nunca espera o escritor. `foreign_keys`: uma dependência não
    pode apontar para unidade que não existe. `busy_timeout`: quem chega
    segundo enquanto outro escritor está com o lock espera no KERNEL até 10s
    em vez de falhar na hora — é o enfileiramento que o requisito pede, de
    graça, sem processo novo para subir, cair e precisar ser diagnosticado.
    """
    con.execute("PRAGMA journal_mode = WAL")
    con.execute("PRAGMA foreign_keys = ON")
    con.execute("PRAGMA busy_timeout = 10000")


def criar_banco(caminho: Path, *, forcar: bool = False) -> sqlite3.Connection:
    """Cria o banco de uma esteira nova, com o esquema completo.

    Recusa sobrescrever por acidente: um banco existente carrega o estado de
    unidades de verdade, e `criar` não é o verbo para apagar isso. `--forcar`
    é escolha explícita de quem chama, não comportamento padrão.
    """
    caminho = Path(caminho)
    if caminho.exists() and not forcar:
        die(f"banco já existe: {caminho}\n  Use --forcar para recriar do zero, "
            f"apagando tudo que está nele.")
    caminho.parent.mkdir(parents=True, exist_ok=True)
    if forcar and caminho.exists():
        caminho.unlink()
    con = sqlite3.connect(caminho)
    con.row_factory = sqlite3.Row
    _pragmas(con)
    con.executescript(ESQUEMA_SQL)
    con.commit()
    caminho.chmod(0o600)
    return con


def _migrar(con: sqlite3.Connection, de_versao: int) -> None:
    """Aplica as migrações em ordem, dentro da MESMA transação da abertura —
    nunca `--forcar`, que apagaria o estado de gente de verdade.

    1 → 2 (OA-08): `unidade` ganha `vigia_falhas` e `pr_draft`, que o vigia
    de PR precisa para não confundir uma falha de rede com três seguidas, e
    para o quadro distinguir PR rascunho de PR pedindo revisão de verdade.

    2 → 3 (OA-09): `unidade` ganha `retrabalho_em`, o carimbo que impede o
    retrabalho de repetir, no segundo relançamento, um achado de revisão já
    corrigido no primeiro.
    """
    if de_versao == 1:
        con.execute("ALTER TABLE unidade ADD COLUMN vigia_falhas INTEGER NOT NULL DEFAULT 0")
        con.execute("ALTER TABLE unidade ADD COLUMN pr_draft INTEGER NOT NULL DEFAULT 0")
        con.execute("UPDATE esquema SET versao = 2")
        de_versao = 2
    if de_versao == 2:
        con.execute("ALTER TABLE unidade ADD COLUMN retrabalho_em TEXT")
        con.execute("UPDATE esquema SET versao = 3")
        de_versao = 3
    if de_versao != VERSAO_ESQUEMA:
        raise ErroEstado(
            f"banco na versão {de_versao}, e este binário não tem migração "
            f"cadastrada para chegar à {VERSAO_ESQUEMA}.")


def abrir_banco(caminho: Path) -> sqlite3.Connection:
    """Abre um banco existente e confere a versão do esquema antes de devolver.

    Três recusas, de propósito, e nenhuma delas inventa um estado vazio para
    seguir em frente:

      * arquivo não existe -> erro dizendo o caminho, não banco "novo" silencioso;
      * ilegível ou corrompido -> erro com a causa do SQLite, não estado zerado;
      * versão maior que a que este binário conhece -> erro dizendo para
        atualizar, nunca ignora o que não entende.

    Versão MENOR aplica migração, dentro de transação: ou o banco chega
    inteiro na versão atual, ou nada muda.
    """
    caminho = Path(caminho)
    if not caminho.exists():
        raise ErroEstado(f"banco não encontrado: {caminho}")
    try:
        con = sqlite3.connect(caminho)
        con.row_factory = sqlite3.Row
        _pragmas(con)
        row = con.execute("SELECT versao FROM esquema").fetchone()
    except sqlite3.DatabaseError as e:
        raise ErroEstado(f"banco ilegível ou corrompido: {caminho}\n  {e}") from e
    if row is None:
        raise ErroEstado(f"banco sem tabela de esquema em {caminho} — "
                         f"versão desconhecida, recuso adivinhar.")
    versao = row["versao"]
    if versao > VERSAO_ESQUEMA:
        con.close()
        raise ErroEstado(
            f"banco na versão {versao}; este binário só conhece até "
            f"{VERSAO_ESQUEMA}. Atualize o orquestrador antes de usar este banco.")
    if versao < VERSAO_ESQUEMA:
        with con:
            _migrar(con, versao)
    return con


@contextmanager
def transacao(caminho: Path):
    """O ÚNICO ponto de escrita do estado. Todo `UPDATE`/`INSERT` passa por aqui.

    `BEGIN IMMEDIATE` pega o lock de escrita JÁ na entrada, não na primeira
    instrução de escrita — com o `BEGIN` implícito do sqlite3, dois escritores
    só descobrem que colidiram no COMMIT, um deles depois de já ter feito todo
    o trabalho. Com `IMMEDIATE`, o segundo a chegar espera no `busy_timeout`
    (10s) e SEGUE dali, sem refazer nada.

    Falhar dentro do bloco desfaz tudo — nunca fica meio gravado. É a garantia
    que falta em `save_loop_state` hoje: `write_text` trunca o arquivo antes de
    escrever, e uma queda no meio deixa JSON inválido para sempre.

    Ao sair, DEPOIS do commit e com o lock já liberado, roteia para aviso
    (OA-11) todo evento que esta transação gravou — é o que faz "quem grava a
    transição emite o aviso" ser verdade sem uma chamada de emissão solta por
    aí.
    """
    con = abrir_banco(caminho)
    try:
        con.execute("BEGIN IMMEDIATE")
        marca = con.execute("SELECT COALESCE(max(id), 0) FROM evento").fetchone()[0]
        yield con
        con.commit()
    except BaseException:
        con.rollback()
        raise
    finally:
        con.close()
    _avisar_eventos_desde(caminho, marca)


def _agora() -> str:
    return time.strftime("%FT%TZ", time.gmtime())


def registrar_evento(con: sqlite3.Connection, unidade_id: int | None, tipo: str,
                     *, de_status: str | None = None, para_status: str | None = None,
                     texto: str = "") -> None:
    """Grava uma linha no rastro append-only, na transação corrente.

    Toda função de escrita deste módulo chama isto antes de devolver — nunca
    depois, e nunca numa transação separada. Rastro que pode divergir do
    estado que ele descreve não é rastro, é boato.
    """
    con.execute(
        "INSERT INTO evento (unidade_id, tipo, de_status, para_status, texto, ts) "
        "VALUES (?, ?, ?, ?, ?, ?)",
        (unidade_id, tipo, de_status, para_status, texto, _agora()))


# ---------------------------------------------------------------- estado — roteamento
# de avisos (OA-11)
#
# Uma origem só: a transição de estado. Nenhuma chamada de emissão solta pelos
# comandos — quem grava o evento (`registrar_evento`, acima) é quem, por
# baixo de `transacao()`, aciona o aviso. É o que garante que aviso e estado
# nunca discordem. Ver
# docs/specs/orquestrador-agil/OA-11-roteamento-de-eventos-e-avisos.md.

ROTEAMENTO_AVISOS = {
    "despachada":        "tarefa iniciada por um agente",
    "pr_aberto":         "PR aberto por um agente",
    "bloqueada":         "tarefa bloqueada",
    "pr_fechado":        "tarefa bloqueada — PR fechado sem merge",
    "pr_fundido":        "PR fundido — unidade concluída",
    "pr_fundido_manual": "PR fundido fora do fluxo — unidade concluída",
    "retrabalho":        "revisão pediu mudanças — retrabalho",
    "recolhida":         "sessão recolhida, volta para a fila",
    "espelho_falhou":    "falha ao espelhar o status no ClickUp",
    "vigia_alerta":      "vigia de PR fora do ar",
    "teardown_falhou":   "falha ao encerrar o ambiente da unidade",
    "laco_parou":        "laço autônomo parado",
    "esteira_concluida": "esteira concluída — nada pendente",
}   # "declaracao" (verbos de OA-02) fica de fora de propósito — ato humano,
    # quem digitou já sabe.

# `vigia_falhou` (a cada falha isolada do gh) não está no roteamento acima —
# a regra "só avisa na terceira falha seguida" (OA-08/OA-11) já é satisfeita
# na ORIGEM: `vigiar_prs` só grava `vigia_alerta` exatamente na 3ª seguida, e
# nunca mais que uma vez por sequência. Rotear `vigia_alerta` em vez de
# `vigia_falhou` evita duplicar essa contagem aqui.

AVISOS_OBRIGATORIOS = frozenset({"despachada", "pr_aberto", "bloqueada"})   # nunca cortáveis
JANELA_ANTIRREPETICAO_MIN = 5


def _avisos_cortados(con: sqlite3.Connection) -> set[str]:
    """`orq config set avisos_silenciados <lista>` corta eventos operacionais
    quando o volume incomodar. Os três do requisito nunca saem daqui."""
    bruto = obter_config(con, "avisos_silenciados", "") or ""
    return {t.strip() for t in bruto.split(",") if t.strip()} - AVISOS_OBRIGATORIOS


def _repetido_ha_pouco(con: sqlite3.Connection, ev: sqlite3.Row) -> bool:
    """O mesmo par (unidade, tipo) não avisa duas vezes em menos de
    `JANELA_ANTIRREPETICAO_MIN` minutos — o `evento` já tem o carimbo, a
    consulta é uma linha."""
    row = con.execute(
        "SELECT 1 FROM evento WHERE unidade_id IS ? AND tipo = ? AND id < ? "
        "AND (julianday(?) - julianday(ts)) * 1440 < ? LIMIT 1",
        (ev["unidade_id"], ev["tipo"], ev["id"], ev["ts"],
         JANELA_ANTIRREPETICAO_MIN)).fetchone()
    return row is not None


def _entregador_avisos() -> str:
    """`ORQ_NOTIFY_CMD` vence, mesma convenção de `hooks/notificar.sh` — um
    único jeito de trocar o entregador em toda a esteira, não dois."""
    return os.environ.get("ORQ_NOTIFY_CMD") or str(ORQ_REPO / "bin" / "orq-avisar")


def _avisar_eventos_desde(caminho: Path, marca: int) -> None:
    """O ÚNICO lugar do motor que aciona o entregador de avisos — chamado por
    `transacao()` DEPOIS do commit: o lock de escrita já foi liberado ali, e
    uma entrega de rede lenta aqui não trava outro escritor (mesma regra que
    manda teardown/arquivamento para fora da transação em OA-05/OA-08).

    Lê só os eventos com `id > marca` — os que ESTA transação gravou, nunca
    os de outra (com `BEGIN IMMEDIATE` só um escritor por vez, então a marca
    tirada na entrada da transação é exata). Falha de entrega nunca chega a
    quem chamou: a transição já aconteceu, e é isso que garante que o
    registro do evento e o estado nunca divirjam.
    """
    try:
        con = abrir_banco(caminho)
    except Exception:
        return
    try:
        eventos = con.execute(
            "SELECT e.id, e.unidade_id, e.tipo, e.texto, e.ts, u.chave "
            "FROM evento e LEFT JOIN unidade u ON u.id = e.unidade_id "
            "WHERE e.id > ? ORDER BY e.id", (marca,)).fetchall()
        if not eventos:
            return
        cortados = _avisos_cortados(con)
        entregador = _entregador_avisos()
        for ev in eventos:
            titulo = ROTEAMENTO_AVISOS.get(ev["tipo"])
            if titulo is None or ev["tipo"] in cortados:
                continue
            if _repetido_ha_pouco(con, ev):
                continue
            env = {**os.environ, "ORQ_UNIT": ev["chave"] or ""}
            try:
                subprocess.run([entregador, titulo, ev["texto"] or ""],
                               env=env, capture_output=True, timeout=25)
            except Exception:
                pass   # entrega nunca pode derrubar o motor (mesma regra do orq-avisar)
    finally:
        con.close()


def criar_unidade(con: sqlite3.Connection, chave: str, *, clickup_id: str | None,
                  titulo: str, modo: str = "autonomous", prioridade: int = 2) -> int:
    """Declara uma unidade nova. Idempotente por `chave` fica para OA-02 — aqui
    é a escrita crua, usada pelos testes deste núcleo e pelo verbo de cima."""
    agora = _agora()
    cur = con.execute(
        "INSERT INTO unidade (chave, clickup_id, titulo, modo, prioridade, "
        "                     criado_em, atualizado_em) VALUES (?, ?, ?, ?, ?, ?, ?)",
        (chave, clickup_id, titulo, modo, prioridade, agora, agora))
    uid = cur.lastrowid
    registrar_evento(con, uid, "declaracao", texto=f"unidade {chave} criada")
    return uid


class ErroDependenciaCiclica(ErroEstado):
    """Uma dependência nova fecharia um ciclo. Carrega o caminho encontrado,
    porque "dependência inválida" não diz a quem for corrigir o que consertar."""


def _alcancaveis(con: sqlite3.Connection, origem: int) -> dict:
    """BFS a partir de `origem` seguindo `depende_de`: quem `origem` precisa,
    direta ou indiretamente. Devolve {id_alcancado: id_anterior_no_caminho},
    para reconstruir o caminho quando um ciclo for encontrado."""
    veio_de = {origem: None}
    fila = [origem]
    while fila:
        atual = fila.pop(0)
        for row in con.execute(
                "SELECT depende_de FROM dependencia WHERE unidade_id = ?", (atual,)):
            prox = row["depende_de"]
            if prox not in veio_de:
                veio_de[prox] = atual
                fila.append(prox)
    return veio_de


def adicionar_dependencia(con: sqlite3.Connection, unidade_id: int, depende_de: int) -> None:
    """`unidade_id` passa a depender de `depende_de`. Recusa se isso fechar um
    ciclo — verificado ANTES de gravar, seguindo a cadeia que `depende_de` já
    precisa: se ela alcança `unidade_id`, a aresta nova fecharia o laço."""
    if unidade_id == depende_de:
        raise ErroDependenciaCiclica(
            f"uma unidade não pode depender de si mesma (id {unidade_id}).")
    veio_de = _alcancaveis(con, depende_de)
    if unidade_id in veio_de:
        caminho = [unidade_id]
        cursor = unidade_id
        while veio_de.get(cursor) is not None:
            cursor = veio_de[cursor]
            caminho.append(cursor)
        caminho.reverse()   # depende_de → … → unidade_id: a cadeia que já existe
        nomes = [
            (con.execute("SELECT chave FROM unidade WHERE id = ?", (i,)).fetchone()
             or {"chave": str(i)})["chave"]
            for i in caminho
        ]
        # Fecha o laço visualmente: a aresta nova (unidade_id -> depende_de)
        # volta exatamente ao primeiro nome da cadeia, então repeti-lo no fim é
        # o que mostra o ciclo completo — não o último (esse já é unidade_id).
        raise ErroDependenciaCiclica(
            f"dependência recusada: fecharia um ciclo "
            f"{' → '.join(nomes + [nomes[0]])}.")
    con.execute(
        "INSERT INTO dependencia (unidade_id, depende_de) VALUES (?, ?)",
        (unidade_id, depende_de))
    registrar_evento(con, unidade_id, "declaracao",
                     texto=f"passou a depender da unidade {depende_de}")


def definir_status(con: sqlite3.Connection, unidade_id: int, novo_status: str,
                   *, motivo: str = "", tipo_evento: str = "transicao") -> None:
    """Grava a transição e o evento na MESMA transação — nunca em duas.

    A legalidade da transição (o que pode virar o quê) é a máquina de estados
    de OA-03; aqui é só a escrita atômica que ela vai chamar por baixo.
    """
    row = con.execute("SELECT status FROM unidade WHERE id = ?", (unidade_id,)).fetchone()
    if row is None:
        raise ErroEstado(f"unidade {unidade_id} não existe.")
    de_status = row["status"]
    con.execute(
        "UPDATE unidade SET status = ?, motivo = ?, atualizado_em = ? WHERE id = ?",
        (novo_status, motivo, _agora(), unidade_id))
    registrar_evento(con, unidade_id, tipo_evento,
                     de_status=de_status, para_status=novo_status, texto=motivo)


# ---------------------------------------------------------------- estado — verbos (OA-02)
#
# A escrita no banco (OA-01) por linha de comando. Cada `cmd_*` daqui embaixo
# recebe `(cfg, args)`, mas `cfg` é sempre None — não existe mais Config nem
# pipeline.toml (OA-04); o banco chega em `args.db`, resolvido por
# `resolver_banco` (OA-03) antes de qualquer `cmd_*` rodar.
#
# GATES SAEM DAQUI. Decisão de 22/09/2026: não existe `orq gate`. Setup e
# verify são responsabilidade do agente, seguindo o CLAUDE.md/AGENTS.md que o
# próprio projeto já declara — por isso `validate` recusa esteira sem nenhum
# dos dois. Teardown de ambiente vira comando fixo do orquestrador (OA-08),
# nunca declarado por esteira.

PRIORIDADES = {"urgente": 0, "alta": 1, "normal": 2, "baixa": 3, "sem": 4}

CONFIG_CHAVES_CONHECIDAS = frozenset({
    "name", "repo", "base_branch", "work_dir", "worktree_root", "branch_template",
    "list_id", "github_repo", "max_concurrent", "reserve_ram_gb", "ram_per_session_gb",
    "interval_seconds", "max_strikes", "max_rework", "permission_mode",
    "remote_control", "model", "verificacao_automatica", "avisos_silenciados",
})


def definir_config(con: sqlite3.Connection, chave: str, valor: str) -> None:
    con.execute(
        "INSERT INTO config (chave, valor) VALUES (?, ?) "
        "ON CONFLICT(chave) DO UPDATE SET valor = excluded.valor", (chave, valor))


def obter_config(con: sqlite3.Connection, chave: str, padrao=None):
    row = con.execute("SELECT valor FROM config WHERE chave = ?", (chave,)).fetchone()
    return row["valor"] if row else padrao


def _resolver_unidade_id(con: sqlite3.Connection, chave: str) -> int:
    row = con.execute("SELECT id FROM unidade WHERE chave = ?", (chave,)).fetchone()
    if row is None:
        die(f"unidade '{chave}' não existe. Declare com 'orq task add' antes.")
    return row["id"]


def cmd_init(cfg, args):
    """Cria o banco de uma esteira nova. SUBSTITUI o `orq init` antigo (que
    gerava pipeline.toml) — decisão de 22/09/2026, ver
    docs/specs/orquestrador-agil/OA-02-verbos-de-declaracao.md."""
    caminho = Path(args.db).expanduser()
    repo = Path(args.repo).expanduser().resolve()
    if not (repo / ".git").exists():
        die(f"{repo} não é um repositório git (sem .git).")
    worktrees = Path(args.worktrees).expanduser()
    try:
        worktrees.resolve().relative_to(repo)
        die(f"--worktrees ({worktrees}) está DENTRO do repositório. Worktrees "
            f"ali fazem o `git status` do repo pai listar milhares de arquivos "
            f"não rastreados. Escolha um caminho fora dele.")
    except ValueError:
        pass   # não está dentro — é o esperado
    r = subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", args.base],
                       capture_output=True)
    if r.returncode != 0:
        die(f"branch base '{args.base}' não existe em {repo}.")

    con = criar_banco(caminho, forcar=args.forcar)
    con.close()
    nome = args.nome or caminho.stem
    valores = {
        "name": nome, "repo": str(repo), "base_branch": args.base,
        "worktree_root": str(worktrees), "list_id": args.lista or "",
        "github_repo": args.github or "", "interval_seconds": "60",
    }
    with transacao(caminho) as con:
        for chave, valor in valores.items():
            definir_config(con, chave, valor)
        registrar_evento(con, None, "declaracao", texto=f"esteira '{nome}' inicializada")
    print(f"{C['grn']}✓{C['r']} banco criado em {caminho}")
    print(f"{C['d']}  repo={repo} base={args.base} worktrees={worktrees}{C['r']}")


def cmd_task_add(cfg, args):
    prioridade = PRIORIDADES.get(args.prioridade)
    if prioridade is None:
        die(f"--prioridade '{args.prioridade}' desconhecida. Use uma de: "
            f"{', '.join(PRIORIDADES)}.")
    if args.modo not in ("autonomous", "hands-on"):
        die(f"--modo precisa ser 'autonomous' ou 'hands-on', recebeu '{args.modo}'.")
    caminho = Path(args.db)
    with transacao(caminho) as con:
        existente = con.execute(
            "SELECT * FROM unidade WHERE chave = ?", (args.chave,)).fetchone()
        if existente:
            igual = (existente["clickup_id"] == args.clickup
                     and existente["titulo"] == args.titulo
                     and existente["modo"] == args.modo
                     and existente["prioridade"] == prioridade)
            if igual:
                print(f"{args.chave} já declarada, sem mudança.")
                return
            if not args.forcar:
                die(f"{args.chave} já existe com valores diferentes. "
                    f"Use --forcar para sobrescrever.")
            con.execute(
                "UPDATE unidade SET clickup_id=?, titulo=?, modo=?, prioridade=?, "
                "atualizado_em=? WHERE id=?",
                (args.clickup, args.titulo, args.modo, prioridade, _agora(),
                 existente["id"]))
            registrar_evento(con, existente["id"], "declaracao",
                             texto="unidade redeclarada (--forcar)")
            print(f"{C['grn']}✓{C['r']} {args.chave} atualizada")
            return
        try:
            criar_unidade(con, args.chave, clickup_id=args.clickup, titulo=args.titulo,
                         modo=args.modo, prioridade=prioridade)
        except sqlite3.IntegrityError as e:
            die(f"não consegui declarar {args.chave}: {e}")
    print(f"{C['grn']}✓{C['r']} {args.chave} declarada")


def cmd_task_rm(cfg, args):
    caminho = Path(args.db)
    with transacao(caminho) as con:
        row = con.execute(
            "SELECT * FROM unidade WHERE chave = ?", (args.chave,)).fetchone()
        if row is None:
            die(f"{args.chave} não existe.")
        if row["status"] in ("em_progresso", "revisao"):
            die(f"{args.chave} está '{row['status']}' — pode ter sessão viva ou PR "
                f"aberto. Resolva isso antes (orq hold / orq release); --forcar não "
                f"passa por cima disto.")
        if not args.forcar:
            die(f"remover {args.chave} é irreversível. Use --forcar para confirmar.")
        con.execute("DELETE FROM unidade WHERE id = ?", (row["id"],))
        registrar_evento(con, None, "declaracao", texto=f"unidade {args.chave} removida")
    print(f"{C['grn']}✓{C['r']} {args.chave} removida")


def cmd_task_set(cfg, args):
    if not any((args.titulo, args.prioridade, args.modo)):
        die("informe ao menos um de --titulo, --prioridade, --modo.")
    caminho = Path(args.db)
    with transacao(caminho) as con:
        row = con.execute(
            "SELECT * FROM unidade WHERE chave = ?", (args.chave,)).fetchone()
        if row is None:
            die(f"{args.chave} não existe.")
        campos, valores, mudancas = [], [], []
        if args.titulo:
            campos.append("titulo = ?"); valores.append(args.titulo)
            mudancas.append(f"titulo → {args.titulo!r}")
        if args.prioridade:
            p = PRIORIDADES.get(args.prioridade)
            if p is None:
                die(f"--prioridade '{args.prioridade}' desconhecida. Use uma de: "
                    f"{', '.join(PRIORIDADES)}.")
            campos.append("prioridade = ?"); valores.append(p)
            mudancas.append(f"prioridade → {args.prioridade}")
        if args.modo:
            if args.modo not in ("autonomous", "hands-on"):
                die("--modo precisa ser 'autonomous' ou 'hands-on'.")
            campos.append("modo = ?"); valores.append(args.modo)
            mudancas.append(f"modo → {args.modo}")
        campos.append("atualizado_em = ?"); valores.append(_agora())
        valores.append(row["id"])
        con.execute(f"UPDATE unidade SET {', '.join(campos)} WHERE id = ?", valores)
        registrar_evento(con, row["id"], "declaracao", texto="; ".join(mudancas))
    print(f"{C['grn']}✓{C['r']} {args.chave}: {'; '.join(mudancas)}")


def cmd_dep_add(cfg, args):
    caminho = Path(args.db)
    with transacao(caminho) as con:
        uid = _resolver_unidade_id(con, args.chave)
        for dep_chave in args.precisa:
            dep_id = _resolver_unidade_id(con, dep_chave)
            try:
                adicionar_dependencia(con, uid, dep_id)
            except ErroDependenciaCiclica as e:
                die(str(e))
    print(f"{C['grn']}✓{C['r']} {args.chave} depende de: {', '.join(args.precisa)}")


def cmd_dep_rm(cfg, args):
    caminho = Path(args.db)
    removidas = []
    with transacao(caminho) as con:
        uid = _resolver_unidade_id(con, args.chave)
        for dep_chave in args.precisa:
            dep_id = _resolver_unidade_id(con, dep_chave)
            cur = con.execute(
                "DELETE FROM dependencia WHERE unidade_id = ? AND depende_de = ?",
                (uid, dep_id))
            if cur.rowcount:
                removidas.append(dep_chave)
                registrar_evento(con, uid, "declaracao",
                                 texto=f"deixou de depender de {dep_chave}")
    if removidas:
        print(f"{C['grn']}✓{C['r']} {args.chave} não depende mais de: "
              f"{', '.join(removidas)}")
    else:
        print(f"{C['d']}nenhuma dessas dependências existia.{C['r']}")


def cmd_config_set(cfg, args):
    if args.chave not in CONFIG_CHAVES_CONHECIDAS:
        die(f"'{args.chave}' não é uma chave de config conhecida. Conhecidas: "
            f"{', '.join(sorted(CONFIG_CHAVES_CONHECIDAS))}")
    with transacao(Path(args.db)) as con:
        definir_config(con, args.chave, args.valor)
        registrar_evento(con, None, "declaracao", texto=f"config {args.chave} = {args.valor}")
    print(f"{C['grn']}✓{C['r']} {args.chave} = {args.valor}")


def cmd_config_get(cfg, args):
    con = abrir_banco(Path(args.db))
    valor = obter_config(con, args.chave)
    con.close()
    if valor is None:
        die(f"'{args.chave}' não está definida.")
    print(valor)


def cmd_config_list(cfg, args):
    con = abrir_banco(Path(args.db))
    linhas = con.execute("SELECT chave, valor FROM config ORDER BY chave").fetchall()
    con.close()
    for r in linhas:
        print(f"{r['chave']} = {r['valor']}")


def _dados_para_exportar(con: sqlite3.Connection) -> dict:
    config = {r["chave"]: r["valor"]
             for r in con.execute("SELECT chave, valor FROM config ORDER BY chave")}
    unidades = []
    for u in con.execute("SELECT * FROM unidade ORDER BY chave"):
        deps = [d["chave"] for d in con.execute(
            "SELECT unidade.chave AS chave FROM dependencia "
            "JOIN unidade ON unidade.id = dependencia.depende_de "
            "WHERE dependencia.unidade_id = ? ORDER BY unidade.chave", (u["id"],))]
        unidades.append({
            "chave": u["chave"], "clickup_id": u["clickup_id"] or "",
            "titulo": u["titulo"], "status": u["status"], "modo": u["modo"],
            "prioridade": u["prioridade"], "depends_on": deps,
        })
    return {"config": config, "unidades": unidades}


def _toml_str(valor) -> str:
    return '"' + str(valor).replace("\\", "\\\\").replace('"', '\\"') + '"'


def _formatar_toml(dados: dict) -> str:
    linhas = ["[config]"]
    for k in sorted(dados["config"]):
        linhas.append(f"{k} = {_toml_str(dados['config'][k])}")
    for u in dados["unidades"]:
        linhas += ["", "[[unidade]]",
                   f"chave = {_toml_str(u['chave'])}",
                   f"clickup_id = {_toml_str(u['clickup_id'])}",
                   f"titulo = {_toml_str(u['titulo'])}",
                   f"status = {_toml_str(u['status'])}",
                   f"modo = {_toml_str(u['modo'])}",
                   f"prioridade = {u['prioridade']}",
                   "depends_on = [" + ", ".join(_toml_str(d) for d in u["depends_on"]) + "]"]
    return "\n".join(linhas) + "\n"


def cmd_export(cfg, args):
    con = abrir_banco(Path(args.db))
    dados = _dados_para_exportar(con)
    con.close()
    if args.formato == "json":
        print(json.dumps(dados, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        sys.stdout.write(_formatar_toml(dados))


def _primeiro_ciclo(con: sqlite3.Connection, ids: list) -> str | None:
    """Varredura defensiva do grafo INTEIRO. `adicionar_dependencia` já impede
    ciclo na escrita; isto pega um banco editado por fora dos verbos."""
    grafo = {}
    for row in con.execute("SELECT unidade_id, depende_de FROM dependencia"):
        grafo.setdefault(row["unidade_id"], []).append(row["depende_de"])
    cor, caminho = {}, []

    def chave_de(i):
        r = con.execute("SELECT chave FROM unidade WHERE id = ?", (i,)).fetchone()
        return r["chave"] if r else str(i)

    def dfs(no):
        cor[no] = 1
        caminho.append(no)
        for viz in grafo.get(no, []):
            if cor.get(viz, 0) == 1:
                inicio = caminho.index(viz)
                return " → ".join(chave_de(x) for x in caminho[inicio:] + [viz])
            if cor.get(viz, 0) == 0:
                achado = dfs(viz)
                if achado:
                    return achado
        caminho.pop()
        cor[no] = 2
        return None

    for i in ids:
        if cor.get(i, 0) == 0:
            achado = dfs(i)
            if achado:
                return achado
    return None


def _validar(con: sqlite3.Connection) -> list[str]:
    """A lista de problemas de uma esteira — nunca escreve nada. `cmd_validate`
    é a casca de CLI; `orq doctor` (OA-12) CHAMA esta função como uma das
    provas do pré-voo, em vez de duplicar a checagem."""
    problemas = []
    conf = {r["chave"]: r["valor"] for r in con.execute("SELECT chave, valor FROM config")}

    repo_str = conf.get("repo")
    if not repo_str:
        problemas.append("config 'repo' não declarada.")
    else:
        repo = Path(repo_str).expanduser()
        if not (repo / ".git").exists():
            problemas.append(f"'repo' ({repo}) não parece um repositório git.")
        base = conf.get("base_branch")
        if not base:
            problemas.append("config 'base_branch' não declarada.")
        elif (repo / ".git").exists():
            r = subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", base],
                               capture_output=True)
            if r.returncode != 0:
                problemas.append(f"branch base '{base}' não existe em {repo}.")
        wt = conf.get("worktree_root")
        if not wt:
            problemas.append("config 'worktree_root' não declarada.")
        else:
            try:
                Path(wt).expanduser().resolve().relative_to(repo.resolve())
                problemas.append(f"'worktree_root' ({wt}) está DENTRO do repositório.")
            except ValueError:
                pass
        if (repo / ".git").exists() and not any(
                (repo / n).exists() for n in ("CLAUDE.md", "AGENTS.md")):
            problemas.append(
                f"{repo} não tem CLAUDE.md nem AGENTS.md na raiz — é de lá que o "
                f"agente auto-contido tira os portões (setup/verify). Sem um dos "
                f"dois, a unidade nasce sem portão de qualidade.")

    if not conf.get("github_repo"):
        problemas.append("config 'github_repo' não declarada — o vigia de PR (OA-08) "
                         "depende dela.")

    for chave, minimo in (("max_concurrent", 1), ("interval_seconds", 30)):
        v = conf.get(chave)
        if v is None:
            continue
        try:
            if int(v) < minimo:
                problemas.append(f"'{chave}' = {v}, precisa ser >= {minimo}.")
        except ValueError:
            problemas.append(f"'{chave}' = {v!r} não é um número inteiro.")
    ram = conf.get("ram_per_session_gb")
    if ram is not None:
        try:
            if float(ram) <= 0:
                problemas.append(f"'ram_per_session_gb' = {ram}, precisa ser > 0.")
        except ValueError:
            problemas.append(f"'ram_per_session_gb' = {ram!r} não é um número.")

    unidades = con.execute("SELECT id, chave, clickup_id, titulo FROM unidade").fetchall()
    ids_validos = {u["id"] for u in unidades}
    for u in unidades:
        if not u["clickup_id"]:
            problemas.append(f"{u['chave']}: sem clickup_id.")
        if not u["titulo"]:
            problemas.append(f"{u['chave']}: sem titulo.")
    for row in con.execute("SELECT unidade_id, depende_de FROM dependencia"):
        if row["unidade_id"] not in ids_validos or row["depende_de"] not in ids_validos:
            problemas.append("dependência aponta para unidade inexistente "
                             "(banco incoerente, editado por fora dos verbos).")
    ciclo = _primeiro_ciclo(con, [u["id"] for u in unidades])
    if ciclo:
        problemas.append(f"ciclo de dependência: {ciclo}.")
    return problemas


def cmd_validate(cfg, args):
    """Recusa esteira incoerente, sem escrever nada no banco."""
    con = abrir_banco(Path(args.db))
    problemas = _validar(con)
    con.close()

    if problemas:
        for p in problemas:
            print(f"{C['red']}✗{C['r']} {p}")
        sys.exit(1)
    print(f"{C['grn']}✓{C['r']} esteira coerente.")


# ---------------------------------------------------------------- estado — máquina de
# cinco estados (OA-03)
#
# Os quatro estágios (spec→implement→review→integrate) morrem. No lugar, CINCO
# status — e a diferença não é cosmética: antes o estado era DERIVADO do
# cruzamento entre ClickUp, TOML e processos vivos; agora o status é um CAMPO
# GRAVADO, e o que se deriva é só o que pode ser conferido na hora (sessão
# viva, dependência satisfeita). Ver
# docs/specs/orquestrador-agil/OA-03-maquina-de-cinco-estados.md.
#
# `orq run` e `orq dispatch` FICAM DE FORA — despachar sem lançar (OA-05 ainda
# não existe) seria um comando que promete e não faz; melhor não ter o verbo
# do que ter um que mente.

TRANSICOES_LEGAIS = {
    "backlog":      {"em_progresso"},
    "em_progresso": {"revisao", "bloqueado", "backlog"},
    "revisao":      {"pronto", "em_progresso", "bloqueado"},
    "bloqueado":    {"backlog"},
    "pronto":       set(),   # terminal — só sai com `orq reopen --forcar`
}


class ErroTransicaoIlegal(ErroEstado):
    """A transição pedida não está na tabela — e a tabela é a lista INTEIRA,
    não um recorte. Transição fora dela é erro de programa, não caso de
    canto: por isso não existe caminho silencioso, só --forcar explícito."""


def transicionar(con: sqlite3.Connection, unidade_id: int, para_status: str, *,
                 motivo: str = "", tipo_evento: str = "transicao",
                 forcar: bool = False) -> None:
    """A ÚNICA porta de escrita de status que checa legalidade — chama
    `definir_status` (OA-01) por baixo depois de confirmar que a transição
    pode acontecer. Todo verbo deste arquivo que move uma unidade passa por
    aqui; nenhum grava direto na tabela `unidade`.
    """
    if para_status not in STATUS_UNIDADE:
        raise ErroEstado(f"'{para_status}' não é um status desta esteira. "
                         f"Use um de: {', '.join(sorted(STATUS_UNIDADE))}.")
    row = con.execute("SELECT status FROM unidade WHERE id = ?", (unidade_id,)).fetchone()
    if row is None:
        raise ErroEstado(f"unidade {unidade_id} não existe.")
    de_status = row["status"]
    if not forcar and para_status not in TRANSICOES_LEGAIS.get(de_status, set()):
        legais = sorted(TRANSICOES_LEGAIS.get(de_status, set()))
        raise ErroTransicaoIlegal(
            f"transição ilegal: '{de_status}' → '{para_status}'. "
            f"De '{de_status}' só se vai para: {', '.join(legais) or '(nada — use --forcar)'}.")
    definir_status(con, unidade_id, para_status, motivo=motivo, tipo_evento=tipo_evento)


STATUS_UNIDADE = frozenset(TRANSICOES_LEGAIS)


# ---- sessão viva — detecção continua sendo o SISTEMA OPERACIONAL, nunca um
# heartbeat gravado. O banco (tabela `sessao`) só guarda ONDE procurar.

def registrar_sessao(con: sqlite3.Connection, unidade_id: int, *, worktree: str,
                     branch: str, tmux: str | None = None, pid: int | None = None) -> int:
    """Abre uma sessão para a unidade. Quem chama de verdade é o lançador de
    OA-05; até lá, é o que os testes deste arquivo usam para simular 'havia
    uma sessão viva'."""
    cur = con.execute(
        "INSERT INTO sessao (unidade_id, tmux, pid, worktree, branch, iniciada_em) "
        "VALUES (?, ?, ?, ?, ?, ?)",
        (unidade_id, tmux, pid, worktree, branch, _agora()))
    return cur.lastrowid


def encerrar_sessao(con: sqlite3.Connection, unidade_id: int, desfecho: str) -> None:
    """Fecha a sessão ABERTA mais recente da unidade (se houver nenhuma, não
    faz nada — encerrar duas vezes não é erro, é idempotência)."""
    con.execute(
        "UPDATE sessao SET encerrada_em = ?, desfecho = ? "
        "WHERE unidade_id = ? AND encerrada_em IS NULL",
        (_agora(), desfecho, unidade_id))


def sessao_viva(con: sqlite3.Connection, unidade_id: int) -> bool:
    """A unidade tem processo de verdade rodando agora? Confere o sistema
    operacional (tmux ou PID), nunca um campo do banco — um campo poderia
    dizer 'viva' para sempre se ninguém o atualizasse."""
    row = con.execute(
        "SELECT tmux, pid FROM sessao WHERE unidade_id = ? AND encerrada_em IS NULL "
        "ORDER BY id DESC LIMIT 1", (unidade_id,)).fetchone()
    if row is None:
        return False
    if row["tmux"]:
        r = subprocess.run(["tmux", "has-session", "-t", row["tmux"]],
                           capture_output=True)
        return r.returncode == 0
    if row["pid"]:
        try:
            os.kill(int(row["pid"]), 0)
            return True
        except Exception:
            return False
    return False


def recolher_sessoes_mortas(con: sqlite3.Connection, max_strikes: int) -> list:
    """Unidade em `em_progresso` sem sessão viva é arranque falho — detectado
    aqui, nunca por heartbeat. Devolve à fila com strike; no teto, bloqueia.

    A exceção preservada do modelo antigo: unidade recém-solta por
    `orq release` (coluna `solta_em`) não conta falta na PRIMEIRA vez que é
    encontrada sem sessão — é perdoada, e o bilhete é consumido (`solta_em`
    volta a NULL). Sem isto, toda unidade liberada seria imediatamente
    recolhida de novo antes de alguém ter a chance de despachá-la.

    Arquiva os artefatos de cada uma (rápido: mover 3 arquivos pequenos). O
    que NÃO roda aqui, de propósito, é o encerramento de ambiente
    (`encerramento_fixo`) — ele pode levar até dois minutos por
    docker-compose, e segurar o lock de escrita por isso seria o mesmo erro
    que a migração para SQLite corrigiu (OA-01). Por isso o desfecho
    'quarentena' devolve o `worktree`: quem chama (`cmd_tick`) faz o
    encerramento DEPOIS de fechar esta transação.
    """
    recolhidas = []
    nome_esteira = slugify(obter_config(con, "name") or "esteira", 16)
    for u in con.execute(
            "SELECT id, chave, strikes, solta_em FROM unidade WHERE status = 'em_progresso'"):
        if sessao_viva(con, u["id"]):
            continue
        sessao_row = con.execute(
            "SELECT worktree FROM sessao WHERE unidade_id = ? AND encerrada_em IS NULL "
            "ORDER BY id DESC LIMIT 1", (u["id"],)).fetchone()
        encerrar_sessao(con, u["id"], "sessao-morta")
        arquivar_artefatos(nome_esteira, u["id"], u["chave"], "sessao-morta")
        if u["solta_em"] is not None:
            con.execute("UPDATE unidade SET solta_em = NULL WHERE id = ?", (u["id"],))
            transicionar(con, u["id"], "backlog",
                        motivo="liberada; ainda sem sessão nova", tipo_evento="recolhida")
            recolhidas.append({"chave": u["chave"], "desfecho": "liberada"})
            continue
        n = u["strikes"] + 1
        con.execute("UPDATE unidade SET strikes = ? WHERE id = ?", (n, u["id"]))
        if n >= max_strikes:
            transicionar(con, u["id"], "bloqueado",
                        motivo=f"{n} arranques falhos seguidos", tipo_evento="recolhida")
            recolhidas.append({"chave": u["chave"], "desfecho": "quarentena", "strikes": n,
                               "worktree": sessao_row["worktree"] if sessao_row else None})
        else:
            transicionar(con, u["id"], "backlog",
                        motivo=f"arranque falho ({n}/{max_strikes})", tipo_evento="recolhida")
            recolhidas.append({"chave": u["chave"], "desfecho": "recolhida", "strikes": n})
    return recolhidas


# ---- fila de despacho — "pode começar agora"

def unidades_prontas(con: sqlite3.Connection) -> list:
    """Backlog cujas dependências estão TODAS em 'pronto'. Ordem: prioridade,
    depois quantas unidades dependem dela (quem desbloqueia mais vai primeiro
    — com dependência liberando só no merge, escolher mal a ordem custa mais
    do que custava), depois a chave."""
    return con.execute(
        "SELECT u.*, "
        "(SELECT count(*) FROM dependencia d2 WHERE d2.depende_de = u.id) AS desbloqueia "
        "FROM unidade u WHERE u.status = 'backlog' "
        "AND NOT EXISTS ("
        "  SELECT 1 FROM dependencia d JOIN unidade dep ON dep.id = d.depende_de "
        "  WHERE d.unidade_id = u.id AND dep.status != 'pronto'"
        ") "
        "ORDER BY u.prioridade ASC, desbloqueia DESC, u.chave ASC"
    ).fetchall()


ICONE_ESTADO = {"ready": "🟢", "blocked": "⛔", "running": "▶ ", "stalled": "💥",
                "revisao": "👀", "bloqueado": "🚫", "pronto": "✅"}
ORDEM_ESTADO = {"stalled": 0, "bloqueado": 1, "revisao": 2, "running": 3,
               "ready": 4, "blocked": 5, "pronto": 6}


def _espelho_divergente(con: sqlite3.Connection, unidade_id: int) -> bool:
    """`orq board` marca ⚠ (OA-07) quando o `espelho_falhou` mais recente
    desta unidade é mais novo que o `espelho_ok` mais recente — o cartão do
    ClickUp pode estar mentindo, e sem este sinal ninguém percebe."""
    row = con.execute(
        "SELECT tipo FROM evento WHERE unidade_id = ? AND tipo IN "
        "('espelho_falhou', 'espelho_ok') ORDER BY id DESC LIMIT 1", (unidade_id,)).fetchone()
    return row is not None and row["tipo"] == "espelho_falhou"


def classificar(con: sqlite3.Connection) -> list:
    """Para cada unidade, o rótulo de leitura e o motivo — SEMPRE calculado,
    nunca gravado. É o que faz 'pronta' e 'travada por dependência' conviverem
    dentro do mesmo status `backlog` sem precisar de um sexto status: a
    diferença é uma consulta, não um campo que pode ficar velho."""
    unidades = con.execute("SELECT * FROM unidade ORDER BY chave").fetchall()
    prontas_ids = {u["id"] for u in unidades_prontas(con)}
    linhas = []
    for u in unidades:
        divergente = _espelho_divergente(con, u["id"])
        if u["status"] == "backlog":
            if u["id"] in prontas_ids:
                linhas.append({"unidade": u, "estado": "ready", "motivo": "pronta para começar",
                               "espelho_divergente": divergente})
            else:
                faltando = con.execute(
                    "SELECT dep.chave, dep.status FROM dependencia d "
                    "JOIN unidade dep ON dep.id = d.depende_de "
                    "WHERE d.unidade_id = ? AND dep.status != 'pronto'", (u["id"],)).fetchall()
                nomes = ", ".join(f"{d['chave']} ({d['status']})" for d in faltando)
                linhas.append({"unidade": u, "estado": "blocked", "motivo": f"espera: {nomes}",
                               "espelho_divergente": divergente})
        elif u["status"] == "em_progresso":
            viva = sessao_viva(con, u["id"])
            linhas.append({"unidade": u, "estado": "running" if viva else "stalled",
                           "motivo": "sessão viva" if viva else "sem sessão viva",
                           "espelho_divergente": divergente})
        elif u["status"] == "revisao":
            if not u["pr_numero"]:
                motivo = "aguardando abertura do PR"
            elif u["pr_draft"]:
                motivo = f"PR #{u['pr_numero']} — rascunho, ainda não pede revisão"
            else:
                motivo = f"PR #{u['pr_numero']}"
            linhas.append({"unidade": u, "estado": "revisao", "motivo": motivo,
                           "espelho_divergente": divergente})
        elif u["status"] == "bloqueado":
            linhas.append({"unidade": u, "estado": "bloqueado", "motivo": u["motivo"] or "",
                           "espelho_divergente": divergente})
        elif u["status"] == "pronto":
            linhas.append({"unidade": u, "estado": "pronto", "motivo": "concluída",
                           "espelho_divergente": divergente})
    linhas.sort(key=lambda l: (ORDEM_ESTADO.get(l["estado"], 9), l["unidade"]["chave"]))
    return linhas


# ---- resolução do banco — a conveniência que OA-02 adiou para cá: sem --db
# explícito, procura o banco DESTA máquina que governa o repositório onde
# você está (`divergencia_de_maquina`, herdada do antigo resolvedor de
# pipeline.toml), e por último cai no último banco usado.

ULTIMO_BANCO = STATE / "last-db"


def _repo_declarado_do_banco(caminho: Path) -> Path | None:
    """O `repo` de um banco, sem carregar mais nada. None se ilegível."""
    try:
        con = sqlite3.connect(caminho)
        row = con.execute("SELECT valor FROM config WHERE chave = 'repo'").fetchone()
        con.close()
        return Path(row[0]).expanduser() if row and row[0] else None
    except Exception:
        return None


def resolver_banco(explicito: str | None) -> Path:
    """Resolve o banco da esteira. Ordem: --db (ou $ORQ_DB) → o banco desta
    máquina cujo 'repo' bate com o repositório onde você está → o último
    usado. Mesma filosofia de `find_config` para o pipeline.toml — mundos
    separados até OA-04 fundir os dois."""
    p = None
    if explicito:
        p = Path(explicito).expanduser().resolve()
    elif os.environ.get("ORQ_DB"):
        p = Path(os.environ["ORQ_DB"]).expanduser().resolve()
    else:
        git_dir = git_dir_comum()
        if git_dir is not None and BANCOS.is_dir():
            candidatos = []
            for c in sorted(BANCOS.glob("*.db")):
                repo = _repo_declarado_do_banco(c)
                if repo is not None and divergencia_de_maquina(repo, git_dir) is None:
                    candidatos.append(c)
            if len(candidatos) == 1:
                p = candidatos[0]
            elif len(candidatos) > 1:
                die("mais de um banco governa este repositório. Escolha um:\n"
                    + "\n".join(f"    --db {c}" for c in candidatos))
        if p is None and ULTIMO_BANCO.exists():
            cand = Path(ULTIMO_BANCO.read_text().strip())
            if cand.exists():
                p = cand
                print(f"{C['d']}(usando o último banco: {p}){C['r']}", file=sys.stderr)
    if p is None:
        die("nenhum banco encontrado. Use --db, defina $ORQ_DB, ou rode "
            "'orq init' de dentro do repositório.")
    if not p.exists():
        die(f"banco não encontrado: {p}")
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        ULTIMO_BANCO.write_text(str(p))
    except Exception:
        pass
    return p


# ---- comandos de leitura

def cmd_board(cfg, args):
    con = abrir_banco(Path(args.db))
    linhas = classificar(con)
    con.close()
    if not linhas:
        print("nenhuma unidade declarada.")
        return
    largura = max(len(l["unidade"]["chave"]) for l in linhas)
    for l in linhas:
        u = l["unidade"]
        icone = ICONE_ESTADO.get(l["estado"], "❓")
        motivo = (l["motivo"] or "")[:70]
        # ⚠ (OA-07): o espelho no ClickUp pode estar mentindo — o cartão
        # ainda diz o status velho porque a última escrita falhou.
        aviso = f"{C['yel']}⚠{C['r']} " if l.get("espelho_divergente") else ""
        print(f"{icone} {aviso}{u['chave']:<{largura}}  {u['status']:<12}  {motivo}")


def cmd_next(cfg, args):
    con = abrir_banco(Path(args.db))
    prontas = unidades_prontas(con)
    con.close()
    if args.n:
        prontas = prontas[:args.n]
    if not prontas:
        print("nada pronto agora.")
        return
    for r in prontas:
        print(f"{r['chave']:<10} prioridade={r['prioridade']}  "
              f"desbloqueia={r['desbloqueia']}  {r['titulo']}")


def cmd_status(cfg, args):
    con = abrir_banco(Path(args.db))
    linhas = classificar(con)
    con.close()
    vivas = [l for l in linhas if l["estado"] == "running"]
    esperando = [l for l in linhas if l["estado"] == "bloqueado"]
    if not vivas and not esperando:
        print("nada vivo, nada esperando você.")
        return
    if vivas:
        print(f"{C['cyn']}vivas:{C['r']}")
        for l in vivas:
            print(f"  ▶ {l['unidade']['chave']}")
    if esperando:
        print(f"{C['yel']}esperando você:{C['r']}")
        for l in esperando:
            print(f"  ✋ {l['unidade']['chave']}: {l['motivo']}")


def cmd_show(cfg, args):
    con = abrir_banco(Path(args.db))
    u = con.execute("SELECT * FROM unidade WHERE chave = ?", (args.chave,)).fetchone()
    if u is None:
        con.close()
        die(f"{args.chave} não existe.")
    deps = con.execute(
        "SELECT unidade.chave AS chave, unidade.status AS status FROM dependencia "
        "JOIN unidade ON unidade.id = dependencia.depende_de "
        "WHERE dependencia.unidade_id = ? ORDER BY unidade.chave", (u["id"],)).fetchall()
    eventos = con.execute(
        "SELECT tipo, de_status, para_status, texto, ts FROM evento "
        "WHERE unidade_id = ? ORDER BY id DESC LIMIT 10", (u["id"],)).fetchall()
    con.close()
    print(f"{C['b']}{u['chave']}{C['r']} — {u['titulo']}")
    linha_status = f"status: {u['status']}"
    if u["motivo"]:
        linha_status += f"  ·  motivo: {u['motivo']}"
    print(linha_status)
    if u["pr_numero"]:
        print(f"PR: #{u['pr_numero']}" + (f" {u['pr_url']}" if u["pr_url"] else ""))
    if deps:
        print("depende de: " + ", ".join(f"{d['chave']} ({d['status']})" for d in deps))
    if u["clickup_id"]:
        print(f"ClickUp: https://app.clickup.com/t/{u['clickup_id']}")
    if eventos:
        print(f"{C['d']}últimos eventos:{C['r']}")
        for e in eventos:
            seta = f" {e['de_status']}→{e['para_status']}" if e["para_status"] else ""
            print(f"  {e['ts']}  {e['tipo']}{seta}  {e['texto'][:80]}")


# ---- transições — release/reopen são banco puro. hold/advance também
# encerram a sessão e arquivam os artefatos (OA-05: `arquivar_artefatos`,
# `_matar_sessao_com_delicadeza`, `encerramento_fixo`, definidos mais abaixo).

def cmd_hold(cfg, args):
    """em_progresso → bloqueado. Encerra a sessão desta unidade e o ambiente
    que ela subiu (`encerramento_fixo` — a mesma busca por docker-compose que
    OA-08 vai usar no gatilho de merge; construída aqui porque este spec já
    amarra o fim da worktree ao `bloqueado`, e duplicar depois seria
    desperdício), e remove a worktree — o branch e os commits ficam, então
    nada se perde: `orq release` devolve a unidade à fila, e o próximo
    despacho parte do mesmo branch."""
    if not args.motivo or len(args.motivo.strip()) < 10:
        die("--motivo é obrigatório e precisa dizer o que trava (mín. 10 caracteres).")
    caminho = Path(args.db)
    with transacao(caminho) as con:
        uid = _resolver_unidade_id(con, args.chave)
        row_sessao = con.execute(
            "SELECT tmux, pid, worktree FROM sessao WHERE unidade_id = ? "
            "AND encerrada_em IS NULL ORDER BY id DESC LIMIT 1", (uid,)).fetchone()
        try:
            transicionar(con, uid, "bloqueado", motivo=args.motivo, tipo_evento="bloqueada")
        except ErroTransicaoIlegal as e:
            die(str(e))
        encerrar_sessao(con, uid, "hold")
        nome_esteira = slugify(obter_config(con, "name") or "esteira", 16)
        repo = obter_config(con, "repo")
    # FORA da transação: teardown e `git worktree remove` podem demorar, e
    # seria o mesmo erro que a migração para SQLite existiu para consertar
    # segurar o lock de escrita durante I/O lento (OA-01).
    dest = arquivar_artefatos(nome_esteira, uid, args.chave, "hold")
    atraso = _atraso_encerramento(args.chave)
    _matar_sessao_com_delicadeza(row_sessao, atraso)
    if atraso > 3:
        print(f"  esta sessão encerra em {atraso // 60} min — faça o passo 8 (cartão) agora.")
    falhas_td = []
    if row_sessao and row_sessao["worktree"]:
        wt = Path(row_sessao["worktree"])
        falhas_td = encerramento_fixo(wt)
        if not falhas_td and wt.exists() and repo:
            subprocess.run(["git", "-C", repo, "worktree", "remove", "--force", str(wt)],
                           capture_output=True)
    if falhas_td:
        print(f"{C['yel']}!{C['r']} o encerramento do ambiente falhou; a worktree "
              f"NÃO foi removida:\n  " + "\n  ".join(falhas_td))
    print(f"{C['yel']}✋{C['r']} {args.chave} bloqueada: {args.motivo}")
    print(f"{C['d']}  artefatos em {dest}{C['r']}")


def cmd_release(cfg, args):
    with transacao(Path(args.db)) as con:
        uid = _resolver_unidade_id(con, args.chave)
        # strikes zera e o bilhete `solta_em` nasce ANTES da transição: é o
        # que impede o próprio `recolher_sessoes_mortas` de contar falta na
        # primeira vez que encontrar esta unidade sem sessão viva.
        if args.zerar_retrabalho:
            # --zerar-retrabalho (OA-09): para quando a pessoa corrigiu o
            # requisito que travou a unidade no teto — sem zerar, a próxima
            # devolução bloquearia de novo na hora.
            con.execute(
                "UPDATE unidade SET strikes = 0, solta_em = ?, retrabalho = 0, "
                "retrabalho_em = NULL WHERE id = ?", (_agora(), uid))
        else:
            con.execute("UPDATE unidade SET strikes = 0, solta_em = ? WHERE id = ?",
                       (_agora(), uid))
        try:
            transicionar(con, uid, "backlog", tipo_evento="liberada")
        except ErroTransicaoIlegal as e:
            die(str(e))
    extra = " · retrabalho zerado" if args.zerar_retrabalho else ""
    print(f"{C['grn']}✓{C['r']} {args.chave} liberada — volta para a fila.{extra}")


def cmd_reopen(cfg, args):
    if not args.forcar:
        die("reabrir uma unidade 'pronto' exige --forcar — é a única saída de um "
            "estado terminal, e precisa ser decisão explícita.")
    with transacao(Path(args.db)) as con:
        uid = _resolver_unidade_id(con, args.chave)
        con.execute("UPDATE unidade SET pr_numero = NULL, pr_url = NULL WHERE id = ?", (uid,))
        transicionar(con, uid, "backlog", motivo="reaberta por decisão humana",
                    tipo_evento="reaberta", forcar=True)
    print(f"{C['yel']}↺{C['r']} {args.chave} reaberta — volta para a fila.")


def _numero_e_url_do_pr(con: sqlite3.Connection, valor: str):
    m = re.search(r"(\d+)/?$", valor.rstrip("/"))
    if not m:
        die(f"não consegui achar o número do PR em '{valor}'. Use um número ou a URL.")
    numero = int(m.group(1))
    if valor.startswith("http"):
        return numero, valor
    gh = obter_config(con, "github_repo")
    return numero, (f"https://github.com/{gh}/pull/{numero}" if gh else None)


def _pr_existe(github_repo: str | None, numero: int) -> bool:
    """A única chamada de rede do motor fora do vigia (OA-08). Pega erro de
    digitação no PR na hora — sem isto a unidade ficaria em 'revisao' para
    sempre, esperando um vigia que nunca vai achar nada.

    `--json number`, e não a visão padrão: sem `--json` o `gh` também busca o
    status dos checks de CI, e um token sem leitura de checks falha a chamada
    inteira com o PR existindo. Medido em 22/09/2026 no mine-one: `gh pr view
    25` saía 1 com "Resource not accessible by personal access token
    (…statusCheckRollup…)" e `--json number` respondia. Existir é tudo o que
    esta função precisa saber."""
    if not github_repo:
        return True   # nada declarado pra checar; `orq validate` já cobra isso
    if not shutil.which("gh"):
        die("`gh` não está na PATH — não dá para confirmar que o PR existe.")
    r = subprocess.run(["gh", "pr", "view", str(numero), "--repo", github_repo,
                        "--json", "number"],
                       capture_output=True, text=True, timeout=20)
    return r.returncode == 0


# ---------------------------------------------------------------- estado — vigia de PR
# (OA-08)
#
# revisão → pronto é a única transição que nenhuma sessão pode fazer: quando
# o humano funde o PR, a sessão daquela unidade já morreu. Alguém precisa
# perguntar ao GitHub — por `gh`, a cada ciclo do laço (`cmd_loop`, mais
# abaixo). Ver docs/specs/orquestrador-agil/OA-08-vigia-de-pr-no-laco.md.

LIMIAR_VIGIA_ALERTA = 3   # falhas SEGUIDAS do `gh` na mesma unidade que escalam


def _consultar_pr(github_repo: str, numero: int) -> tuple[dict | None, str | None]:
    """Uma chamada `gh pr view --json` por PR. Devolve (info, None) num
    sucesso, ou (None, motivo) em qualquer falha — rede, autenticação, `gh`
    respondendo algo que não é o JSON esperado."""
    try:
        r = subprocess.run(
            ["gh", "pr", "view", str(numero), "--repo", github_repo, "--json",
             "state,mergedAt,mergeCommit,reviewDecision,isDraft,updatedAt"],
            capture_output=True, text=True, timeout=20)
    except Exception as e:
        return None, str(e)[:200]
    if r.returncode != 0:
        return None, (r.stderr or r.stdout or "gh falhou").strip()[:200]
    try:
        return json.loads(r.stdout), None
    except Exception as e:
        return None, f"resposta do gh ilegível: {e}"


def vigiar_prs(con: sqlite3.Connection, github_repo: str | None) -> list[dict]:
    """Uma consulta ao `gh` por unidade em `revisao` com PR aberto, e as
    transições que a resposta dispara (tabela do spec). Roda DENTRO da
    transação que o chamador já abriu — mas NUNCA faz I/O lento aqui dentro
    (teardown de ambiente, `git worktree remove`): devolve, para cada unidade
    que virou `pronto`, o que o chamador precisa para fazer isso DEPOIS de
    fechar a transação (mesma regra de `recolher_sessoes_mortas`).

    Erro do `gh` nunca move unidade — rede instável não pode bloquear
    trabalho revisado, e um `gh` desautenticado não pode virar a esteira
    inteira `bloqueado`. Cada falha grava `vigia_falhou`; três SEGUIDAS na
    mesma unidade escalam para `vigia_alerta`, ainda sem mover nada.
    """
    achados = []
    if not github_repo:
        return achados
    tem_gh = shutil.which("gh") is not None
    for u in con.execute(
            "SELECT id, chave, clickup_id, pr_numero, vigia_falhas, retrabalho, "
            "retrabalho_em FROM unidade WHERE status = 'revisao' AND pr_numero IS NOT NULL"):
        if tem_gh:
            info, erro = _consultar_pr(github_repo, u["pr_numero"])
        else:
            info, erro = None, "`gh` não está na PATH"
        if erro:
            n = u["vigia_falhas"] + 1
            con.execute("UPDATE unidade SET vigia_falhas = ? WHERE id = ?", (n, u["id"]))
            registrar_evento(con, u["id"], "vigia_falhou", texto=erro)
            if n == LIMIAR_VIGIA_ALERTA:
                registrar_evento(con, u["id"], "vigia_alerta",
                                 texto=f"{n} falhas seguidas do vigia: {erro}")
            achados.append({"chave": u["chave"], "desfecho": "falhou", "detalhe": erro})
            continue
        if u["vigia_falhas"]:
            con.execute("UPDATE unidade SET vigia_falhas = 0 WHERE id = ?", (u["id"],))
        con.execute("UPDATE unidade SET pr_draft = ? WHERE id = ?",
                   (1 if info.get("isDraft") else 0, u["id"]))
        if info.get("isDraft"):
            achados.append({"chave": u["chave"], "desfecho": "rascunho"})
            continue
        sessao = con.execute(
            "SELECT worktree, branch FROM sessao WHERE unidade_id = ? "
            "ORDER BY id DESC LIMIT 1", (u["id"],)).fetchone()
        if info.get("state") == "MERGED":
            transicionar(con, u["id"], "pronto", tipo_evento="pr_fundido",
                        motivo=f"PR #{u['pr_numero']} fundido")
            achados.append({"chave": u["chave"], "desfecho": "pronto", "unidade_id": u["id"],
                            "clickup_id": u["clickup_id"],
                            "worktree": sessao["worktree"] if sessao else None,
                            "branch": sessao["branch"] if sessao else None})
        elif info.get("reviewDecision") == "CHANGES_REQUESTED":
            max_rework = int(obter_config(con, "max_rework", "2") or 2)
            if u["retrabalho"] >= max_rework:
                # O teto (OA-09): a devolução que segue à `max_rework`-ésima
                # já fundida some no meio do caminho — aqui é onde a esteira
                # desiste de relançar sozinha e pede decisão humana.
                motivo = (f"{u['retrabalho'] + 1}ª devolução no PR — o defeito provavelmente "
                         f"está no requisito, não na implementação.")
                transicionar(con, u["id"], "bloqueado", tipo_evento="bloqueada", motivo=motivo)
                achados.append({"chave": u["chave"], "desfecho": "bloqueado", "motivo": motivo})
            else:
                transicionar(con, u["id"], "em_progresso", tipo_evento="retrabalho",
                            motivo="revisão pediu mudanças")
                achados.append({
                    "chave": u["chave"], "desfecho": "em_progresso", "unidade_id": u["id"],
                    "pr_numero": u["pr_numero"], "retrabalho": u["retrabalho"],
                    "retrabalho_em": u["retrabalho_em"],
                    "worktree": sessao["worktree"] if sessao else None,
                    "branch": sessao["branch"] if sessao else None})
        elif info.get("state") == "CLOSED":
            motivo = "PR fechado sem merge"
            transicionar(con, u["id"], "bloqueado", tipo_evento="pr_fechado", motivo=motivo)
            achados.append({"chave": u["chave"], "desfecho": "bloqueado", "motivo": motivo})
        # OPEN sem novidade: nenhuma transição, nenhum achado.
    return achados


def _entregador_clickup() -> str:
    """`ORQ_CLICKUP_CMD` vence — mesma convenção de `ORQ_NOTIFY_CMD` (OA-11):
    um único jeito de trocar o binário em toda a esteira."""
    return os.environ.get("ORQ_CLICKUP_CMD") or str(ORQ_REPO / "bin" / "orq-clickup")


def _espelhar_pronto(clickup_id: str | None) -> str | None:
    """`orq-clickup set-status <id> "pronto"` (OA-07) — a única escrita do
    MOTOR no ClickUp: quando o vigia detecta o merge, a sessão que escreveria
    isso já morreu há tempo. Devolve `None` em sucesso, ou o erro em falha —
    NUNCA levanta: um ClickUp fora do ar não pode travar a esteira."""
    if not clickup_id:
        return "unidade sem clickup_id — nada para espelhar"
    try:
        r = subprocess.run([_entregador_clickup(), "set-status", clickup_id, "pronto"],
                           capture_output=True, text=True, timeout=25)
    except Exception as e:
        return str(e)[:200]
    if r.returncode != 0:
        return (r.stderr or r.stdout or "orq-clickup falhou").strip()[:200]
    return None


def _concluir_merge(caminho: Path, repo: str | None, nome_esteira: str, achado: dict) -> str:
    """O que acontece em `pronto`, fora da transação que já gravou a
    transição (docker compose pode levar até dois minutos — segurar o lock
    de escrita por isso seria o mesmo erro que a migração para SQLite
    corrigiu). Nesta ordem, sempre: encerramento fixo → evento → espelho no
    ClickUp (OA-07) → artefatos → worktree e branch local removidos. Se o
    encerramento falhar, a worktree NÃO é removida e fica para `orq sweep`
    cobrar; se o espelho falhar, `orq board` marca ⚠ — nenhum dos dois
    reverte a transição, que já aconteceu."""
    uid, chave = achado["unidade_id"], achado["chave"]
    wt = Path(achado["worktree"]) if achado.get("worktree") else None
    falhas_td = encerramento_fixo(wt) if wt is not None else []
    erro_espelho = _espelhar_pronto(achado.get("clickup_id"))
    with transacao(caminho) as con:
        registrar_evento(con, uid, "teardown_falhou" if falhas_td else "teardown_ok",
                         texto="; ".join(falhas_td))
        registrar_evento(con, uid, "espelho_falhou" if erro_espelho else "espelho_ok",
                         texto=erro_espelho or "")
    arquivar_artefatos(nome_esteira, uid, chave, "pr_fundido")
    if not falhas_td and wt is not None and wt.exists() and repo:
        subprocess.run(["git", "-C", repo, "worktree", "remove", "--force", str(wt)],
                       capture_output=True)
        if achado.get("branch"):
            subprocess.run(["git", "-C", repo, "branch", "-D", achado["branch"]],
                           capture_output=True)
    if falhas_td:
        return (f"{C['yel']}!{C['r']} {chave}: pronto, mas o encerramento do ambiente "
                f"falhou; worktree NÃO removida: {'; '.join(falhas_td)}")
    return f"{C['grn']}✓{C['r']} {chave}: pronto"


def cmd_advance(cfg, args):
    """em_progresso → revisão com --pr. Confere que o PR existe de verdade —
    a única chamada de rede do motor fora do vigia. A worktree SOBREVIVE
    (retrabalho de OA-09 pode reusá-la); só a sessão de agente encerra.

    revisão → pronto com --forcar, sem chamada de rede nenhuma: a saída
    manual para o merge feito fora do fluxo automático (squash local, merge
    na mão) que o vigia (OA-08) nunca veria como `MERGED` — sem ela a
    unidade ficaria em 'revisao' para sempre e travaria a cadeia de
    dependência."""
    caminho = Path(args.db)
    con = abrir_banco(caminho)
    uid = _resolver_unidade_id(con, args.chave)
    status_atual = con.execute(
        "SELECT status FROM unidade WHERE id = ?", (uid,)).fetchone()["status"]

    if args.forcar:
        if status_atual != "revisao":
            con.close()
            die(f"{args.chave} está '{status_atual}', não 'revisao'. --forcar fecha "
                f"uma revisão fundida fora do fluxo automático — não serve para "
                f"outra transição.")
        u = con.execute(
            "SELECT pr_numero, clickup_id FROM unidade WHERE id = ?", (uid,)).fetchone()
        pr_numero = u["pr_numero"]
        repo = obter_config(con, "repo")
        nome_esteira = slugify(obter_config(con, "name") or "esteira", 16)
        sessao = con.execute(
            "SELECT worktree, branch FROM sessao WHERE unidade_id = ? "
            "ORDER BY id DESC LIMIT 1", (uid,)).fetchone()
        con.close()
        with transacao(caminho) as con2:
            uid2 = _resolver_unidade_id(con2, args.chave)
            motivo = (f"PR #{pr_numero} fundido fora do fluxo (--forcar)"
                     if pr_numero else "fundido fora do fluxo (--forcar)")
            transicionar(con2, uid2, "pronto", tipo_evento="pr_fundido_manual", motivo=motivo)
        achado = {"unidade_id": uid, "chave": args.chave, "clickup_id": u["clickup_id"],
                 "worktree": sessao["worktree"] if sessao else None,
                 "branch": sessao["branch"] if sessao else None}
        print(_concluir_merge(caminho, repo, nome_esteira, achado))
        return

    if not args.pr:
        con.close()
        die("--pr é obrigatório (ou use --forcar numa unidade já em 'revisao' "
            "fundida fora do fluxo automático).")
    numero, url = _numero_e_url_do_pr(con, args.pr)
    github_repo = obter_config(con, "github_repo")
    con.close()
    if not _pr_existe(github_repo, numero):
        die(f"PR #{numero} não existe em {github_repo or '(github_repo não declarado)'} "
            f"— ou o `gh` não está autenticado para vê-lo.")

    with transacao(caminho) as con:
        uid = _resolver_unidade_id(con, args.chave)
        con.execute("UPDATE unidade SET pr_numero = ?, pr_url = ? WHERE id = ?",
                   (numero, url, uid))
        row_sessao = con.execute(
            "SELECT tmux, pid FROM sessao WHERE unidade_id = ? AND encerrada_em IS NULL "
            "ORDER BY id DESC LIMIT 1", (uid,)).fetchone()
        try:
            transicionar(con, uid, "revisao", tipo_evento="pr_aberto",
                        motivo=f"PR #{numero}")
        except ErroTransicaoIlegal as e:
            die(str(e))
        encerrar_sessao(con, uid, "advance")
        nome_esteira = slugify(obter_config(con, "name") or "esteira", 16)
    dest = arquivar_artefatos(nome_esteira, uid, args.chave, "advance")
    atraso = _atraso_encerramento(args.chave)
    _matar_sessao_com_delicadeza(row_sessao, atraso)
    if atraso > 3:
        print(f"  esta sessão encerra em {atraso // 60} min — faça o passo 8 (cartão) agora.")
    print(f"{C['grn']}✓{C['r']} {args.chave}: revisão — PR #{numero}"
          + (f" {url}" if url else ""))
    print(f"{C['d']}  artefatos em {dest} · worktree continua (retrabalho pode reusar){C['r']}")


def cmd_tick(cfg, args):
    """Vigia os PRs em `revisao` primeiro (OA-08) — um merge detectado neste
    ciclo libera dependente já no `board` seguinte, e uma devolução relança
    o retrabalho (OA-09) — e só DEPOIS recolhe sessão morta: sem essa ordem,
    a unidade que acabou de virar `em_progresso` por devolução seria lida
    como arranque falho no mesmo ciclo que a devolveu. Preencher vaga
    continua fora daqui: é `orq run`/`orq dispatch`, ou `orq loop`, que
    encadeia os três."""
    caminho = Path(args.db)
    con = abrir_banco(caminho)
    max_strikes = int(obter_config(con, "max_strikes", "2") or 2)
    repo = obter_config(con, "repo")
    github_repo = obter_config(con, "github_repo")
    nome_esteira = slugify(obter_config(con, "name") or "esteira", 16)
    con.close()

    with transacao(caminho) as con:
        achados = vigiar_prs(con, github_repo)
    for a in achados:
        if a["desfecho"] == "pronto":
            print(_concluir_merge(caminho, repo, nome_esteira, a))
        elif a["desfecho"] == "em_progresso":
            print(_relancar_retrabalho(caminho, github_repo, repo, a))
        elif a["desfecho"] == "bloqueado":
            print(f"  {C['red']}✗{C['r']} {a['chave']}: {a.get('motivo', 'bloqueada')}")
        elif a["desfecho"] == "falhou":
            print(f"  {C['red']}!{C['r']} {a['chave']}: vigia falhou — {a['detalhe']}")
        # rascunho: silencioso aqui — aparece no `orq board`.

    with transacao(caminho) as con:
        recolhidas = recolher_sessoes_mortas(con, max_strikes)
    if not recolhidas and not achados:
        print("nada para recolher.")
        return
    for r in recolhidas:
        extra = f" ({r['strikes']}/{max_strikes})" if "strikes" in r else ""
        print(f"  {r['chave']}: {r['desfecho']}{extra}")
        # Quarentena é o único desfecho que mata a worktree (mesma regra de
        # `orq hold` — bloqueado é onde a worktree termina). FORA da
        # transação que já fechou: teardown pode levar minutos.
        if r["desfecho"] == "quarentena" and r.get("worktree"):
            wt = Path(r["worktree"])
            falhas_td = encerramento_fixo(wt)
            if falhas_td:
                print(f"    {C['yel']}!{C['r']} encerramento do ambiente falhou; "
                     f"worktree NÃO removida: {'; '.join(falhas_td)}")
            elif wt.exists() and repo:
                subprocess.run(["git", "-C", repo, "worktree", "remove", "--force", str(wt)],
                               capture_output=True)


# ---------------------------------------------------------------- estado — sessão e
# lançamento (OA-05)
#
# O papel único: uma unidade, um ciclo inteiro — ler o requisito, implementar,
# revisar o próprio trabalho, abrir o PR, atualizar o cartão. Devolve a `orq
# run`/`orq dispatch` que OA-04 tirou, com lançador de verdade contra o banco.
# Ver docs/specs/orquestrador-agil/OA-05-papel-unico-auto-contido.md.
#
# A cerca (`hooks/cerca.sh`) recebe `ORQ_BRANCH`/`ORQ_UNIT`/`ORQ_WORKTREE`/
# `ORQ_BASE` por `settings_json()` — regra de publicação por BRANCH da
# própria unidade desde OA-06, não mais por estágio. O briefing instrui a
# sessão a `orq hold` se for barrada de qualquer jeito: a saída de ser
# barrado nunca é contornar.

CERCA = ORQ_REPO / "hooks" / "cerca.sh"
HOOK = ORQ_REPO / "hooks" / "notificar.sh"
CLAUDE_JSON = Path(os.environ.get("ORQ_CLAUDE_JSON", str(Path.home() / ".claude.json")))


def branch_for(con: sqlite3.Connection, chave: str, clickup_id: str | None,
               titulo: str) -> str:
    template = obter_config(con, "branch_template") or "CU-{id}-{slug}"
    slug_max = int(obter_config(con, "slug_max") or 40)
    return template.format(id=clickup_id or chave, key=chave.lower(),
                           slug=slugify(titulo or chave, slug_max))


def ensure_worktree(con: sqlite3.Connection, u) -> tuple:
    """Cria ou reaproveita a worktree da unidade — nasce de `origin/<base>`, e
    dependência só libera em `pronto` (OA-03), que significa fundido; então o
    código de que esta unidade depende já está na base quando ela nasce (o
    caso que custou uma sessão em 01/09/2026 deixa de ser possível).

    Reaproveitar em vez de recriar é o que permite ao retrabalho de OA-09
    relançar na MESMA worktree: `--ff-only` contra `origin/<base>` traz a
    base para cima sem nunca perder commit — ou avança em linha reta, ou não
    avança."""
    repo = Path(obter_config(con, "repo")).expanduser()
    base = obter_config(con, "base_branch") or "main"
    worktree_root = Path(obter_config(con, "worktree_root")).expanduser()
    branch = branch_for(con, u["chave"], u["clickup_id"], u["titulo"])
    wt = worktree_root / branch
    if wt.exists():
        subprocess.run(["git", "-C", str(repo), "fetch", "--quiet", "origin"],
                       capture_output=True, text=True, timeout=120)
        remoto = f"origin/{base}"
        tem_remoto = subprocess.run(["git", "-C", str(wt), "rev-parse", "--verify", remoto],
                                    capture_output=True).returncode == 0
        subprocess.run(["git", "-C", str(wt), "merge", "--ff-only",
                        remoto if tem_remoto else base],
                       capture_output=True, text=True, timeout=120)
        return wt, branch
    wt.parent.mkdir(parents=True, exist_ok=True)
    existe = subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", branch],
                            capture_output=True).returncode == 0
    args = ["git", "-C", str(repo), "worktree", "add", str(wt)]
    args += [branch] if existe else ["-b", branch, base]
    r = subprocess.run(args, capture_output=True, text=True)
    if r.returncode != 0:
        die(f"falha ao criar worktree para {u['chave']}: {r.stderr.strip()[:300]}")
    return wt, branch


def ensure_trusted(repo: Path, path: Path) -> None:
    """A worktree HERDA a confiança do repositório base — nunca a inventa. Se
    o base não estiver marcado como confiável, recusa em vez de decidir por
    você; senão o Claude Code abriria o diálogo de confiança numa sessão
    desacoplada, e ela travaria antes de começar."""
    if not CLAUDE_JSON.exists():
        die(f"{CLAUDE_JSON} não existe — abra o Claude Code uma vez antes.")
    try:
        d = json.loads(CLAUDE_JSON.read_text())
    except Exception as e:
        die(f"não consegui ler {CLAUDE_JSON}: {e}")
    projects = d.setdefault("projects", {})
    base = projects.get(str(repo), {})
    if not base.get("hasTrustDialogAccepted"):
        die(f"o repositório base não está marcado como confiável.\n"
            f"  Abra-o uma vez e aceite: cd {repo} && claude\n"
            f"  A esteira só herda confiança; nunca a concede por conta própria.")
    entry = projects.setdefault(str(path), {})
    if entry.get("hasTrustDialogAccepted"):
        return
    entry["hasTrustDialogAccepted"] = True
    tmp = CLAUDE_JSON.with_suffix(".json.orq-tmp")
    tmp.write_text(json.dumps(d, ensure_ascii=False, indent=2))
    tmp.replace(CLAUDE_JSON)


def settings_json(label: str, worktree: str, branch: str, base: str) -> str:
    """A cerca (PreToolUse) e os avisos (Notification/Stop) que a sessão
    recebe. A CERCA É UM GANCHO, não uma lista de negação — decidido por
    experimento em 02/09/2026: uma negação `Bash(git push:*)` por --settings
    NÃO venceu um `allow` idêntico que a pessoa já tinha nas próprias
    configurações. O gancho vê o comando inteiro, roda sempre, não é anulável.

    `ORQ_BRANCH`/`ORQ_BASE` (OA-06) substituem o `ORQ_STAGE` de antes: a regra
    de publicação da cerca passou a ser por branch da própria unidade, não
    por papel — não há mais sessão de integração para autorizar.
    """
    if not CERCA.exists():
        die(f"a cerca sumiu: {CERCA}\n"
            f"  Nenhuma sessão sobe sem ela. Restaure com:\n"
            f"    git -C {ORQ_REPO} checkout hooks/cerca.sh")
    amb = f"ORQ_UNIT={label} ORQ_WORKTREE={worktree} ORQ_BRANCH={branch} ORQ_BASE={base}"
    return json.dumps({"hooks": {
        "PreToolUse": [{"hooks": [{"type": "command", "command": f"{amb} {CERCA}"}]}],
        "Notification": [{"hooks": [{"type": "command",
                                     "command": f"ORQ_UNIT={label} {HOOK} notification"}]}],
        "Stop": [{"hooks": [{"type": "command",
                             "command": f"ORQ_UNIT={label} {HOOK} stop"}]}]}})


def sess_name(con: sqlite3.Connection, chave: str) -> str:
    nome = slugify(obter_config(con, "name") or "esteira", 16)
    return f"orq-{nome}-{chave}"


def argumentos_new_session(nome: str, wt, ambiente: dict, cmd: list) -> list:
    """Monta o `tmux new-session` levando o ambiente da unidade por `-e`.

    `subprocess.run(env=...)` só alcança o CLIENTE tmux — quando o servidor já
    está de pé (dias, compartilhado por todas as esteiras da máquina), a
    sessão nova herda o ambiente do SERVIDOR, congelado na primeira sessão que
    o criou. `-e` (tmux ≥ 3.2) põe a variável no ambiente da SESSÃO, o único
    escopo por unidade que existe aqui."""
    args = ["tmux", "new-session", "-d", "-s", nome, "-c", str(wt)]
    for chave in sorted(ambiente):
        args += ["-e", f"{chave}={ambiente[chave]}"]
    # O comando por último, sempre: tmux trata o primeiro argumento livre como
    # o comando do painel, e uma opção depois dele viraria argumento DELE.
    return args + list(cmd)


BRIEFING = """Você é o agente auto-contido da esteira "{pipeline}". Um papel só, um ciclo
inteiro: ler o requisito, implementar, revisar o próprio trabalho, abrir o PR,
atualizar o cartão. Não há segunda sessão atrás de você — o que você não
verificar, ninguém verifica antes de uma pessoa olhar o PR.

Tarefa: {chave} — {titulo}
Cartão: {url}
Worktree: {worktree}  (branch {branch}, a partir de {base})
Repositório: {repo}

────────────────────────────────────────────────────────────────────────────
1. MARQUE O CARTÃO E LEIA A TAREFA INTEIRA — antes de qualquer outra coisa

    orq-clickup set-status {clickup_id} "em progresso"
    orq-clickup show {clickup_id}

O status muda SEM comentário — o Telegram já avisa que a unidade começou, e
um comentário a cada início vira ruído no cartão (OA-07).

`orq-clickup show` imprime a descrição E todos os comentários, do mais
antigo ao mais recente. Os comentários não são conversa paralela: é onde
mora o que a descrição não tem.

  - Divergências entre a descrição e o código real, registradas por quem veio
    antes.
  - Ambiguidades que uma sessão anterior encontrou e deliberadamente NÃO
    resolveu sozinha — se você resolver por conta própria sem dizer, ninguém
    saberá.
  - Um comentário pedindo mudança numa revisão anterior: esta unidade já teve
    PR devolvido, e o que foi pedido é o seu escopo agora, com prioridade
    sobre o resto do cartão.
  - Instruções escritas por uma pessoa no meio do caminho.

Tratar a descrição como o todo é o erro mais caro desta esteira: você refaz
uma decisão que já foi tomada, ou repete um engano que já foi diagnosticado.

────────────────────────────────────────────────────────────────────────────
2. PREPARO — leia o CLAUDE.md ou AGENTS.md deste projeto

A worktree nasce sem dependência instalada e sem nada subido. Quem diz como
deixar isto pronto é o `CLAUDE.md`/`AGENTS.md` do PRÓPRIO projeto — não um
portão declarado à parte: uma cópia mantida fora do projeto diverge do
comando real e falha pelo motivo errado.

Se o repositório não tiver nenhum dos dois: pare com `orq hold`. Não é "sem
portão" — é um projeto sem guia, e inventar um comando é pior que admitir a
lacuna.

────────────────────────────────────────────────────────────────────────────
3. IMPLEMENTE — escopo é o do cartão

Defeito fora de escopo vira comentário no cartão (`orq-clickup comment`), não
conserto. Ambiguidade genuína no critério: pare e pergunte — não decida
sozinho por um lado.

────────────────────────────────────────────────────────────────────────────
4. REVISE O PRÓPRIO TRABALHO — não há segunda leitura

Para CADA critério de aceite do cartão: atendido, não atendido, ou não
verificável — com evidência (arquivo e linha, ou a saída de um comando).
Critério sem evidência NÃO está atendido. O caminho para isso é travar
(`orq hold`), nunca afirmar.

────────────────────────────────────────────────────────────────────────────
5. RODE A VERIFICAÇÃO QUE O CLAUDE.md MANDA

Tipo, lint, teste — o que o projeto declarar. Cole a saída no corpo do PR.

────────────────────────────────────────────────────────────────────────────
6. COMMIT, PUBLIQUE, ABRA O PR — e NÃO FUNDA

    git add -A && git commit -m "<tipo(escopo): assunto>"
    git push -u origin {branch}
    gh pr create --base {base} --repo {github_repo} \\
        --title "<tipo(escopo): assunto>" --body "<...>"

O corpo do PR carrega: os critérios de aceite com a evidência do passo 4, a
saída da verificação do passo 5, e o que ficou fora de escopo e por quê.

VOCÊ NÃO FUNDE. `gh pr merge` é barrado pela cerca, sem exceção — quem decide
fundir é uma pessoa, olhando o diff.

SE A CERCA BARRAR O `git push`: a saída NÃO é contornar nem tentar outro
jeito — pare com `orq hold` explicando que a publicação foi barrada. Ordem
que a cerca proíbe não é ordem; já custou sessões inteiras insistir.

────────────────────────────────────────────────────────────────────────────
7. ENCERRE — por um destes dois caminhos, sempre

    orq advance {chave} --pr <número ou URL do PR>
    orq hold    {chave} --motivo "<o que exatamente trava>"

`advance` só depois do PR aberto — sem PR não há o que o gate humano revisar,
e o comando recusa se o PR não existir de verdade. `hold` é para o que só uma
pessoa resolve: credencial que falta, decisão de produto, ambiguidade que não
dá para resolver sozinho.

Encerrar sem nenhum dos dois deixa a unidade em 'em_progresso' sem sessão
viva — a esteira lê isso como arranque falho e conta uma falta.

Rode `advance`/`hold` SOZINHO, não encadeado com outros comandos. Ele
encerra esta sessão 3 minutos depois: faça o passo 8 logo em seguida, sem
mais nada no meio.

────────────────────────────────────────────────────────────────────────────
8. SÓ DEPOIS, ATUALIZE O CARTÃO — os dois lados do espelho (OA-07)

Se você abriu PR (`orq advance` no passo 7):

    orq-clickup set-status {clickup_id} "revisão"
    orq-clickup comment {clickup_id} "<URL do PR, os critérios de aceite com a
        evidência do passo 4, e a saída da verificação do passo 5>"

Se você travou (`orq hold` no passo 7):

    orq-clickup set-status {clickup_id} "bloqueado"
    orq-clickup comment {clickup_id} "AGUARDANDO DECISÃO HUMANA: <o mesmo
        motivo que você passou a --motivo>"

NESTA ORDEM, não na inversa: o banco (passo 7) é a autoridade da esteira; o
cartão é só o espelho que uma pessoa lê. Se você morrer entre os dois passos,
a divergência fica visível no lugar onde alguém olha — o cartão —, e o
rastro do banco permite reconstruir o que houve. Escrever o cartão antes de
encerrar deixaria o cartão dizendo "revisão" com a esteira ainda achando que
ninguém trabalhou.
"""


def build_brief(con: sqlite3.Connection, u, wt: Path, branch: str, *, prefixo: str = "") -> str:
    """`prefixo` (OA-09): o bloco RETRABALHO vai ANTES de tudo — o escopo da
    revisão devolvida tem prioridade sobre o resto do cartão, e um bloco no
    meio do briefing se perde entre as oito seções normais."""
    base = obter_config(con, "base_branch") or "main"
    repo = obter_config(con, "repo") or "?"
    github_repo = obter_config(con, "github_repo") or "(github_repo não declarado)"
    url = (f"https://app.clickup.com/t/{u['clickup_id']}" if u["clickup_id"]
          else "(sem ClickUp)")
    return prefixo + BRIEFING.format(
        pipeline=obter_config(con, "name") or "(sem nome)", chave=u["chave"],
        clickup_id=u["clickup_id"] or "?", titulo=u["titulo"] or "(ver ClickUp)",
        url=url, worktree=wt, branch=branch, base=base, repo=repo,
        github_repo=github_repo)


def launch(con: sqlite3.Connection, banco: Path, u, attach: bool = False, *,
          prefixo_briefing: str = "") -> str:
    """Lança a sessão: worktree, confiança, briefing, settings, tmux ou
    processo solto. Só a ÚLTIMA escrita (registrar a sessão) roda em
    transação — o resto é git/tmux e pode demorar; segurar o lock de escrita
    durante isso seria o mesmo erro que a migração para SQLite corrigiu."""
    STATE.mkdir(parents=True, exist_ok=True)
    wt, branch = ensure_worktree(con, u)
    repo = Path(obter_config(con, "repo")).expanduser()
    base = obter_config(con, "base_branch") or "main"
    ensure_trusted(repo, wt)
    label = u["chave"]
    nome_esteira = slugify(obter_config(con, "name") or "esteira", 16)
    brief_path = STATE / f"{nome_esteira}-{u['id']}.brief.md"
    brief_path.write_text(build_brief(con, u, wt, branch, prefixo=prefixo_briefing))
    setts = STATE / f"{nome_esteira}-{u['id']}.settings.json"
    setts.write_text(settings_json(label, str(wt), branch, base))
    logf = STATE / f"{nome_esteira}-{u['id']}.log"

    permission_mode = obter_config(con, "permission_mode") or "auto"
    cmd = ["claude", "--permission-mode", permission_mode,
           "--settings", str(setts), "--add-dir", str(wt)]
    remote_control = (obter_config(con, "remote_control") or "true").strip().lower()
    if remote_control not in ("false", "0", "nao", "não"):
        # Toda sessão sobe com acompanhamento remoto — não é conveniência, é
        # como uma pessoa vê e interrompe, de outro dispositivo, uma sessão
        # que está agindo sozinha.
        cmd += ["--remote-control", f"{nome_esteira}-{label}"]
    modelo = obter_config(con, "model")
    if modelo:
        cmd += ["--model", modelo]
    cmd += [f"Leia e siga integralmente o briefing em {brief_path}. "
            f"Ele é a sua única ordem de serviço."]

    ambiente_unidade = {"ORQ_UNIT": label, "ORQ_LOG_DIR": str(STATE), "ORQ_DB": str(banco)}
    env = {**os.environ, **ambiente_unidade}
    nome_sessao = sess_name(con, label)
    tmux_nome, pid = None, None
    if has_tmux():
        subprocess.run(["tmux", "kill-session", "-t", nome_sessao], capture_output=True)
        subprocess.run(argumentos_new_session(nome_sessao, wt, ambiente_unidade, cmd),
                       env=env, check=True)
        subprocess.run(["tmux", "pipe-pane", "-t", nome_sessao, "-o", f"cat >> {logf}"],
                       capture_output=True)
        tmux_nome = nome_sessao
        how = f"orq attach {label}   (ou: tmux attach -t {nome_sessao})"
    else:
        with open(logf, "ab") as fh:
            p = subprocess.Popen(cmd, cwd=str(wt), env=env, stdout=fh,
                                 stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                 start_new_session=True)
        pid = p.pid
        how = f"orq log {label} -f   (tmux ausente)"

    with transacao(banco) as con_escrita:
        uid = con_escrita.execute(
            "SELECT id FROM unidade WHERE chave = ?", (label,)).fetchone()["id"]
        registrar_sessao(con_escrita, uid, worktree=str(wt), branch=branch,
                         tmux=tmux_nome, pid=pid)

    if attach and has_tmux():
        os.execvp("tmux", ["tmux", "attach", "-t", nome_sessao])
    return how


# ---------------------------------------------------------------- estado — retrabalho
# a partir do PR (OA-09)
#
# A detecção (revisão devolvida → em_progresso) é do vigia (OA-08); esta
# seção é só o QUE FAZER com isso — montar o escopo a partir da revisão de
# verdade, relançar na MESMA worktree/branch, e o teto que manda para
# decisão humana. Ver
# docs/specs/orquestrador-agil/OA-09-retrabalho-a-partir-do-pr.md.

def _atualizar_worktree_ou_falhar(repo: Path, wt: Path, base: str) -> str | None:
    """`git fetch` + `merge --ff-only origin/<base>` na worktree já
    existente — a MESMA operação que `ensure_worktree` já faz ao reaproveitar
    uma worktree, mas aqui o resultado é CHECADO: o retrabalho nunca pode
    assumir que a base convergiu só porque o comando rodou. Devolve `None`
    em sucesso, ou uma mensagem legível em falha (base divergiu de verdade —
    conciliar é julgamento humano, não do agente)."""
    subprocess.run(["git", "-C", str(repo), "fetch", "--quiet", "origin"],
                   capture_output=True, text=True, timeout=120)
    remoto = f"origin/{base}"
    tem_remoto = subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", remoto],
                                capture_output=True).returncode == 0
    r = subprocess.run(["git", "-C", str(wt), "merge", "--ff-only",
                        remoto if tem_remoto else base],
                       capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        return (r.stderr or r.stdout or "merge --ff-only falhou").strip()[:300]
    return None


def _coletar_retrabalho(github_repo: str, numero: int, desde: str | None) -> dict:
    """`gh pr view --json reviews` (revisões CHANGES_REQUESTED) + `gh api
    .../pulls/<n>/comments` (comentários de LINHA — endpoint diferente, a
    REST API de review comments). Só o que é mais novo que `desde` entra —
    sem isso a segunda rodada repetiria achados da primeira, já corrigidos."""
    reviews, comentarios = [], []
    try:
        r = subprocess.run(
            ["gh", "pr", "view", str(numero), "--repo", github_repo, "--json", "reviews"],
            capture_output=True, text=True, timeout=20)
        if r.returncode == 0:
            for rv in json.loads(r.stdout).get("reviews", []):
                if rv.get("state") != "CHANGES_REQUESTED":
                    continue
                quando = rv.get("submittedAt") or ""
                if desde and quando and quando <= desde:
                    continue
                reviews.append(rv)
    except Exception:
        pass
    try:
        r = subprocess.run(
            ["gh", "api", "--paginate", f"repos/{github_repo}/pulls/{numero}/comments"],
            capture_output=True, text=True, timeout=20)
        if r.returncode == 0:
            for c in json.loads(r.stdout):
                quando = c.get("created_at") or ""
                if desde and quando and quando <= desde:
                    continue
                comentarios.append(c)
    except Exception:
        pass
    return {"reviews": reviews, "comentarios": comentarios}


def _formatar_bloco_retrabalho(ordem: int, maximo: int, numero: int, colhido: dict) -> str:
    """O bloco que vai ANTES de tudo no briefing (`build_brief(prefixo=...)`)
    — formato fixo do spec, para o agente nunca precisar adivinhar onde
    termina o escopo do retrabalho e começa o resto do cartão."""
    reviews = colhido["reviews"]
    if reviews:
        blocos = []
        for rv in reviews:
            autor = (rv.get("author") or {}).get("login") or "?"
            data = (rv.get("submittedAt") or "")[:10] or "?"
            corpo = (rv.get("body") or "").strip() or "(sem corpo)"
            blocos.append(f"O que foi pedido (revisão de {autor}, {data}):\n{corpo}")
        secao_reviews = "\n\n".join(blocos)
    else:
        secao_reviews = "O que foi pedido: (ver os comentários de linha abaixo)"
    comentarios = colhido["comentarios"]
    if comentarios:
        linhas = "\n".join(
            f"{c.get('path') or '?'}:{c.get('line') or c.get('original_line') or '?'} — "
            f"{(c.get('body') or '').strip()}"
            for c in comentarios)
    else:
        linhas = "(nenhum)"
    return (
        f"RETRABALHO {ordem}/{maximo} — este PR foi devolvido pela revisão humana.\n\n"
        f"{secao_reviews}\n\n"
        f"Comentários de linha:\n{linhas}\n\n"
        f"Estes achados SÃO o seu escopo, com prioridade sobre o resto da tarefa. O PR\n"
        f"#{numero} continua aberto no mesmo branch: corrija, rode os portões de novo,\n"
        f"comite e empurre. NÃO abra outro PR.\n\n"
        + "─" * 78 + "\n\n"
    )


def _relancar_retrabalho(caminho: Path, github_repo: str | None, repo: str | None,
                         achado: dict) -> str:
    """A metade de fora-da-transação do retrabalho: `vigiar_prs` já gravou
    revisão→em_progresso; esta função decide o que fazer AGORA que isso
    aconteceu — atualizar a worktree (checado), coletar a revisão de
    verdade, relançar. Roda ANTES de `recolher_sessoes_mortas` no mesmo
    ciclo (`cmd_tick`/`cmd_loop`): sem isso, a unidade que acabou de virar
    `em_progresso` sem sessão viva seria lida como arranque falho no mesmo
    tick que a devolveu."""
    uid, chave = achado["unidade_id"], achado["chave"]
    wt = Path(achado["worktree"]) if achado.get("worktree") else None
    if wt is None or not wt.exists() or not repo:
        motivo = "retrabalho sem worktree para reusar — a sessão original nunca chegou a rodar"
        with transacao(caminho) as con:
            transicionar(con, uid, "bloqueado", tipo_evento="bloqueada", motivo=motivo)
        return f"{C['red']}✗{C['r']} {chave}: {motivo}"

    con = abrir_banco(caminho)
    base = obter_config(con, "base_branch") or "main"
    max_rework = int(obter_config(con, "max_rework", "2") or 2)
    con.close()

    erro_merge = _atualizar_worktree_ou_falhar(Path(repo), wt, base)
    if erro_merge:
        motivo = f"base divergiu — merge --ff-only falhou: {erro_merge}"
        with transacao(caminho) as con:
            transicionar(con, uid, "bloqueado", tipo_evento="bloqueada", motivo=motivo)
        return f"{C['red']}✗{C['r']} {chave}: {motivo}"

    colhido = {"reviews": [], "comentarios": []}
    if github_repo and shutil.which("gh"):
        colhido = _coletar_retrabalho(github_repo, achado["pr_numero"], achado["retrabalho_em"])
    ordem = achado["retrabalho"] + 1
    bloco = _formatar_bloco_retrabalho(ordem, max_rework, achado["pr_numero"], colhido)

    con = abrir_banco(caminho)
    u = con.execute("SELECT * FROM unidade WHERE id = ?", (uid,)).fetchone()
    how = launch(con, caminho, u, prefixo_briefing=bloco)
    con.close()

    with transacao(caminho) as con:
        con.execute("UPDATE unidade SET retrabalho = ?, retrabalho_em = ? WHERE id = ?",
                   (ordem, _agora(), uid))
        registrar_evento(con, uid, "retrabalho_relancado",
                         texto=f"relançado {ordem}/{max_rework}")
    return f"{C['grn']}✓{C['r']} {chave}: retrabalho {ordem}/{max_rework} relançado — {how}"


def arquivar_artefatos(nome_esteira: str, uid: int, chave: str, outcome: str) -> Path:
    """Guarda briefing, settings e log num diretório com `meta.json` — puro
    sistema de arquivos, sem tocar o banco, para poder rodar tanto dentro
    quanto fora de uma transação sem custar tempo de lock."""
    ts = time.strftime("%Y%m%d-%H%M%S")
    dest = STATE / "archive" / nome_esteira / f"{chave}-{ts}"
    dest.mkdir(parents=True, exist_ok=True)
    movidos = []
    for suf in (".brief.md", ".settings.json", ".log"):
        f = STATE / f"{nome_esteira}-{uid}{suf}"
        if f.exists():
            shutil.move(str(f), dest / f.name)
            movidos.append(f.name)
    (dest / "meta.json").write_text(json.dumps({
        "unidade": chave, "outcome": outcome,
        "arquivado_em": time.strftime("%FT%TZ", time.gmtime()), "artefatos": movidos,
    }, ensure_ascii=False, indent=2))
    return dest


ESPERA_PASSO_8_S = 180


def _atraso_encerramento(chave: str) -> int:
    """Quanto esperar antes de matar a sessão que acabou de sair de trabalho.

    Chamado de DENTRO da própria sessão (`ORQ_UNIT` é a unidade), o briefing
    ainda manda um passo depois: espelhar o cartão (passo 8). Com os 3 s de
    antes a sessão morria no meio desse passo, sempre — medido em 22/09/2026
    no mine-one: o cartão do DS-05 ficou em "em progresso" com a unidade em
    revisão, e o acompanhamento remoto mostrava o `orq advance` rodando para
    sempre. De fora (uma pessoa no terminal), não há passo seguinte."""
    return ESPERA_PASSO_8_S if os.environ.get("ORQ_UNIT") == chave else 3


def _matar_sessao_com_delicadeza(row_sessao, kill_delay: int = 3) -> None:
    """SIGTERM antes de `tmux kill-session`, adiado. `advance`/`hold` costumam
    ser chamados DE DENTRO da própria sessão — matar na hora mataria o
    processo que está executando o comando antes de ele terminar. E matar de
    supetão não dá ao Claude Code a chance de se despedir: a sessão sobe com
    `--remote-control`, e morta assim ela fica listada como offline para
    sempre em claude.ai/code."""
    if row_sessao is None:
        return
    if row_sessao["tmux"]:
        nome = row_sessao["tmux"]
        panes = subprocess.run(["tmux", "list-panes", "-t", nome, "-F", "#{pane_pid}"],
                               capture_output=True, text=True).stdout.split()
        alvos = " ".join(f"-{p}" for p in panes)
        encerra = (f"sleep {kill_delay}; "
                   + (f"kill -TERM {alvos} 2>/dev/null; sleep 4; " if panes else "")
                   + f"tmux kill-session -t {nome}")
        subprocess.Popen(["sh", "-c", encerra], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    elif row_sessao["pid"]:
        try:
            os.kill(int(row_sessao["pid"]), 15)
        except Exception:
            pass


def encerramento_fixo(worktree: Path) -> list:
    """O encerramento de ambiente que toda unidade recebe ao sair de
    `em_progresso` para `bloqueado` — NUNCA declarado por esteira, desde que
    os portões saíram do orquestrador (OA-02). Busca por convenção, a mesma
    que a skill `esteira-sandbox` já usa para achar serviço: qualquer
    `docker-compose*.yml`/`.yaml` ou `compose*.yml`/`.yaml` na raiz da
    worktree, `down`. Nada encontrado não é falha — é nada para encerrar.

    Antecipado de OA-08 (que descreve este mesmo mecanismo para o gatilho de
    merge): construído aqui porque `orq hold` já precisa dele, e duplicar
    depois seria desperdício. Existe porque 27 ambientes sobreviveram a uma
    noite inteira segurando 8,8 GB de uma VPS.
    """
    if not worktree.exists():
        return []
    falhas = []
    vistos = set()
    for padrao in ("docker-compose*.yml", "docker-compose*.yaml",
                   "compose*.yml", "compose*.yaml"):
        for arquivo in sorted(worktree.glob(padrao)):
            if arquivo in vistos:
                continue
            vistos.add(arquivo)
            try:
                r = subprocess.run(
                    ["docker", "compose", "-f", str(arquivo), "down",
                     "--volumes", "--remove-orphans"],
                    cwd=str(worktree), capture_output=True, text=True, timeout=120)
                if r.returncode != 0:
                    falhas.append(f"{arquivo.name} → "
                                 f"{(r.stderr or r.stdout or '').strip()[:160]}")
            except Exception as e:
                falhas.append(f"{arquivo.name} → {str(e)[:160]}")
    return falhas


def capacidade(con: sqlite3.Connection) -> dict:
    """Quantas sessões A MAIS cabem agora — vagas LIVRES, nunca teto total: a
    RAM disponível já desconta o que está vivo, então comparar 'vivas >= teto'
    contaria o mesmo consumo duas vezes e travaria a esteira em zero.

    Um orçamento só (`ram_per_session_gb`) — não há mais estágio com custo
    diferente (OA-03)."""
    logical = os.cpu_count() or 4
    total, load1 = total_ram_gb(), os.getloadavg()[0]
    free = available_ram_gb()
    per = float(obter_config(con, "ram_per_session_gb") or 1.2)
    reserve = float(obter_config(con, "reserve_ram_gb") or 3.0)
    nlive = sum(1 for u in con.execute(
        "SELECT id FROM unidade WHERE status = 'em_progresso'") if sessao_viva(con, u["id"]))

    by_ram = max(0, int((free - reserve) // per)) if free >= 0 else 1
    cpu_ceiling = max(1, logical - 2)
    load_factor = float(obter_config(con, "load_factor") or 3.0)
    load_ceiling = max(1, int(logical * load_factor - load1))
    by_cpu = max(0, cpu_ceiling - nlive)
    by_load = max(0, load_ceiling - nlive)
    hard = int(obter_config(con, "max_concurrent") or 0)
    by_hard = max(0, hard - nlive) if hard else 10 ** 6

    return {"logical_cpus": logical, "total_ram_gb": round(total, 1),
            "free_ram_gb": round(free, 1), "load1": round(load1, 2),
            "ram_per_session_gb": per, "reserve_ram_gb": reserve, "live": nlive,
            "by_ram": by_ram, "by_cpu": by_cpu, "by_load": by_load, "hard_cap": hard,
            "slots_free": min(by_ram, by_cpu, by_load, by_hard)}


def cmd_capacity(cfg, args):
    con = abrir_banco(Path(args.db))
    cap = capacidade(con)
    con.close()
    print(f"vagas livres: {cap['slots_free']}  (vivas: {cap['live']})")
    print(f"RAM: {cap['free_ram_gb']}GB livre de {cap['total_ram_gb']}GB total · "
          f"{cap['ram_per_session_gb']}GB/sessão + {cap['reserve_ram_gb']}GB de reserva "
          f"→ {cap['by_ram']} por RAM")
    print(f"CPU/carga: {cap['by_cpu']} por CPU, {cap['by_load']} por carga "
          f"(load1={cap['load1']}, {cap['logical_cpus']} lógicos)")
    if cap["hard_cap"]:
        print(f"max_concurrent: {cap['hard_cap']} (restam "
              f"{max(0, cap['hard_cap'] - cap['live'])})")


def cmd_run(cfg, args):
    caminho = Path(args.db)
    con = abrir_banco(caminho)
    uid = _resolver_unidade_id(con, args.chave)
    u = con.execute("SELECT * FROM unidade WHERE id = ?", (uid,)).fetchone()
    if u["status"] != "backlog" and not args.force:
        die(f"{args.chave} está '{u['status']}', não 'backlog'. --force ignora.")
    if u["status"] == "backlog":
        prontas_ids = {r["id"] for r in unidades_prontas(con)}
        if uid not in prontas_ids and not args.force:
            faltando = con.execute(
                "SELECT dep.chave AS chave FROM dependencia d "
                "JOIN unidade dep ON dep.id = d.depende_de "
                "WHERE d.unidade_id = ? AND dep.status != 'pronto'", (uid,)).fetchall()
            die(f"{args.chave} espera: {', '.join(f['chave'] for f in faltando)}. "
                f"--force ignora.")
    if sessao_viva(con, uid):
        die(f"{args.chave} já tem sessão viva. `orq attach {args.chave}` ou --force.")
    cap = capacidade(con)
    if cap["slots_free"] <= 0 and not args.force:
        die(f"sem vaga: RAM livre {cap['free_ram_gb']}GB (precisa "
            f"{cap['ram_per_session_gb']}GB + {cap['reserve_ram_gb']}GB de reserva), "
            f"{cap['live']} viva(s). --force ignora.")

    how = launch(con, caminho, u, attach=args.attach)
    with transacao(caminho) as con2:
        uid2 = _resolver_unidade_id(con2, args.chave)
        try:
            transicionar(con2, uid2, "em_progresso", tipo_evento="despachada")
        except ErroTransicaoIlegal as e:
            die(str(e))
    print(f"{C['grn']}✓{C['r']} {args.chave} despachada")
    print(f"  {how}")


def cmd_dispatch(cfg, args):
    caminho = Path(args.db)
    con = abrir_banco(caminho)
    prontas = unidades_prontas(con)
    cap = capacidade(con)
    vagas = cap["slots_free"]
    n = min(args.n or vagas, vagas, len(prontas))
    if n <= 0:
        print(f"nada a disparar (prontas: {len(prontas)}, vagas: {vagas}).")
        return
    picked = prontas[:n]
    print(f"{C['b']}Disparando {n}{C['r']} de {len(prontas)} prontas (vagas: {vagas})")
    for r in picked:
        print(f"  {r['chave']:<10} {r['modo']:<10} {(r['titulo'] or '')[:50]}")
    hands = [r["chave"] for r in picked if r["modo"] == "hands-on"]
    if hands:
        print(f"{C['yel']}atenção:{C['r']} {', '.join(hands)} hands-on — "
             f"acompanhe com attach.")
    if not args.yes and input("\nconfirmar? [s/N] ").strip().lower() not in ("s", "sim", "y"):
        print("cancelado.")
        return
    for r in picked:
        try:
            how = launch(con, caminho, r, attach=False)
            with transacao(caminho) as con2:
                uid2 = con2.execute(
                    "SELECT id FROM unidade WHERE chave = ?", (r["chave"],)).fetchone()["id"]
                transicionar(con2, uid2, "em_progresso", tipo_evento="despachada")
            print(f"  {C['grn']}✓{C['r']} {r['chave']} — {how}")
        except SystemExit:
            print(f"  {C['red']}pulou {r['chave']}{C['r']}")


# ---------------------------------------------------------------- estado — laço
# autônomo (OA-08)
#
# A ordem de cada ciclo é proposital: vigia PRs primeiro, porque um merge
# detectado agora pode liberar uma dependente que este MESMO ciclo já pode
# despachar — em vez de esperar o próximo. Só depois recolhe sessão morta e
# preenche vaga. `orq tick` continua fazendo só as duas primeiras peças
# (nunca despacha sozinho); é `orq loop` que encadeia as três.

IDLE_CICLOS_PARA_PARAR = 20   # ver "Riscos" do spec: revisão conta como vivo


def _intervalo_efetivo(con: sqlite3.Connection, explicito: int | None) -> int:
    """`explicito` vem de `--interval` — `None` quando a flag não foi dada
    (default 0 confundiria "não passei" com "passei 0 de propósito")."""
    if explicito is not None:
        return explicito
    return int(obter_config(con, "interval_seconds", "60") or 60)


def _preencher_vaga(con: sqlite3.Connection, caminho: Path) -> list[str]:
    """A parte de `cmd_dispatch` que não pergunta nada — o laço já decidiu
    rodar sozinho ao chamar `orq loop`; pedir confirmação a cada ciclo
    travaria exatamente o automatismo que o laço existe para dar."""
    prontas = unidades_prontas(con)
    vagas = capacidade(con)["slots_free"]
    linhas = []
    for r in prontas[:max(0, vagas)]:
        try:
            how = launch(con, caminho, r, attach=False)
        except SystemExit:
            linhas.append(f"  {C['red']}pulou {r['chave']}{C['r']}")
            continue
        with transacao(caminho) as con2:
            uid2 = con2.execute(
                "SELECT id FROM unidade WHERE chave = ?", (r["chave"],)).fetchone()["id"]
            transicionar(con2, uid2, "em_progresso", tipo_evento="despachada")
        linhas.append(f"  {C['grn']}▶{C['r']} {r['chave']} — {how}")
    return linhas


def _trabalho_vivo(con: sqlite3.Connection) -> bool:
    """Ocioso é o laço esperando UMA PESSOA — nunca esperando a si mesmo.
    Sessão viva conta; unidade em `revisao` TAMBÉM conta desde OA-08: o gate
    humano faz 'nada vivo' virar comum, e sem esta correção o laço morre
    enquanto só falta alguém revisar um PR."""
    em_progresso = con.execute(
        "SELECT id FROM unidade WHERE status = 'em_progresso'").fetchall()
    if any(sessao_viva(con, u["id"]) for u in em_progresso):
        return True
    return con.execute(
        "SELECT 1 FROM unidade WHERE status = 'revisao' LIMIT 1").fetchone() is not None


def _esteira_concluida(con: sqlite3.Connection) -> bool:
    """Nada além de `pronto` — nenhuma unidade pendurada em backlog,
    em_progresso, revisao ou bloqueado. Distingue "terminamos" de "o laço
    desistiu de esperar" (OA-11): são dois avisos diferentes."""
    return con.execute(
        "SELECT 1 FROM unidade WHERE status != 'pronto' LIMIT 1").fetchone() is None


def cmd_loop(cfg, args):
    """O laço autônomo: vigia PRs (merge, retrabalho — OA-09, fechamento) →
    recolhe sessão morta → preenche vaga, a cada `interval_seconds` (padrão
    60s). Para depois de `IDLE_CICLOS_PARA_PARAR` ciclos sem nada vivo e sem
    nada mudar — é esperar um humano para sempre em silêncio que este
    limite evita."""
    caminho = Path(args.db)
    con = abrir_banco(caminho)
    interval = _intervalo_efetivo(con, args.interval)
    github_repo = obter_config(con, "github_repo")
    repo = obter_config(con, "repo")
    max_strikes = int(obter_config(con, "max_strikes", "2") or 2)
    nome_esteira = slugify(obter_config(con, "name") or "esteira", 16)
    con.close()

    print(f"{C['b']}laço autônomo{C['r']}  {C['d']}intervalo {interval}s · "
          f"Ctrl-C para parar{C['r']}")
    idle = 0
    while True:
        moveu = False

        with transacao(caminho) as con:
            achados = vigiar_prs(con, github_repo)
        for a in achados:
            if a["desfecho"] == "pronto":
                print(_concluir_merge(caminho, repo, nome_esteira, a))
                moveu = True
            elif a["desfecho"] == "em_progresso":
                print(_relancar_retrabalho(caminho, github_repo, repo, a))
                moveu = True
            elif a["desfecho"] == "bloqueado":
                print(f"  {C['red']}✗{C['r']} {a['chave']}: {a.get('motivo', 'bloqueada')}")
                moveu = True
            elif a["desfecho"] == "falhou":
                print(f"  {C['red']}!{C['r']} {a['chave']}: vigia falhou — {a['detalhe']}")

        with transacao(caminho) as con:
            recolhidas = recolher_sessoes_mortas(con, max_strikes)
        for r in recolhidas:
            moveu = True
            print(f"  {r['chave']}: {r['desfecho']}")
            if r["desfecho"] == "quarentena" and r.get("worktree"):
                wt = Path(r["worktree"])
                falhas_td = encerramento_fixo(wt)
                if not falhas_td and wt.exists() and repo:
                    subprocess.run(["git", "-C", repo, "worktree", "remove",
                                    "--force", str(wt)], capture_output=True)

        con = abrir_banco(caminho)
        for linha in _preencher_vaga(con, caminho):
            print(linha)
            moveu = True
        vivo = _trabalho_vivo(con)
        con.close()

        print(f"{time.strftime('%H:%M:%S')}  "
              + (f"{C['d']}sem mudança{C['r']}" if not moveu else "seguindo"))

        idle = 0 if (moveu or vivo) else idle + 1
        if idle >= IDLE_CICLOS_PARA_PARAR:
            con = abrir_banco(caminho)
            concluida = _esteira_concluida(con)
            con.close()
            if concluida:
                print(f"\n{C['grn']}esteira sem trabalho pendente — laço encerrado.{C['r']}")
                tipo, texto = "esteira_concluida", "nada pendente — todas as unidades prontas"
            else:
                print(f"\n{C['yel']}{idle} ciclos sem nada vivo e sem nada avançar — "
                     f"laço parado. Veja `orq board`.{C['r']}")
                tipo, texto = "laco_parou", f"{idle} ciclos ociosos"
            with transacao(caminho) as con:
                registrar_evento(con, None, tipo, texto=texto)
            return
        time.sleep(interval)


def cmd_attach(cfg, args):
    con = abrir_banco(Path(args.db))
    uid = _resolver_unidade_id(con, args.chave)
    row = con.execute(
        "SELECT tmux FROM sessao WHERE unidade_id = ? AND encerrada_em IS NULL "
        "ORDER BY id DESC LIMIT 1", (uid,)).fetchone()
    con.close()
    if not row or not row["tmux"]:
        die(f"{args.chave} não tem sessão tmux viva.")
    if not has_tmux():
        die("tmux ausente.")
    os.execvp("tmux", ["tmux", "attach", "-t", row["tmux"]])


def cmd_log(cfg, args):
    con = abrir_banco(Path(args.db))
    uid = _resolver_unidade_id(con, args.chave)
    nome_esteira = slugify(obter_config(con, "name") or "esteira", 16)
    con.close()
    lf = STATE / f"{nome_esteira}-{uid}.log"
    if not lf.exists():
        die(f"sem log para {args.chave}.")
    os.execvp("tail", ["tail", "-f", str(lf)] if args.follow
              else ["tail", "-n", "200", str(lf)])


def cmd_stop(cfg, args):
    caminho = Path(args.db)
    con = abrir_banco(caminho)
    uid = _resolver_unidade_id(con, args.chave)
    if not sessao_viva(con, uid):
        die(f"{args.chave} não tem sessão viva.")
    row = con.execute(
        "SELECT tmux, pid FROM sessao WHERE unidade_id = ? AND encerrada_em IS NULL "
        "ORDER BY id DESC LIMIT 1", (uid,)).fetchone()
    nome_esteira = slugify(obter_config(con, "name") or "esteira", 16)
    con.close()
    if row["tmux"]:
        subprocess.run(["tmux", "kill-session", "-t", row["tmux"]], check=False)
    elif row["pid"]:
        try:
            os.kill(int(row["pid"]), 15)
        except Exception:
            pass
    with transacao(caminho) as con2:
        uid2 = _resolver_unidade_id(con2, args.chave)
        encerrar_sessao(con2, uid2, "stopped")
    if args.archive:
        dest = arquivar_artefatos(nome_esteira, uid, args.chave, "stopped")
        print(f"{C['d']}  artefatos em {dest}{C['r']}")
    print(f"{C['grn']}✓{C['r']} sessão de {args.chave} encerrada; status não muda. "
         f"Worktree e branch continuam.")


def git_dir_comum(cwd=None):
    """O `.git` do repositório PRINCIPAL, visto de onde você está.

    De dentro de uma worktree isto devolve o `.git` do repositório que a criou —
    que é justamente o que a esteira declara em `repo`. Comparar o cwd reprovaria
    toda worktree, isto é, TODA sessão da esteira.

    Devolve None fora de qualquer repositório: `orq status` do diretório pessoal
    é uso legítimo e não há com o que comparar.
    """
    base = Path(cwd or Path.cwd())
    r = subprocess.run(["git", "rev-parse", "--git-common-dir"],
                       cwd=str(base), capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return None
    saida = Path(r.stdout.strip())
    return saida if saida.is_absolute() else (base / saida).resolve()


def divergencia_de_maquina(repo_declarado, git_dir_atual):
    """O `repo` declarado (no banco, ou de onde quer que venha) é o repositório
    onde você está agora? Senão, o motivo.

    Usada por `resolver_banco` (OA-03) para só considerar, na descoberta
    automática, bancos desta máquina — nunca o banco de outro épico ou de
    outra máquina, mesmo que ele esteja alcançável por caminho. Herdada do
    antigo resolvedor de `pipeline.toml`, que tinha o mesmo problema: em
    04/09/2026, num Mac, uma worktree carregava o `pipeline.toml` de uma
    esteira que roda numa VPS, e sem esta checagem a resolução implícita
    escolhia a esteira ERRADA e seguia calada.

    A comparação é TEXTUAL de propósito: ela precisa dar o mesmo veredito nas
    duas máquinas lendo o MESMO valor declarado. Numa delas o caminho pode nem
    existir; tocar o disco faria a checagem depender de qual máquina pergunta,
    que é exatamente o que ela existe para detectar.
    """
    if git_dir_atual is None:
        return None
    declarado = Path(repo_declarado).expanduser()
    if Path(git_dir_atual) == declarado / ".git":
        return None
    return (f"esta esteira governa `{declarado}`, mas você está em "
            f"`{Path(git_dir_atual).parent}`.\n"
            f"  O caminho declarado não muda sozinho com a máquina — se isto é "
            f"esperado,\n  aponte o banco explicitamente:\n"
            f"    export ORQ_DB=<caminho do banco desta máquina>\n"
            f"  ou `orq --db <caminho> ...`")


# ---------------------------------------------------------------- host
#
# O que a MÁQUINA aguenta, sem depender de esteira nenhuma — `orq host` segue
# funcionando mesmo sem nenhum banco existir. O orçamento por SESSÃO
# (quantas cabem ao mesmo tempo) é diferente: dependia de `ram_per_stage_gb`
# no pipeline.toml (removido em OA-04) e volta como `orq capacity` quando
# OA-05 tiver um lançador de verdade para orçar.

CGROUP = Path("/sys/fs/cgroup")


def _cg_valor(texto: str):
    """Número de um arquivo de cgroup. 'max' quer dizer SEM teto, não infinito."""
    t = (texto or "").strip()
    if not t or t == "max":
        return None
    try:
        return float(t)
    except ValueError:
        return None


def _cg_evento(texto: str, chave: str) -> int:
    """memory.events é uma linha 'chave valor' por evento."""
    for linha in (texto or "").splitlines():
        p = linha.split()
        if len(p) == 2 and p[0] == chave:
            try:
                return int(p[1])
            except ValueError:
                return 0
    return 0


def _pressao_livre_pct(saida: str):
    m = re.search(r"free percentage:\s*(\d+)%", saida or "")
    return int(m.group(1)) if m else None


def fatia_do_usuario():
    """A fatia systemd desta sessão de usuário, quando existe cgroup v2."""
    p = CGROUP / "user.slice" / f"user-{os.getuid()}.slice"
    return p if (p / "memory.current").exists() else None


def host_memoria() -> dict:
    """O que LIMITA esta máquina agora, e por quê.

    Em Linux com systemd o teto que importa é o da fatia do usuário, não o da
    máquina. Em 02/09/2026 a fatia estava em 12,7 GB de 18, com o swap dela 100%
    cheio e 1.104.943 freadas por memória, enquanto /proc/meminfo anunciava 16 GB
    disponíveis. Despachar por esse número teria enfiado mais sessões dentro de
    uma fatia que já sufocava.
    """
    def ler(p):
        try:
            return p.read_text()
        except Exception:
            return ""

    fatia = fatia_do_usuario()
    if fatia:
        usado = _cg_valor(ler(fatia / "memory.current")) or 0.0
        teto = _cg_valor(ler(fatia / "memory.max"))
        sw_usado = _cg_valor(ler(fatia / "memory.swap.current")) or 0.0
        sw_teto = _cg_valor(ler(fatia / "memory.swap.max"))
        eventos = ler(fatia / "memory.events")
        if teto:
            g = 1024 ** 3
            return {"fonte": f"fatia {fatia.name}",
                    "disponivel_gb": max(0.0, (teto - usado) / g),
                    "teto_gb": teto / g,
                    "usado_gb": usado / g,
                    "swap_pct": round(sw_usado * 100 / sw_teto) if sw_teto else 0,
                    "freadas": _cg_evento(eventos, "high"),
                    "oom": _cg_evento(eventos, "oom_kill")}

    if sys.platform == "darwin":
        try:
            saida = subprocess.run(["memory_pressure"], capture_output=True,
                                   text=True, timeout=5).stdout
            pct = _pressao_livre_pct(saida)
            if pct is not None:
                total = total_ram_gb()
                return {"fonte": "pressão de memória da Apple",
                        "disponivel_gb": total * pct / 100, "teto_gb": total,
                        "usado_gb": total * (100 - pct) / 100,
                        "swap_pct": 0, "freadas": 0, "oom": 0}
        except Exception:
            pass

    total = total_ram_gb()
    disp = -1.0
    try:
        for linha in Path("/proc/meminfo").read_text().splitlines():
            if linha.startswith("MemAvailable:"):
                disp = int(linha.split()[1]) / 1024 ** 2
    except Exception:
        pass
    return {"fonte": "máquina inteira", "disponivel_gb": disp, "teto_gb": total,
            "usado_gb": max(0.0, total - disp), "swap_pct": 0,
            "freadas": 0, "oom": 0}


def total_ram_gb() -> float:
    try:
        if sys.platform == "darwin":
            return int(subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True,
                                      text=True, timeout=5).stdout.strip()) / 1024 ** 3
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) / 1024 ** 2
    except Exception:
        pass
    return 0.0


def available_ram_gb() -> float:
    """Memória recuperável do que LIMITA esta máquina. Ver host_memoria()."""
    return host_memoria()["disponivel_gb"]


# ---------------------------------------------------------------- sessões

def has_tmux() -> bool:
    return shutil.which("tmux") is not None


# ---------------------------------------------------------------- comandos

def cmd_host(cfg, args):
    """Relatório do que limita a máquina, e alerta quando aperta.

    Não precisa de esteira nenhuma: serve para decidir se esta máquina aguenta
    uma, e para diagnosticar quando ela para de aguentar. Os limiares são de
    infraestrutura (tuning), não regra de negócio.
    """
    h = host_memoria()
    lim_swap = int(os.environ.get("ORQ_SWAP_PCT", 70))
    lim_mem = int(os.environ.get("ORQ_MEM_PCT", 80))
    usado_pct = round(h["usado_gb"] * 100 / h["teto_gb"]) if h["teto_gb"] else 0

    alertas = []
    if h["swap_pct"] >= lim_swap:
        alertas.append(f"swap em {h['swap_pct']}% do teto — daqui em diante cada "
                       f"sessão nova entra em disputa por página")
    if usado_pct >= lim_mem:
        alertas.append(f"memória em {usado_pct}% do teto")
    if h["oom"]:
        alertas.append(f"o núcleo já matou {h['oom']} processo(s) por falta de memória")

    if args.json:
        print(json.dumps({**h, "usado_pct": usado_pct, "alertas": alertas},
                         indent=2, ensure_ascii=False))
        sys.exit(1 if alertas else 0)
    if args.check:
        for a in alertas:
            print(f"  • {a}")
        sys.exit(1 if alertas else 0)

    print(f"Fonte: {h['fonte']}")
    print(f"Uso:   {h['usado_gb']:.1f} GB de {h['teto_gb']:.1f} GB ({usado_pct}%)"
          f" · disponível {h['disponivel_gb']:.1f} GB")
    if h["freadas"]:
        print(f"Freadas por excesso de memória: {h['freadas']} · "
              f"mortes por falta: {h['oom']}")
    if h["swap_pct"]:
        print(f"Swap:  {h['swap_pct']}% do teto")
    for a in alertas:
        print(f"\nATENÇÃO: {a}")
    sys.exit(1 if alertas else 0)


# ---------------------------------------------------------------- pré-voo (OA-12)
#
# `orq doctor` some por inteiro em OA-04 (dependia do motor TOML/ClickUp) e
# volta aqui, reescrito: cada prova por CHAMADA REAL, nunca por declaração —
# é a lição nº 1 da casa (docs/aprendizados.md:10): o pré-voo antigo dava
# verde perguntando `claude auth status`, que responde `loggedIn: true` só
# por existir uma variável de ambiente, e cada sessão morria em dois
# segundos. A prova de ClickUp SAI daqui (fica em `orq-clickup doctor`): o
# motor não depende mais dele para funcionar, e um pré-voo que falha por uma
# ferramenta de gestão fora do ar impediria despacho sem necessidade.

REDE_FS = {"nfs", "nfs4", "cifs", "smb", "smbfs", "afp", "9p", "fuse.sshfs"}


def _prova(fn):
    """Roda uma prova e nunca deixa uma exceção matar o pré-voo inteiro — a
    evidência é o que a chamada devolveu DE VERDADE, ou o erro que ela
    levantou, nunca a palavra 'ok' (aprendizado nº 1)."""
    try:
        ok, evidencia = fn()
        return ok, str(evidencia or "").strip()[:200]
    except Exception as e:
        return False, str(e).strip()[:200]


def _tipo_sistema_arquivos(caminho: Path) -> str | None:
    """O tipo do sistema de arquivos que contém `caminho` — via `mount`, que
    existe em macOS e Linux, com formatos de saída diferentes:
      macOS:  /dev/disk3s5 on / (apfs, local, journaled)
      Linux:  /dev/sda1 on / type ext4 (rw,relatime)
    `None` quando não dá para saber — a prova trata isso como "não provado
    rede", nunca como "provado local"."""
    alvo = str(caminho.resolve())
    try:
        saida = subprocess.run(["mount"], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return None
    melhor = None
    for linha in saida.splitlines():
        m = re.match(r"^\S+ on (\S+) (?:type (\S+) )?\(([^)]*)\)", linha)
        if not m:
            continue
        ponto = m.group(1)
        if not alvo.startswith(ponto):
            continue
        if melhor is None or len(ponto) > len(melhor[0]):
            tipo = m.group(2) or m.group(3).split(",")[0].strip()
            melhor = (ponto, tipo)
    return melhor[1] if melhor else None


def _prova_banco_desta_maquina(con: sqlite3.Connection) -> tuple:
    row = con.execute("SELECT versao FROM esquema").fetchone()
    repo_declarado = obter_config(con, "repo")
    if not repo_declarado:
        return False, "config 'repo' não declarada."
    motivo = divergencia_de_maquina(repo_declarado, git_dir_comum())
    if motivo:
        return False, motivo.splitlines()[0]
    return True, f"esquema v{row['versao']}, repo={repo_declarado}"


def _prova_wal_e_disco_local(con: sqlite3.Connection, caminho: Path) -> tuple:
    modo = con.execute("PRAGMA journal_mode").fetchone()[0]
    if str(modo).lower() != "wal":
        return False, f"journal_mode = {modo}, esperado 'wal'."
    tipo = _tipo_sistema_arquivos(caminho)
    if tipo and tipo.lower() in REDE_FS:
        return False, (f"banco em sistema de arquivos de rede ({tipo}) — WAL não é "
                       f"seguro com múltiplos escritores num volume de rede.")
    return True, f"wal · {tipo or 'tipo de disco não identificado'}"


def _prova_fila(caminho: Path) -> tuple:
    """Dois escritores concorrentes numa unidade reservada (`__doctor__`):
    prova que `BEGIN IMMEDIATE` + `busy_timeout` (OA-01) enfileira em vez de
    perder escrita. A unidade é removida ao fim, aconteça o que acontecer."""
    chave = "__doctor__"
    with transacao(caminho) as con:
        row = con.execute("SELECT strikes FROM unidade WHERE chave = ?", (chave,)).fetchone()
        if row is None:
            criar_unidade(con, chave, clickup_id=None, titulo="prova de fila (orq doctor)")
            base = 0
        else:
            base = row["strikes"]
    try:
        resultados = {}

        def escrever(nome):
            try:
                inicio = time.monotonic()
                with transacao(caminho) as con:
                    atual = con.execute(
                        "SELECT strikes FROM unidade WHERE chave = ?", (chave,)).fetchone()
                    time.sleep(0.2)
                    con.execute("UPDATE unidade SET strikes = ? WHERE chave = ?",
                               (atual["strikes"] + 1, chave))
                resultados[nome] = (inicio, time.monotonic())
            except Exception as e:
                resultados[nome] = e

        t1 = threading.Thread(target=escrever, args=("a",))
        t2 = threading.Thread(target=escrever, args=("b",))
        t1.start()
        time.sleep(0.05)   # garante que 'b' tenta começar ENQUANTO 'a' está dentro
        t2.start()
        t1.join(timeout=15)
        t2.join(timeout=15)

        if set(resultados) != {"a", "b"}:
            return False, "um dos dois escritores não terminou a tempo (15s)."
        for nome, r in resultados.items():
            if isinstance(r, Exception):
                return False, f"escritor '{nome}' falhou: {r}"
        (i1, f1), (i2, f2) = resultados["a"], resultados["b"]
        sobrepoe = i1 < f2 and i2 < f1
        con = abrir_banco(caminho)
        final = con.execute(
            "SELECT strikes FROM unidade WHERE chave = ?", (chave,)).fetchone()["strikes"]
        con.close()
        if final != base + 2:
            return False, f"escrita perdida: esperava {base + 2}, achei {final}."
        if not sobrepoe:
            return False, "os dois escritores não chegaram a se sobrepor no tempo."
        return True, f"dois escritores concorrentes, {final - base} incrementos, nenhum perdido"
    finally:
        with transacao(caminho) as con:
            con.execute("DELETE FROM unidade WHERE chave = ?", (chave,))


def _prova_validate(caminho: Path) -> tuple:
    con = abrir_banco(caminho)
    problemas = _validar(con)
    con.close()
    if problemas:
        return False, "; ".join(problemas)[:200]
    return True, "esteira coerente"


def _contagem_e_limite_de_processos() -> tuple:
    """Quantos processos este usuário tem, e o teto — para dizer 'a máquina
    não cria mais processo' com o NÚMERO, não só a suspeita (aprendizado
    nº 23)."""
    n = -1
    try:
        saida = subprocess.run(["ps", "-u", str(os.getuid()), "-o", "pid="],
                               capture_output=True, text=True, timeout=5).stdout
        n = len([l for l in saida.splitlines() if l.strip()])
    except Exception:
        pass
    limite = None
    try:
        if sys.platform == "darwin":
            limite = int(subprocess.run(["sysctl", "-n", "kern.maxprocperuid"],
                                        capture_output=True, text=True, timeout=5).stdout.strip())
        else:
            import resource
            limite = resource.getrlimit(resource.RLIMIT_NPROC)[0]
    except Exception:
        pass
    return n, limite


def _prova_agente(timeout: int = 45) -> tuple:
    """`claude -p "responda apenas: ok"` — a única prova que confirma login
    de verdade (aprendizado nº 1). Antes de concluir 'sem login', confirma
    que a MÁQUINA ainda cria processo: com fork falhando, esta e qualquer
    outra checagem que executa algo devolveria o erro da última coisa que
    ia rodar, com o diagnóstico errado (aprendizado nº 23)."""
    try:
        subprocess.run(["true"], timeout=5)
    except OSError as e:
        n, limite = _contagem_e_limite_de_processos()
        return False, (f"a máquina não consegue mais criar processo ({e}) — "
                       f"{n} processos de {limite if limite is not None else '?'} de teto. "
                       f"NÃO é falta de login.")
    if not shutil.which("claude"):
        return False, "`claude` não está na PATH."
    try:
        r = subprocess.run(["claude", "-p", "responda apenas: ok"],
                           capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, f"`claude -p` não respondeu em {timeout}s."
    except OSError as e:
        n, limite = _contagem_e_limite_de_processos()
        return False, (f"a máquina não consegue mais criar processo ({e}) — "
                       f"{n} processos de {limite if limite is not None else '?'} de teto. "
                       f"NÃO é falta de login.")
    saida = (r.stdout or "").strip()
    if r.returncode != 0 or "ok" not in saida.lower():
        return False, (f"não respondeu 'ok' (saída: {saida[:120]!r}, código {r.returncode}) "
                       f"— rode `claude auth login`.")
    return True, f"respondeu {saida[:60]!r}"


def _prova_gh(github_repo: str | None) -> tuple:
    if not shutil.which("gh"):
        return False, "`gh` não está na PATH — `brew install gh` ou equivalente."
    r = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True, timeout=20)
    if r.returncode != 0:
        return False, f"`gh auth login` — {(r.stderr or r.stdout).strip()[:160]}"
    if not github_repo:
        return True, "autenticado (github_repo não declarado — pulei o pr list)."
    r2 = subprocess.run(["gh", "pr", "list", "--repo", github_repo, "--limit", "1"],
                        capture_output=True, text=True, timeout=20)
    if r2.returncode != 0:
        return False, f"`gh pr list --repo {github_repo}` falhou: {r2.stderr.strip()[:160]}"
    return True, f"autenticado, {github_repo} acessível."


def _prova_git_credencial(repo: str, base: str) -> tuple:
    r = subprocess.run(["git", "-C", repo, "ls-remote", "--exit-code", "origin", base],
                       capture_output=True, text=True, timeout=30,
                       env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
    if r.returncode != 0:
        return False, ("sem credencial não interativa para o remoto — "
                       "`ssh-add --apple-use-keychain` ou `gh auth setup-git`.")
    partes = r.stdout.split()
    return True, f"origin/{base} → {partes[0][:12] if partes else 'ok'}"


def _prova_tmux() -> tuple:
    if not has_tmux():
        return False, "tmux não está na PATH — o lançador (OA-05) exige >= 3.2."
    versao_txt = subprocess.run(["tmux", "-V"], capture_output=True,
                                text=True, timeout=10).stdout.strip()
    m = re.search(r"(\d+)\.(\d+)", versao_txt)
    if not m:
        return False, f"não consegui ler a versão: {versao_txt!r}"
    if (int(m.group(1)), int(m.group(2))) < (3, 2):
        return False, f"{versao_txt} — o lançador exige >= 3.2 (a opção -e)."
    return True, versao_txt


def cerca_impressao() -> str | None:
    """Um SHA256 curto do arquivo — não prova que o CONTEÚDO está certo, só
    que ninguém trocou o arquivo por baixo sem ninguém perceber. Registrado
    a cada `orq doctor` para dar o que comparar depois."""
    if not CERCA.exists():
        return None
    return hashlib.sha256(CERCA.read_bytes()).hexdigest()[:12]


def _prova_cerca() -> tuple:
    if not (CERCA.exists() and os.access(CERCA, os.X_OK)):
        return False, f"sumiu ou não é executável: {CERCA}"
    script = ORQ_REPO / "testes" / "cerca.sh"
    if not script.exists():
        return False, f"impressão {cerca_impressao()} · testes/cerca.sh sumiu, não pude provar"
    r = subprocess.run(["bash", str(script)], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        ultima = (r.stdout + r.stderr).strip().splitlines()
        return False, f"testes/cerca.sh falhou: {ultima[-1][:160] if ultima else '(sem saída)'}"
    return True, f"impressão {cerca_impressao()} · testes/cerca.sh verde"


def _prova_confianca(repo: str) -> tuple:
    try:
        d = json.loads(CLAUDE_JSON.read_text())
    except Exception as e:
        return False, f"não consegui ler {CLAUDE_JSON}: {e}"
    chave = str(Path(repo).expanduser())
    confiavel = bool(d.get("projects", {}).get(chave, {}).get("hasTrustDialogAccepted"))
    if not confiavel:
        return False, f"abra uma vez e aceite: cd {repo} && claude"
    return True, "worktrees herdam a confiança do repositório base"


def _prova_worktree_fora(repo: str, worktree_root: str) -> tuple:
    try:
        Path(worktree_root).expanduser().resolve().relative_to(Path(repo).expanduser().resolve())
        return False, f"'{worktree_root}' está DENTRO do repositório."
    except ValueError:
        return True, worktree_root


def _prova_telegram() -> tuple:
    try:
        r = subprocess.run([_entregador_avisos(), "--testar"],
                           capture_output=True, text=True, timeout=30)
    except Exception as e:
        return False, str(e)[:200]
    saida = ((r.stdout or "") + (r.stderr or "")).strip()
    linhas = saida.splitlines()
    if r.returncode != 0 or "ok:" not in saida:
        return False, linhas[-1][:160] if linhas else "sem credencial configurada."
    return True, linhas[-1][:160]


def _prova_capacidade(con: sqlite3.Connection) -> tuple:
    cap = capacidade(con)
    return (cap["slots_free"] > 0,
           f"RAM livre {cap['free_ram_gb']}GB · vagas {cap['slots_free']} · "
           f"load {cap['load1']}")


def cmd_doctor(cfg, args):
    """O pré-voo — cada prova por chamada real, nunca por declaração
    (aprendizado nº 1). `--rapido` pula as duas mais caras (agente, fila)
    e AVISA que pulou, nunca finge que passaram (Riscos do spec)."""
    caminho = Path(args.db)
    con = abrir_banco(caminho)
    repo = obter_config(con, "repo")
    base = obter_config(con, "base_branch") or "main"
    worktree_root = obter_config(con, "worktree_root")
    github_repo = obter_config(con, "github_repo")
    con.close()

    tudo_ok = True

    def marcar(rotulo, ok, evidencia, *, fatal=True):
        nonlocal tudo_ok
        if ok:
            simbolo = f"{C['grn']}✓{C['r']}"
        elif not fatal:
            simbolo = f"{C['yel']}!{C['r']}"
        else:
            simbolo = f"{C['red']}✗{C['r']}"
        print(f" {simbolo} {rotulo:<38} {C['d']}{evidencia}{C['r']}")
        if not ok and fatal:
            tudo_ok = False

    print(f"{C['b']}Pré-voo{C['r']}")

    con = abrir_banco(caminho)
    marcar("banco abre e é desta máquina", *_prova(lambda: _prova_banco_desta_maquina(con)))
    marcar("WAL ativo e disco local", *_prova(lambda: _prova_wal_e_disco_local(con, caminho)))
    con.close()

    if args.rapido:
        marcar("a fila funciona (concorrência)", True,
              "pulado por --rapido — NÃO é prova", fatal=False)
    else:
        marcar("a fila funciona (concorrência)", *_prova(lambda: _prova_fila(caminho)))

    marcar("declaração coerente (orq validate)", *_prova(lambda: _prova_validate(caminho)))

    if args.rapido:
        marcar("o agente responde", True, "pulado por --rapido — NÃO é prova", fatal=False)
    else:
        marcar("o agente responde (chamada real)", *_prova(_prova_agente))

    marcar("gh na PATH e autenticado", *_prova(lambda: _prova_gh(github_repo)))

    if repo:
        marcar("git com credencial não interativa", *_prova(lambda: _prova_git_credencial(repo, base)))
        marcar("confiança de pasta herdável", *_prova(lambda: _prova_confianca(repo)))
    else:
        marcar("git com credencial não interativa", False, "config 'repo' não declarada.")
        marcar("confiança de pasta herdável", False, "config 'repo' não declarada.")

    marcar("tmux >= 3.2", *_prova(_prova_tmux))
    marcar("cerca presente e íntegra", *_prova(_prova_cerca))

    if repo and worktree_root:
        marcar("worktree root fora do repo", *_prova(lambda: _prova_worktree_fora(repo, worktree_root)))
    else:
        marcar("worktree root fora do repo", False, "'repo'/'worktree_root' não declarados.")

    marcar("telegram entrega", *_prova(_prova_telegram), fatal=False)

    con = abrir_banco(caminho)
    marcar("capacidade", *_prova(lambda: _prova_capacidade(con)), fatal=False)
    con.close()

    print()
    if tudo_ok:
        print(f"{C['grn']}{C['b']}PRONTO{C['r']}")
    else:
        print(f"{C['red']}{C['b']}NÃO PRONTO{C['r']}")
    sys.exit(0 if tudo_ok else 1)


def main():
    p = argparse.ArgumentParser(prog="orq",
                                description="Orquestrador de esteiras — despacha agentes "
                                            "auto-contidos por unidade de trabalho.")
    p.add_argument("--db", help="caminho do banco SQLite da esteira (ou $ORQ_DB). Sem "
                               "isto, resolvido pelo repositório onde você está, ou "
                               "pelo último banco usado — ver `resolver_banco`.")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help, banco=False, banco_explicito=False):
        s = sub.add_parser(name, help=help)
        # `banco=True`: verbo que lê/escreve o banco SQLite (OA-01), resolvido
        # por `resolver_banco` (explícito ou não). `banco_explicito=True` (só
        # `init`) desliga a resolução automática: não há o que descobrir antes
        # de o banco existir.
        s.set_defaults(fn=fn, banco=banco, banco_explicito=banco_explicito)
        return s

    # ---- OA-02: verbos de declaração.
    s = add("init", cmd_init, "cria o banco de uma esteira nova",
            banco=True, banco_explicito=True)
    s.add_argument("--nome", help="nome da esteira (padrão: o nome do arquivo do banco)")
    s.add_argument("--repo", required=True, help="raiz do repositório git")
    s.add_argument("--base", required=True, help="branch de publicação (ex.: main)")
    s.add_argument("--worktrees", required=True,
                   help="raiz das worktrees, FORA do repositório")
    s.add_argument("--lista", help="id da lista no ClickUp")
    s.add_argument("--github", help="owner/repo no GitHub, para o vigia de PR (OA-08)")
    s.add_argument("--forcar", action="store_true", help="recria o banco do zero")

    s_task = sub.add_parser("task", help="declara, remove ou altera uma unidade")
    sub_task = s_task.add_subparsers(dest="subcmd", required=True)
    st = sub_task.add_parser("add", help="declara uma unidade nova")
    st.add_argument("chave"); st.add_argument("--clickup", required=True,
                                              help="id da tarefa no ClickUp")
    st.add_argument("--titulo", required=True)
    st.add_argument("--prioridade", default="normal",
                    help="urgente | alta | normal | baixa | sem (padrão: normal)")
    st.add_argument("--modo", default="autonomous", help="autonomous | hands-on")
    st.add_argument("--forcar", action="store_true",
                    help="sobrescreve uma unidade já declarada com valores diferentes")
    st.set_defaults(fn=cmd_task_add, banco=True)
    st = sub_task.add_parser("rm", help="remove uma unidade")
    st.add_argument("chave")
    st.add_argument("--forcar", action="store_true", help="confirma a remoção")
    st.set_defaults(fn=cmd_task_rm, banco=True)
    st = sub_task.add_parser("set", help="altera título, prioridade ou modo")
    st.add_argument("chave")
    st.add_argument("--titulo"); st.add_argument("--prioridade"); st.add_argument("--modo")
    st.set_defaults(fn=cmd_task_set, banco=True)

    s_dep = sub.add_parser("dep", help="declara ou remove dependência entre unidades")
    sub_dep = s_dep.add_subparsers(dest="subcmd", required=True)
    sd = sub_dep.add_parser("add", help="unidade passa a depender de outra(s)")
    sd.add_argument("chave")
    sd.add_argument("--precisa", action="append", required=True, metavar="CHAVE",
                    help="pode repetir para declarar mais de uma dependência")
    sd.set_defaults(fn=cmd_dep_add, banco=True)
    sd = sub_dep.add_parser("rm", help="remove dependência(s)")
    sd.add_argument("chave")
    sd.add_argument("--precisa", action="append", required=True, metavar="CHAVE")
    sd.set_defaults(fn=cmd_dep_rm, banco=True)

    s_cfg = sub.add_parser("config", help="lê ou altera a configuração da esteira")
    sub_cfg = s_cfg.add_subparsers(dest="subcmd", required=True)
    sc = sub_cfg.add_parser("set", help="define uma chave de configuração")
    sc.add_argument("chave"); sc.add_argument("valor")
    sc.set_defaults(fn=cmd_config_set, banco=True)
    sc = sub_cfg.add_parser("get", help="lê uma chave de configuração")
    sc.add_argument("chave")
    sc.set_defaults(fn=cmd_config_get, banco=True)
    sc = sub_cfg.add_parser("list", help="lista toda a configuração")
    sc.set_defaults(fn=cmd_config_list, banco=True)

    s = add("export", cmd_export, "emite o estado inteiro em texto estável",
            banco=True)
    s.add_argument("--formato", choices=["toml", "json"], default="toml")

    add("validate", cmd_validate, "recusa esteira incoerente, sem escrever nada",
        banco=True)

    # ---- OA-03: máquina de cinco estados.
    s = add("board", cmd_board, "quadro: o que está pronto, travado, rodando, bloqueado",
            banco=True)
    s = add("next", cmd_next, "fila priorizada do que pode começar agora",
            banco=True)
    s.add_argument("-n", type=int, default=0)
    s = add("status", cmd_status, "o que está vivo e o que pede decisão",
            banco=True)
    s = add("show", cmd_show, "detalhes da unidade: status, dependências, PR, eventos",
            banco=True)
    s.add_argument("chave")
    s = add("advance", cmd_advance,
            "PR aberto → 'revisão' (--pr) · revisão fundida fora do fluxo → 'pronto' (--forcar)",
            banco=True)
    s.add_argument("chave")
    s.add_argument("--pr", metavar="NUMERO|URL",
                   help="número ou URL do PR — obrigatório sem --forcar")
    s.add_argument("--forcar", action="store_true",
                   help="fecha uma unidade em 'revisao' cujo PR foi fundido fora do "
                        "fluxo automático (squash local, merge na mão)")
    s = add("hold", cmd_hold, "marca a unidade como bloqueada por decisão humana",
            banco=True)
    s.add_argument("chave"); s.add_argument("--motivo", required=True)
    s = add("release", cmd_release, "libera uma unidade bloqueada — volta para a fila",
            banco=True)
    s.add_argument("chave")
    s.add_argument("--zerar-retrabalho", action="store_true", dest="zerar_retrabalho",
                   help="zera o contador de retrabalho (OA-09) — a pessoa corrigiu o requisito")
    s = add("reopen", cmd_reopen,
            "reabre uma unidade 'pronto' — único jeito de sair de um estado terminal",
            banco=True)
    s.add_argument("chave")
    s.add_argument("--forcar", action="store_true", help="obrigatório — confirma a reabertura")
    s = add("tick", cmd_tick,
            "vigia PR (OA-08) e recolhe sessão morta — isto NÃO despacha", banco=True)

    # ---- OA-05: o lançador de verdade — worktree, briefing único, tmux/
    # processo, encerramento sem lançador (hold/advance já arquivam e matam a
    # sessão com delicadeza).
    s = add("run", cmd_run, "lança a sessão de uma unidade pronta", banco=True)
    s.add_argument("chave")
    s.add_argument("--attach", action="store_true", help="entra na sessão já lançada")
    s.add_argument("--force", action="store_true",
                   help="ignora status/dependência/vaga — decisão sua, não da esteira")
    s = add("dispatch", cmd_dispatch, "lança as N prontas de maior prioridade",
            banco=True)
    s.add_argument("-n", type=int, default=0)
    s.add_argument("-y", "--yes", action="store_true")
    add("capacity", cmd_capacity, "vagas livres para lançar sessão agora", banco=True)
    s = add("loop", cmd_loop,
            "laço autônomo: vigia PR, recolhe sessão morta, preenche vaga (OA-08)",
            banco=True)
    s.add_argument("--interval", type=int, default=None,
                   help="segundos entre ciclos — sobrepõe interval_seconds (padrão 60)")
    s = add("attach", cmd_attach, "entra na sessão (tmux) de uma unidade", banco=True)
    s.add_argument("chave")
    s = add("log", cmd_log, "lê o log da sessão de uma unidade", banco=True)
    s.add_argument("chave"); s.add_argument("-f", "--follow", action="store_true")
    s = add("stop", cmd_stop, "encerra a sessão sem mudar o status", banco=True)
    s.add_argument("chave")
    s.add_argument("--archive", action="store_true", help="também arquiva os artefatos")

    # ---- máquina — não depende de esteira nenhuma.
    s = add("host", cmd_host, "o que limita esta máquina agora (dispensa esteira)")
    s.add_argument("--json", action="store_true")
    s.add_argument("--check", action="store_true",
                   help="só alerta; sai com 1 quando há alerta")

    s = add("doctor", cmd_doctor,
            "pré-voo: cada prova por chamada real, nunca por declaração (OA-12)",
            banco=True)
    s.add_argument("--rapido", action="store_true",
                   help="pula as duas provas mais caras (agente, fila) — avisa, não finge")

    args = p.parse_args()
    if getattr(args, "banco", False):
        if getattr(args, "banco_explicito", False):
            # `init`: o banco ainda não existe — não há o que `resolver_banco`
            # descobrir, e ele MORRERIA ao conferir que o arquivo existe.
            if not args.db:
                die("--db é obrigatório para criar um banco novo — não há o que "
                    "descobrir antes de ele existir.")
            args.db = str(Path(args.db).expanduser())
        else:
            args.db = str(resolver_banco(args.db))
    STATE.mkdir(parents=True, exist_ok=True)
    args.fn(None, args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
