#!/usr/bin/env python3
"""O medidor da esteira.

A esteira deixa rastro farto em oito lugares que não conversam entre si. Este
programa os lê e responde, por unidade de trabalho, quanto tempo levou, quantas
vezes voltou, quanto esperou por uma pessoa, quantos tokens consumiu e quanto
código produziu.

Ele SÓ LÊ. Escreve exclusivamente no próprio armazém, nunca no estado da esteira,
e nunca toca em sessão que ainda está em curso.

Desenho: docs/especificacoes/2026-09-02-medicao-desenho.md
"""
import argparse
import datetime
import json
import os
import pathlib
import re
import sqlite3
import subprocess
import sys
import tomllib
import unicodedata
import urllib.error
import urllib.request

ARMAZEM_PADRAO = pathlib.Path.home() / ".claude/orchestrator/state/medicao.db"

# --------------------------------------------------------------------------- #
# O esquema
# --------------------------------------------------------------------------- #

DDL = """
CREATE TABLE IF NOT EXISTS maquina (
  id    INTEGER PRIMARY KEY,
  nome  TEXT NOT NULL UNIQUE,
  papel TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS esteira (
  id             INTEGER PRIMARY KEY,
  nome           TEXT NOT NULL UNIQUE,
  projeto        TEXT,
  arquivo_config TEXT
);

CREATE TABLE IF NOT EXISTS unidade (
  id         INTEGER PRIMARY KEY,
  esteira_id INTEGER NOT NULL REFERENCES esteira(id),
  codigo     TEXT NOT NULL,
  tarefa     TEXT NOT NULL,
  titulo     TEXT,
  branch     TEXT,
  UNIQUE (esteira_id, codigo)
);

CREATE TABLE IF NOT EXISTS sessao (
  id              INTEGER PRIMARY KEY,
  unidade_id      INTEGER NOT NULL REFERENCES unidade(id),
  maquina_id      INTEGER NOT NULL REFERENCES maquina(id),
  etapa           TEXT NOT NULL,
  inicio          TEXT,
  inicio_deduzido INTEGER NOT NULL DEFAULT 0,
  fim             TEXT,
  fim_deduzido    INTEGER NOT NULL DEFAULT 0,
  desfecho        TEXT,
  desfecho_bruto  TEXT,
  status_final    TEXT,
  pasta           TEXT,
  chave           TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS consumo (
  id                   INTEGER PRIMARY KEY,
  sessao_id            INTEGER REFERENCES sessao(id),
  unidade_id           INTEGER REFERENCES unidade(id),
  transcricao          TEXT NOT NULL,
  modelo               TEXT NOT NULL,
  mensagens            INTEGER NOT NULL,
  tokens_entrada       INTEGER NOT NULL,
  tokens_saida         INTEGER NOT NULL,
  tokens_cache_leitura INTEGER NOT NULL,
  tokens_cache_escrita INTEGER NOT NULL,
  primeiro_ts          TEXT,
  ultimo_ts            TEXT,
  UNIQUE (transcricao, modelo)
);

CREATE TABLE IF NOT EXISTS evento (
  id         INTEGER PRIMARY KEY,
  unidade_id INTEGER REFERENCES unidade(id),
  sessao_id  INTEGER REFERENCES sessao(id),
  maquina_id INTEGER REFERENCES maquina(id),
  ts         TEXT,
  origem     TEXT NOT NULL,
  tipo       TEXT NOT NULL,
  autor      TEXT,
  texto      TEXT,
  chave      TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS commit_unidade (
  sha        TEXT PRIMARY KEY,
  unidade_id INTEGER REFERENCES unidade(id),
  ts         TEXT NOT NULL,
  arquivos   INTEGER,
  insercoes  INTEGER,
  delecoes   INTEGER,
  mensagem   TEXT
);

-- Nasce vazia de propósito. Preço é regra de negócio: enquanto ninguém a
-- preencher, custo em dinheiro é desconhecido, jamais um número inventado.
CREATE TABLE IF NOT EXISTS preco_modelo (
  modelo                   TEXT NOT NULL,
  vigencia_inicio          TEXT NOT NULL,
  moeda                    TEXT NOT NULL,
  entrada_por_milhao       REAL NOT NULL,
  saida_por_milhao         REAL NOT NULL,
  cache_leitura_por_milhao REAL NOT NULL,
  cache_escrita_por_milhao REAL NOT NULL,
  PRIMARY KEY (modelo, vigencia_inicio)
);

CREATE INDEX IF NOT EXISTS idx_sessao_unidade ON sessao(unidade_id);
CREATE INDEX IF NOT EXISTS idx_evento_unidade ON evento(unidade_id);
CREATE INDEX IF NOT EXISTS idx_evento_ts      ON evento(ts);

CREATE TABLE IF NOT EXISTS amostra_memoria (
  id         INTEGER PRIMARY KEY,
  ts         TEXT NOT NULL,
  unidade_id INTEGER REFERENCES unidade(id),
  tarefa     TEXT,
  etapa      TEXT,
  rss_mb     REAL NOT NULL,
  chave      TEXT NOT NULL UNIQUE
);

CREATE VIEW IF NOT EXISTS v_ciclo_por_unidade AS
SELECT u.codigo, u.tarefa, u.titulo,
       min(s.inicio) AS comeco, max(s.fim) AS termino,
       count(*) AS sessoes,
       sum(CASE WHEN s.inicio_deduzido = 1 THEN 1 ELSE 0 END) AS sessoes_deduzidas,
       round((julianday(max(s.fim)) - julianday(min(s.inicio))) * 24, 2) AS horas
  FROM unidade u JOIN sessao s ON s.unidade_id = u.id
 GROUP BY u.id;

CREATE VIEW IF NOT EXISTS v_retrabalho AS
SELECT u.codigo, u.titulo,
       sum(CASE WHEN s.desfecho = 'reprovou'  THEN 1 ELSE 0 END) AS reprovacoes,
       sum(CASE WHEN s.desfecho = 'orfa'      THEN 1 ELSE 0 END) AS orfas,
       sum(CASE WHEN s.desfecho = 'reiniciou' THEN 1 ELSE 0 END) AS reinicios,
       sum(CASE WHEN s.desfecho = 'travou'    THEN 1 ELSE 0 END) AS travadas
  FROM unidade u JOIN sessao s ON s.unidade_id = u.id
 GROUP BY u.id;

CREATE VIEW IF NOT EXISTS v_espera_humana AS
SELECT u.codigo, u.titulo, e.ts, e.texto
  FROM evento e JOIN unidade u ON u.id = e.unidade_id
 WHERE e.tipo = 'espera_humana';

CREATE VIEW IF NOT EXISTS v_consumo_por_unidade AS
SELECT u.codigo, u.titulo, c.modelo,
       sum(c.mensagens) AS mensagens,
       sum(c.tokens_entrada) AS entrada, sum(c.tokens_saida) AS saida,
       sum(c.tokens_cache_leitura) AS cache_lido,
       sum(c.tokens_cache_escrita) AS cache_escrito
  FROM unidade u JOIN consumo c ON c.unidade_id = u.id
 GROUP BY u.id, c.modelo;

CREATE VIEW IF NOT EXISTS v_producao_por_unidade AS
SELECT u.codigo, u.titulo, count(*) AS commits,
       sum(k.arquivos) AS arquivos, sum(k.insercoes) AS insercoes,
       sum(k.delecoes) AS delecoes
  FROM unidade u JOIN commit_unidade k ON k.unidade_id = u.id
 GROUP BY u.id;

-- Memoria por etapa so existe daqui para a frente: o rastro antigo nao guarda
-- consumo por sessao, e nenhum esforco recupera o que nunca foi escrito.
CREATE VIEW IF NOT EXISTS v_memoria_por_etapa AS
SELECT COALESCE(etapa, '(sem etapa)') AS etapa,
       count(*)                    AS amostras,
       count(DISTINCT tarefa)      AS unidades,
       round(avg(rss_mb), 0)       AS media_mb,
       round(max(rss_mb), 0)       AS maior_mb
  FROM amostra_memoria
 GROUP BY COALESCE(etapa, '(sem etapa)');

CREATE VIEW IF NOT EXISTS v_sessao AS
SELECT s.id, u.codigo AS unidade, u.tarefa, u.titulo, m.nome AS maquina,
       s.etapa, s.inicio, s.fim, s.inicio_deduzido, s.desfecho, s.desfecho_bruto,
       s.status_final, s.pasta,
       round((julianday(s.fim) - julianday(s.inicio)) * 1440, 1) AS minutos,
       (SELECT round((julianday(max(c.ultimo_ts)) - julianday(min(c.primeiro_ts)))
                     * 1440, 1)
          FROM consumo c WHERE c.sessao_id = s.id)          AS minutos_transcricao,
       (SELECT sum(c.mensagens)            FROM consumo c WHERE c.sessao_id = s.id) AS mensagens,
       (SELECT sum(c.tokens_saida)         FROM consumo c WHERE c.sessao_id = s.id) AS tokens_saida,
       (SELECT sum(c.tokens_entrada)       FROM consumo c WHERE c.sessao_id = s.id) AS tokens_entrada,
       (SELECT sum(c.tokens_cache_leitura) FROM consumo c WHERE c.sessao_id = s.id) AS cache_lido,
       (SELECT sum(c.tokens_cache_escrita) FROM consumo c WHERE c.sessao_id = s.id) AS cache_escrito
  FROM sessao s
  JOIN unidade u ON u.id = s.unidade_id
  JOIN maquina m ON m.id = s.maquina_id;

-- Só sessão com início MEDIDO entra: misturar deduzido com medido produziria
-- uma média que ninguém pode defender.
CREATE VIEW IF NOT EXISTS v_tempo_por_etapa AS
SELECT etapa,
       count(*)                 AS sessoes,
       round(avg(minutos), 1)   AS media_min,
       round(min(minutos), 1)   AS menor_min,
       round(max(minutos), 1)   AS maior_min,
       round(sum(minutos), 1)   AS total_min
  FROM v_sessao
 WHERE minutos IS NOT NULL AND inicio_deduzido = 0
 GROUP BY etapa;

CREATE VIEW IF NOT EXISTS v_consumo_por_etapa AS
SELECT s.etapa,
       count(DISTINCT s.id)          AS sessoes,
       sum(c.mensagens)              AS mensagens,
       sum(c.tokens_saida)           AS tokens_saida,
       sum(c.tokens_entrada)         AS tokens_entrada,
       sum(c.tokens_cache_leitura)   AS cache_lido,
       sum(c.tokens_cache_escrita)   AS cache_escrito
  FROM sessao s JOIN consumo c ON c.sessao_id = s.id
 GROUP BY s.etapa;
"""


def abrir(caminho=ARMAZEM_PADRAO):
    """Abre o armazém, criando o esquema se faltar. Seguro repetir."""
    caminho = pathlib.Path(caminho)
    caminho.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(caminho)
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA foreign_keys = ON")
    con.executescript(DDL)
    con.commit()
    return con


# --------------------------------------------------------------------------- #
# Identidade
# --------------------------------------------------------------------------- #

def chave_sessao(maquina, esteira, unidade, etapa, carimbo):
    """A identidade de uma sessão.

    É campo próprio, e não combinação de colunas, porque sessão recolhida sem
    despacho não tem início — e coluna vazia não conta como repetida na
    comparação do banco, o que faria cada coleta criar uma linha nova para a
    mesma sessão, inflando a contagem sem ninguém notar.
    """
    partes = [str(p or "") for p in (maquina, esteira, unidade, etapa, carimbo)]
    if not any(partes):
        raise ValueError("chave de sessão não pode ser vazia")
    return "|".join(partes)


def chave_evento(maquina, origem, tipo, ts, alvo):
    partes = [str(p or "") for p in (maquina, origem, tipo, ts, alvo)]
    return "|".join(partes)


# --------------------------------------------------------------------------- #
# As sessões
# --------------------------------------------------------------------------- #

# Ordem importa: "loop-reset:1" tem de casar com "loop-reset" antes de chegar
# perto de "reset", que significa outra coisa.
DESFECHOS = (
    ("advanced:", "avancou"),
    ("rejected->", "reprovou"),
    ("loop-reset", "orfa"),
    ("release-requeue", "retomada"),
    ("hold", "travou"),
    ("reset", "reiniciou"),
)


def normalizar_desfecho(bruto):
    """Traduz o desfecho gravado pelo motor.

    Devolve None para o que não conhece. Desfecho novo tem de aparecer como
    desconhecido e ser investigado, nunca ser encaixado no balde mais parecido.
    """
    if not bruto:
        return None
    # A varredura nao e um desfecho: e a rede de seguranca que arquiva o
    # artefato de uma sessao que terminou sem chamar o encerramento. O que vale
    # e o estado em que a unidade estava na hora.
    if bruto.startswith("sweep:"):
        estado = bruto.split(":", 1)[1]
        if estado == "stalled":
            return "orfa"
        if estado in ("done", "ready"):
            return "recolhida"
        return None
    for prefixo, nome in DESFECHOS:
        if bruto.startswith(prefixo):
            return nome
    return None


def sessoes_arquivadas(raiz):
    """Lê as pastas de sessão já arquivadas. Elas são a autoridade sobre desfecho.

    O carimbo no nome da pasta é hora LOCAL de arquivamento; o campo archived_at
    é a mesma hora em UTC, e é ele que vale.
    """
    raiz = pathlib.Path(raiz)
    fora = []
    if not raiz.exists():
        return fora
    for meta in sorted(raiz.glob("*/*/meta.json")):
        try:
            d = json.loads(meta.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        bruto = d.get("outcome")
        fora.append({
            "esteira": d.get("pipeline"),
            "unidade": d.get("unit"),
            "tarefa": d.get("id"),
            "etapa": d.get("stage"),
            "fim": d.get("archived_at"),
            "fim_deduzido": False,
            "desfecho": normalizar_desfecho(bruto),
            "desfecho_bruto": bruto,
            "status_final": d.get("status_final"),
            "pasta": str(meta.parent),
        })
    return fora


def despachos(caminho):
    """Lê o registro de despachos. Ele diz que a sessão nasceu, não como morreu."""
    caminho = pathlib.Path(caminho)
    fora = []
    if not caminho.exists():
        return fora
    for linha in caminho.read_text(errors="replace").splitlines():
        linha = linha.strip()
        if not linha:
            continue
        try:
            fora.append(json.loads(linha))
        except json.JSONDecodeError:
            continue
    return fora


def casar(sessoes, lista_despachos):
    """Casa cada sessão arquivada com o despacho que a originou.

    A mesma unidade repete a mesma etapa — uma delas teve quatro implementações
    — então o casamento é cronológico dentro do grupo (esteira, unidade, etapa)
    e cada despacho serve a uma sessão só.

    Sobra dos dois lados é registrada, não descartada: sessão sem despacho fica
    com início deduzido e marcado; despacho sem sessão vira sessão que nasceu e
    cujo fim não foi registrado. Rastro incompleto é informação sobre a esteira.
    """
    def grupo_sessao(s):
        return (s.get("esteira"), s.get("unidade"), s.get("etapa"))

    def grupo_despacho(d):
        return (d.get("pipeline"), d.get("unit"), d.get("stage"))

    por_grupo = {}
    for d in lista_despachos:
        por_grupo.setdefault(grupo_despacho(d), []).append({"d": dict(d), "usado": False})
    for lista in por_grupo.values():
        lista.sort(key=lambda e: e["d"].get("ts") or "")

    fora = []
    for s in sorted(sessoes, key=lambda s: s.get("fim") or ""):
        s = dict(s)
        escolhido = None
        for e in por_grupo.get(grupo_sessao(s), []):
            ts = e["d"].get("ts") or ""
            if e["usado"] or not ts or ts > (s.get("fim") or ""):
                continue
            escolhido = e                      # o mais recente ainda livre
        if escolhido is not None:
            escolhido["usado"] = True
            s["inicio"] = escolhido["d"].get("ts")
            s["inicio_deduzido"] = False
            s["branch"] = escolhido["d"].get("branch")
            if not s.get("tarefa"):
                s["tarefa"] = escolhido["d"].get("id")
        else:
            s["inicio"] = s.get("fim")
            s["inicio_deduzido"] = True
            s.setdefault("branch", None)
        fora.append(s)

    for lista in por_grupo.values():
        for e in lista:
            if e["usado"]:
                continue
            d = e["d"]
            fora.append({
                "esteira": d.get("pipeline"), "unidade": d.get("unit"),
                "tarefa": d.get("id"), "etapa": d.get("stage"),
                "branch": d.get("branch"),
                "inicio": d.get("ts"), "inicio_deduzido": False,
                "fim": None, "fim_deduzido": False,
                "desfecho": None, "desfecho_bruto": None,
                "status_final": None, "pasta": None,
            })
    return fora


# --------------------------------------------------------------------------- #
# Gravação
# --------------------------------------------------------------------------- #

def _id_maquina(con, nome, papel):
    con.execute("INSERT OR IGNORE INTO maquina (nome, papel) VALUES (?,?)", (nome, papel))
    return con.execute("SELECT id FROM maquina WHERE nome=?", (nome,)).fetchone()[0]


def _id_esteira(con, nome):
    con.execute("INSERT OR IGNORE INTO esteira (nome) VALUES (?)", (nome,))
    return con.execute("SELECT id FROM esteira WHERE nome=?", (nome,)).fetchone()[0]


def _id_unidade(con, esteira_id, codigo, tarefa, branch=None):
    con.execute(
        "INSERT INTO unidade (esteira_id, codigo, tarefa, branch) VALUES (?,?,?,?) "
        "ON CONFLICT (esteira_id, codigo) DO UPDATE SET "
        "  tarefa = COALESCE(excluded.tarefa, unidade.tarefa), "
        "  branch = COALESCE(excluded.branch, unidade.branch)",
        (esteira_id, codigo, tarefa, branch))
    return con.execute("SELECT id FROM unidade WHERE esteira_id=? AND codigo=?",
                       (esteira_id, codigo)).fetchone()[0]


def gravar_sessoes(con, maquina, papel, sessoes):
    """Grava por acréscimo com substituição. Repetir não duplica."""
    maquina_id = _id_maquina(con, maquina, papel)
    n = 0
    for s in sessoes:
        if not (s.get("esteira") and s.get("unidade") and s.get("etapa")):
            continue
        esteira_id = _id_esteira(con, s["esteira"])
        unidade_id = _id_unidade(con, esteira_id, s["unidade"], s.get("tarefa"),
                                 s.get("branch"))
        carimbo = s.get("fim") or s.get("inicio")
        chave = chave_sessao(maquina, s["esteira"], s["unidade"], s["etapa"], carimbo)
        con.execute(
            "INSERT INTO sessao (unidade_id, maquina_id, etapa, inicio, inicio_deduzido,"
            " fim, fim_deduzido, desfecho, desfecho_bruto, status_final, pasta, chave)"
            " VALUES (?,?,?,?,?,?,?,?,?,?,?,?)"
            " ON CONFLICT (chave) DO UPDATE SET"
            "  inicio=excluded.inicio, inicio_deduzido=excluded.inicio_deduzido,"
            "  fim=excluded.fim, fim_deduzido=excluded.fim_deduzido,"
            "  desfecho=excluded.desfecho, desfecho_bruto=excluded.desfecho_bruto,"
            "  status_final=excluded.status_final, pasta=excluded.pasta",
            (unidade_id, maquina_id, s["etapa"], s.get("inicio"),
             1 if s.get("inicio_deduzido") else 0, s.get("fim"),
             1 if s.get("fim_deduzido") else 0, s.get("desfecho"),
             s.get("desfecho_bruto"), s.get("status_final"), s.get("pasta"), chave))
        n += 1
    con.commit()
    return n


# --------------------------------------------------------------------------- #
# O consumo
# --------------------------------------------------------------------------- #

RE_TAREFA = re.compile(r"^CU-([0-9A-Za-z]+)-")


def tarefa_do_branch(branch):
    """O id da tarefa mora no nome do branch que a esteira criou."""
    if not branch:
        return None
    m = RE_TAREFA.match(str(branch))
    return m.group(1) if m else None


def _iso(ts):
    """Carimbo em ISO 8601 UTC, sem fração de segundo, sempre terminando em Z."""
    if not ts:
        return None
    ts = str(ts)
    if "." in ts:
        return ts.split(".", 1)[0] + "Z"
    if ts.endswith("+00:00"):
        return ts[:-6] + "Z"
    return ts if ts.endswith("Z") else ts + "Z"


def consumo_de_transcricao(caminho):
    """Soma tokens por modelo numa transcrição.

    Linha que não decodifica é pulada em silêncio: transcrição de sessão que
    morreu no meio termina numa linha partida, e deixar isso derrubar a leitura
    perderia a sessão inteira sem ninguém perceber.
    """
    caminho = pathlib.Path(caminho)
    por_modelo = {}
    tarefa = None
    try:
        texto = caminho.read_text(errors="replace")
    except OSError:
        return []
    for linha in texto.splitlines():
        linha = linha.strip()
        if not linha:
            continue
        try:
            d = json.loads(linha)
        except json.JSONDecodeError:
            continue
        if not tarefa:
            tarefa = (tarefa_do_branch(d.get("gitBranch"))
                      or tarefa_do_branch(pathlib.Path(d.get("cwd") or "").name))
        m = d.get("message") or {}
        u = m.get("usage")
        if not u:
            continue
        modelo = m.get("model") or "(desconhecido)"
        c = por_modelo.setdefault(modelo, {
            "transcricao": str(caminho), "modelo": modelo, "mensagens": 0,
            "tokens_entrada": 0, "tokens_saida": 0,
            "tokens_cache_leitura": 0, "tokens_cache_escrita": 0,
            "primeiro_ts": None, "ultimo_ts": None, "tarefa": None,
        })
        c["mensagens"] += 1
        c["tokens_entrada"] += u.get("input_tokens") or 0
        c["tokens_saida"] += u.get("output_tokens") or 0
        c["tokens_cache_leitura"] += u.get("cache_read_input_tokens") or 0
        c["tokens_cache_escrita"] += u.get("cache_creation_input_tokens") or 0
        ts = _iso(d.get("timestamp"))
        if ts:
            if not c["primeiro_ts"] or ts < c["primeiro_ts"]:
                c["primeiro_ts"] = ts
            if not c["ultimo_ts"] or ts > c["ultimo_ts"]:
                c["ultimo_ts"] = ts
    for c in por_modelo.values():
        c["tarefa"] = tarefa
    return list(por_modelo.values())


def sessao_da_janela(sessoes, ts):
    """A sessão cuja janela de tempo contém o carimbo.

    Sessão sem fim registrado fica de fora: sem fronteira de cima ela engoliria
    qualquer coisa posterior, inclusive de outra corrida.
    """
    if not ts:
        return None
    for s in sessoes:
        inicio, fim = s.get("inicio"), s.get("fim")
        if not inicio or not fim:
            continue
        if inicio <= ts <= fim:
            return s
    return None


def gravar_consumo(con, linhas):
    """Liga cada transcrição à unidade e, quando a janela permite, à sessão."""
    n = 0
    for c in linhas:
        if not c.get("tarefa"):
            continue
        u = con.execute("SELECT id FROM unidade WHERE tarefa=?", (c["tarefa"],)).fetchone()
        if not u:
            continue
        unidade_id = u[0]
        sessoes = [dict(r) for r in con.execute(
            "SELECT id, inicio, fim FROM sessao WHERE unidade_id=?", (unidade_id,))]
        alvo = sessao_da_janela(sessoes, c.get("primeiro_ts"))
        con.execute(
            "INSERT INTO consumo (sessao_id, unidade_id, transcricao, modelo, mensagens,"
            " tokens_entrada, tokens_saida, tokens_cache_leitura, tokens_cache_escrita,"
            " primeiro_ts, ultimo_ts) VALUES (?,?,?,?,?,?,?,?,?,?,?)"
            " ON CONFLICT (transcricao, modelo) DO UPDATE SET"
            "  sessao_id=excluded.sessao_id, unidade_id=excluded.unidade_id,"
            "  mensagens=excluded.mensagens, tokens_entrada=excluded.tokens_entrada,"
            "  tokens_saida=excluded.tokens_saida,"
            "  tokens_cache_leitura=excluded.tokens_cache_leitura,"
            "  tokens_cache_escrita=excluded.tokens_cache_escrita,"
            "  primeiro_ts=excluded.primeiro_ts, ultimo_ts=excluded.ultimo_ts",
            (alvo["id"] if alvo else None, unidade_id, c["transcricao"], c["modelo"],
             c["mensagens"], c["tokens_entrada"], c["tokens_saida"],
             c["tokens_cache_leitura"], c["tokens_cache_escrita"],
             c.get("primeiro_ts"), c.get("ultimo_ts")))
        n += 1
    con.commit()
    return n


def transcricoes(raiz):
    """As transcrições das cópias de trabalho da esteira, e só elas."""
    raiz = pathlib.Path(raiz)
    if not raiz.exists():
        return []
    fora = []
    for pasta in sorted(raiz.glob("*worktrees-CU-*")):
        if pasta.is_dir():
            fora.extend(sorted(pasta.rglob("*.jsonl")))
    return fora


# As duas fontes de rastro: a máquina onde a esteira roda agora, e a história
# copiada da máquina anterior. Cada linha guarda de onde veio.
FONTES = (
    ("servidor", "corrente",
     pathlib.Path.home() / ".claude/orchestrator/state",
     pathlib.Path.home() / ".claude/projects"),
    ("historico-mac", "historico",
     pathlib.Path.home() / ".claude/orchestrator/historico-mac/state",
     pathlib.Path.home() / ".claude/orchestrator/historico-mac/projects"),
)


# --------------------------------------------------------------------------- #
# Os eventos
# --------------------------------------------------------------------------- #

def _chave(*partes):
    return "|".join(str(p or "") for p in partes)


def eventos_do_laco(estado, esteira, maquina):
    """Retrabalho, quarentena e espera humana, a partir do estado do laço.

    Retrabalho e quarentena são fatos SEM hora: o estado é uma fotografia, não um
    histórico. A hora fica vazia em vez de receber um carimbo inventado — e a
    identidade do evento não depende dela, para a próxima coleta atualizar a
    mesma linha em vez de criar outra.
    """
    fora = []
    for tarefa, n in (estado.get("rework") or {}).items():
        fora.append({"tarefa": tarefa, "ts": None, "origem": "laco",
                     "tipo": "retrabalho", "autor": None, "texto": str(n),
                     "chave": _chave(maquina, esteira, "laco", "retrabalho", tarefa)})
    for tarefa in (estado.get("quarantine") or []):
        fora.append({"tarefa": tarefa, "ts": None, "origem": "laco",
                     "tipo": "quarentena", "autor": None, "texto": None,
                     "chave": _chave(maquina, esteira, "laco", "quarentena", tarefa)})
    for tarefa, h in (estado.get("hold") or {}).items():
        ts = h.get("at")
        fora.append({"tarefa": tarefa, "ts": ts, "origem": "laco",
                     "tipo": "espera_humana", "autor": None,
                     "texto": h.get("reason"),
                     "chave": _chave(maquina, esteira, "laco", "espera_humana",
                                     tarefa, ts)})
    return fora


def eventos_de_gancho(texto, unidade, maquina):
    """Os ganchos que a sessão dispara: parou, pediu atenção."""
    fora = []
    for linha in (texto or "").splitlines():
        partes = linha.rstrip("\n").split("\t")
        if len(partes) < 2 or not partes[0].strip():
            continue
        ts, tipo = partes[0].strip(), partes[1].strip()
        corpo = "\t".join(partes[2:]).strip() or None
        fora.append({"unidade": unidade, "ts": ts, "origem": "gancho",
                     "tipo": tipo, "autor": None, "texto": corpo,
                     "chave": _chave(maquina, "gancho", unidade, ts, tipo)})
    return fora


def eventos_de_aviso(texto, maquina):
    """O registro de avisos entregues: hora, rótulo, assunto, mensagem."""
    fora = []
    for linha in (texto or "").splitlines():
        partes = linha.rstrip("\n").split("\t")
        if len(partes) < 2 or not partes[0].strip():
            continue
        ts = partes[0].strip()
        corpo = " · ".join(p.strip() for p in partes[1:] if p.strip()) or None
        fora.append({"unidade": None, "ts": ts, "origem": "aviso",
                     "tipo": "aviso", "autor": None, "texto": corpo,
                     "chave": _chave(maquina, "aviso", ts, corpo)})
    return fora


# Marcadores que a sessão escreve no começo do comentário. A ordem importa só
# para leitura; nenhum é prefixo do outro.
TRANSICOES = (
    ("INTEGRADO", "integrado"),
    ("REPROVADO", "reprovado"),
    ("APROVADO", "aprovado"),
    ("Spec publicada", "spec_publicada"),
    ("ENTREGUE", "entregue"),
    ("entregue no commit", "entregue"),
    ("RETRABALHO", "entregue"),
)

# Sete a quarenta hexadecimais COM ao menos um dígito. Sem essa exigência,
# palavras inteiramente formadas por a-f ("defaced") entram como commit.
RE_SHA = re.compile(r"\b(?=[0-9a-f]*[0-9])[0-9a-f]{7,40}\b")


def classificar_comentario(texto):
    cabeca = (texto or "")[:200]
    for marcador, tipo in TRANSICOES:
        if marcador in cabeca:
            return tipo
    return "comentario"


def eventos_de_comentarios(payload, tarefa, maquina):
    """Os comentários da tarefa são o relógio das transições.

    O tempo em cada status é recurso pago do ClickUp e responde TIS_027; os
    comentários dão a mesma linha do tempo de graça, e ainda dizem O QUE
    aconteceu e quem assinou.
    """
    fora = []
    for c in (payload or {}).get("comments", []):
        bruto = c.get("date")
        try:
            ts = (datetime.datetime.fromtimestamp(int(bruto) / 1000, datetime.UTC)
                  .strftime("%Y-%m-%dT%H:%M:%SZ"))
        except (TypeError, ValueError):
            ts = None
        texto = c.get("comment_text") or ""
        fora.append({
            "tarefa": tarefa, "ts": ts, "origem": "comentario",
            "tipo": classificar_comentario(texto),
            "autor": (c.get("user") or {}).get("username"),
            "texto": texto[:4000],
            "commits": sorted(set(RE_SHA.findall(texto))),
            "chave": _chave(maquina, "comentario", tarefa, c.get("id")),
        })
    return fora


def gravar_eventos(con, maquina, eventos):
    """Grava por chave natural. Repetir atualiza a mesma linha."""
    maquina_id = con.execute("SELECT id FROM maquina WHERE nome=?", (maquina,)).fetchone()
    maquina_id = maquina_id[0] if maquina_id else None
    n = 0
    for e in eventos:
        unidade_id = None
        if e.get("tarefa"):
            r = con.execute("SELECT id FROM unidade WHERE tarefa=?", (e["tarefa"],)).fetchone()
            unidade_id = r[0] if r else None
        elif e.get("unidade"):
            r = con.execute("SELECT id FROM unidade WHERE codigo=?", (e["unidade"],)).fetchone()
            unidade_id = r[0] if r else None
        con.execute(
            "INSERT INTO evento (unidade_id, maquina_id, ts, origem, tipo, autor, texto, chave)"
            " VALUES (?,?,?,?,?,?,?,?)"
            " ON CONFLICT (chave) DO UPDATE SET"
            "  unidade_id=excluded.unidade_id, ts=excluded.ts, autor=excluded.autor,"
            "  texto=excluded.texto",
            (unidade_id, maquina_id, e.get("ts"), e["origem"], e["tipo"],
             e.get("autor"), e.get("texto"), e["chave"]))
        n += 1
    con.commit()
    return n


def _git(repo, args, tempo=120):
    try:
        r = subprocess.run(["git", "-C", str(repo)] + args,
                           capture_output=True, text=True, timeout=tempo)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


RE_MERGE_PR = re.compile(r"Merge pull request #\d+ from [^/\s]+/(\S+)")
RE_MERGE_BR = re.compile(r"Merge branch '([^']+)'")


def branch_do_merge(assunto):
    """De qual branch veio o que este merge integrou.

    É daqui que sai a atribuição de commit a unidade. O intervalo base..branch
    NÃO serve: quando a base local está atrasada — e a do servidor estava 179
    commits atrás — ele devolve o trabalho de todas as unidades de uma vez, e a
    chave primária do commit deixa a atribuição com quem rodou por último. Uma
    unidade chegou a aparecer com 147 commits e 91 mil linhas que não eram dela.
    """
    if not assunto:
        return None
    for rx in (RE_MERGE_PR, RE_MERGE_BR):
        m = rx.search(assunto)
        if m and m.group(1).startswith("CU-"):
            return m.group(1)
    return None


def _commits_do_intervalo(repo, de, ate):
    saida = _git(repo, ["log", "--no-merges", "--format=%x01%H%x02%aI%x02%s",
                        "--numstat", f"{de}..{ate}"])
    fora, atual = [], None
    for linha in saida.splitlines():
        if linha.startswith("\x01"):
            if atual:
                fora.append(atual)
            partes = (linha[1:].split("\x02") + ["", ""])[:3]
            atual = {"sha": partes[0], "ts": _iso(partes[1]), "mensagem": partes[2],
                     "arquivos": 0, "insercoes": 0, "delecoes": 0}
            continue
        p = linha.split("\t")
        if atual and len(p) == 3 and p[0].isdigit() and p[1].isdigit():
            atual["arquivos"] += 1
            atual["insercoes"] += int(p[0])
            atual["delecoes"] += int(p[1])
    if atual:
        fora.append(atual)
    return fora


def ref_de_base(repo, base):
    """A base remota vence a local: a local envelhece sem avisar."""
    if _git(repo, ["rev-parse", "--verify", "--quiet", f"origin/{base}"]).strip():
        return f"origin/{base}"
    return base


def producao_por_merge(repo, ref):
    """Os commits de cada branch, pelo merge que a integrou."""
    fora = {}
    for linha in _git(repo, ["log", "--merges", "--format=%H%x02%s", ref]).splitlines():
        sha, _, assunto = linha.partition("\x02")
        branch = branch_do_merge(assunto)
        if not branch:
            continue
        fora.setdefault(branch, []).extend(
            _commits_do_intervalo(repo, f"{sha}^1", f"{sha}^2"))
    return fora


def branches_de_unidade(repo):
    saida = _git(repo, ["for-each-ref", "--format=%(refname:short)", "refs/heads/CU-*"])
    return [b.strip() for b in saida.splitlines() if b.strip()]


def commits_nao_integrados(repo, branch, ref):
    """O que a branch tem e a base ainda não. Vazio se já foi integrada."""
    base = _git(repo, ["merge-base", branch, ref]).strip()
    if not base:
        return []
    return _commits_do_intervalo(repo, base, branch)


def gravar_commits(con, unidade_id, commits):
    for c in commits:
        con.execute(
            "INSERT INTO commit_unidade (sha, unidade_id, ts, arquivos, insercoes,"
            " delecoes, mensagem) VALUES (?,?,?,?,?,?,?)"
            " ON CONFLICT (sha) DO UPDATE SET unidade_id=excluded.unidade_id,"
            "  arquivos=excluded.arquivos, insercoes=excluded.insercoes,"
            "  delecoes=excluded.delecoes",
            (c["sha"], unidade_id, c["ts"], c["arquivos"], c["insercoes"],
             c["delecoes"], c["mensagem"]))
    return len(commits)


def coletar_producao(con, repo, base):
    ref = ref_de_base(repo, base)
    por_branch = producao_por_merge(repo, ref)
    for b in branches_de_unidade(repo):
        if b not in por_branch:
            por_branch[b] = commits_nao_integrados(repo, b, ref)
    n = 0
    for branch, commits in por_branch.items():
        tarefa = tarefa_do_branch(branch)
        if not (tarefa and commits):
            continue
        r = con.execute("SELECT id FROM unidade WHERE tarefa=?", (tarefa,)).fetchone()
        if not r:
            continue
        con.execute("UPDATE unidade SET branch=COALESCE(branch,?) WHERE id=?",
                    (branch, r[0]))
        n += gravar_commits(con, r[0], commits)
    con.commit()
    return n


# --------------------------------------------------------------------------- #
# A esteira declarada
# --------------------------------------------------------------------------- #

def config_da_esteira(dados):
    """O que o arquivo da esteira diz sobre ela."""
    p = (dados or {}).get("pipeline") or {}
    return {"nome": p.get("name"), "repo": p.get("repo"),
            "base": p.get("base_branch"), "lista": p.get("list_id"),
            "worktrees": p.get("worktree_root"),
            "modelo_branch": p.get("branch_template")}


def unidades_do_toml(dados):
    """As unidades declaradas. Tarefa que está no quadro e não está aqui nunca
    foi executada pela esteira — e isso é proposital."""
    fora = []
    for t in (dados or {}).get("task") or []:
        if not t.get("key"):
            continue
        fora.append({"codigo": t.get("key"), "tarefa": t.get("id"),
                     "titulo": t.get("title"),
                     "depende_de": list(t.get("depends_on") or [])})
    return fora


def token_clickup():
    """A credencial vive fora de qualquer repositório. Dois nomes de chave
    circulam nas máquinas; aceitamos os dois em vez de quebrar por detalhe."""
    for caminho in (pathlib.Path.home() / ".config/orquestrador/credenciais.env",
                    pathlib.Path.home() / ".env.clickup"):
        if not caminho.exists():
            continue
        for linha in caminho.read_text().splitlines():
            linha = linha.strip()
            if not linha or linha.startswith("#") or "=" not in linha:
                continue
            chave, _, valor = linha.partition("=")
            if chave.strip() in ("CLICKUP_API_KEY", "api_token"):
                return valor.strip().strip("\"'")
    return None


def buscar_comentarios(tarefa, token, tempo=30):
    """Uma chamada por tarefa. É a única parte que usa rede."""
    req = urllib.request.Request(
        f"https://api.clickup.com/api/v2/task/{tarefa}/comment",
        headers={"Authorization": token})
    try:
        with urllib.request.urlopen(req, timeout=tempo) as r:
            return json.loads(r.read().decode())
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
        return None


# --------------------------------------------------------------------------- #
# Linha de comando
# --------------------------------------------------------------------------- #

def cmd_esquema(args):
    con = abrir(args.armazem)
    nomes = [r[0] for r in con.execute(
        "SELECT name FROM sqlite_master WHERE type IN ('table','view') ORDER BY name")]
    con.close()
    print(f"armazém pronto: {args.armazem}")
    print("tabelas e vistas: " + ", ".join(nomes))
    return 0


def _coletar_declaradas(con, raiz):
    """As unidades declaradas no arquivo da esteira dão o título de cada uma."""
    ponteiro = raiz / "last-pipeline"
    if not ponteiro.exists():
        return 0, None
    caminho = pathlib.Path(ponteiro.read_text().strip())
    if not caminho.exists():
        return 0, None
    try:
        dados = tomllib.loads(caminho.read_text())
    except (tomllib.TOMLDecodeError, OSError):
        return 0, None
    cfg = config_da_esteira(dados)
    if not cfg["nome"]:
        return 0, None
    esteira_id = _id_esteira(con, cfg["nome"])
    con.execute("UPDATE esteira SET projeto=?, arquivo_config=? WHERE id=?",
                (cfg["repo"], str(caminho), esteira_id))
    n = 0
    for u in unidades_do_toml(dados):
        con.execute(
            "INSERT INTO unidade (esteira_id, codigo, tarefa, titulo) VALUES (?,?,?,?)"
            " ON CONFLICT (esteira_id, codigo) DO UPDATE SET"
            "  tarefa = COALESCE(excluded.tarefa, unidade.tarefa),"
            "  titulo = COALESCE(excluded.titulo, unidade.titulo)",
            (esteira_id, u["codigo"], u["tarefa"], u["titulo"]))
        n += 1
    con.commit()
    return n, cfg


def cmd_coletar(args):
    con = abrir(args.armazem)
    total = 0
    for maquina, papel, raiz, raiz_projetos in FONTES:
        if not raiz.exists():
            print(f"{maquina}: sem rastro em {raiz} — pulando")
            continue

        arquivadas = sessoes_arquivadas(raiz / "archive")
        lista = despachos(raiz / "runs.jsonl")
        n = gravar_sessoes(con, maquina, papel, casar(arquivadas, lista))
        total += n
        print(f"{maquina}: {len(arquivadas)} arquivadas, {len(lista)} despachos, "
              f"{n} sessões")

        declaradas, cfg = _coletar_declaradas(con, raiz)
        if declaradas:
            print(f"{maquina}: {declaradas} unidades declaradas no arquivo da esteira")

        linhas = []
        arquivos = transcricoes(raiz_projetos)
        for a in arquivos:
            linhas.extend(consumo_de_transcricao(a))
        print(f"{maquina}: {len(arquivos)} transcrições, "
              f"{gravar_consumo(con, linhas)} linhas de consumo")

        eventos = []
        for laco in sorted((raiz).glob("loop-*.json")):
            try:
                eventos.extend(eventos_do_laco(json.loads(laco.read_text()),
                                               laco.stem, maquina))
            except (json.JSONDecodeError, OSError):
                continue
        for log in ("notify.log", "avisos.log"):
            alvo = raiz / log
            if alvo.exists():
                eventos.extend(eventos_de_aviso(alvo.read_text(errors="replace"), maquina))
        for ev in sorted((raiz / "archive").glob("*/*/*.events")):
            unidade = ev.stem.rsplit("-", 1)[0]
            eventos.extend(eventos_de_gancho(ev.read_text(errors="replace"),
                                             unidade, maquina))
        print(f"{maquina}: {gravar_eventos(con, maquina, eventos)} eventos internos")

        if cfg and cfg.get("repo") and pathlib.Path(cfg["repo"]).exists():
            k = coletar_producao(con, cfg["repo"], cfg.get("base") or "homol")
            print(f"{maquina}: {k} commits atribuídos a uma unidade")

    estado = estado_vivo(con, FONTES[0][2], _nome_da_esteira(con))
    n_mem = gravar_amostras(con, estado["sessoes"])
    print(f"vivo: {len(estado['sessoes'])} sessões rodando, {n_mem} amostras de memória, "
          f"{len(estado['esperas'])} esperando decisão")

    if not args.sem_rede:
        token = token_clickup()
        if not token:
            print("ClickUp: sem credencial — comentários não coletados")
        else:
            eventos, tarefas = [], [r[0] for r in con.execute(
                "SELECT DISTINCT tarefa FROM unidade WHERE tarefa IS NOT NULL")]
            faltou = 0
            for tarefa in tarefas:
                payload = buscar_comentarios(tarefa, token)
                if payload is None:
                    faltou += 1
                    continue
                eventos.extend(eventos_de_comentarios(payload, tarefa, "clickup"))
            _id_maquina(con, "clickup", "externa")
            print(f"ClickUp: {len(tarefas) - faltou}/{len(tarefas)} tarefas lidas, "
                  f"{gravar_eventos(con, 'clickup', eventos)} comentários")
            if faltou:
                print(f"ClickUp: {faltou} tarefas não responderam")

    con.close()
    print(f"total de sessões gravadas: {total}")
    return 0


def _milhar(n):
    return f"{n or 0:,}".replace(",", ".")


def cmd_resumo(args):
    con = abrir(args.armazem)
    print(f"sessões: {con.execute('SELECT count(*) FROM sessao').fetchone()[0]}")

    print("\npor desfecho:")
    for r in con.execute(
            "SELECT COALESCE(desfecho,'(sem desfecho registrado)') AS d, count(*) AS n"
            " FROM sessao GROUP BY d ORDER BY n DESC"):
        print(f"  {r['n']:4d}  {r['d']}")

    print("\npor etapa e desfecho:")
    for r in con.execute(
            "SELECT etapa, COALESCE(desfecho,'(sem desfecho)') AS d, count(*) AS n"
            " FROM sessao GROUP BY etapa, d ORDER BY etapa, n DESC"):
        print(f"  {r['n']:4d}  {r['etapa']:<12} {r['d']}")

    print("\ntokens por modelo:")
    for r in con.execute(
            "SELECT modelo, sum(mensagens) AS msg, sum(tokens_entrada) AS ent,"
            " sum(tokens_saida) AS sai, sum(tokens_cache_leitura) AS cl,"
            " sum(tokens_cache_escrita) AS ce FROM consumo GROUP BY modelo"
            " ORDER BY sai DESC"):
        print(f"  {r['modelo']}: mensagens {_milhar(r['msg'])} · "
              f"saída {_milhar(r['sai'])} · cache lido {_milhar(r['cl'])}")

    if not con.execute("SELECT count(*) FROM preco_modelo").fetchone()[0]:
        print("  custo em dinheiro: não calculado — nenhum preço cadastrado")

    print("\nprodução:")
    r = con.execute("SELECT count(*) AS c, sum(arquivos) AS a, sum(insercoes) AS i,"
                    " sum(delecoes) AS d FROM commit_unidade").fetchone()
    print(f"  {_milhar(r['c'])} commits · {_milhar(r['a'])} arquivos · "
          f"+{_milhar(r['i'])} / -{_milhar(r['d'])} linhas")

    print("\nesperando uma pessoa:")
    esperas = list(con.execute(
        "SELECT codigo, titulo, ts FROM v_espera_humana ORDER BY ts"))
    if not esperas:
        print("  nada")
    for e in esperas:
        print(f"  {e['codigo']:<7} {e['ts'] or '(sem hora)'}  "
              f"{(e['titulo'] or '')[:56]}")

    print("\nunidades com mais retrabalho:")
    for r in con.execute(
            "SELECT codigo, titulo, reprovacoes, travadas, orfas FROM v_retrabalho"
            " WHERE reprovacoes + orfas > 0 ORDER BY reprovacoes DESC, orfas DESC"
            " LIMIT 8"):
        print(f"  {r['codigo']:<7} {r['reprovacoes']} reprovações, "
              f"{r['orfas']} órfãs, {r['travadas']} travadas  "
              f"{(r['titulo'] or '')[:44]}")

    deduzidas = con.execute(
        "SELECT count(*) FROM sessao WHERE inicio_deduzido = 1").fetchone()[0]
    soltas = con.execute(
        "SELECT count(*) FROM consumo WHERE sessao_id IS NULL").fetchone()[0]
    if deduzidas or soltas:
        print("\navisos de qualidade do dado:")
        if deduzidas:
            print(f"  {deduzidas} sessões com início DEDUZIDO, não medido — não havia "
                  "despacho correspondente")
        if soltas:
            print(f"  {soltas} transcrições fora da janela de qualquer sessão; "
                  "ligadas só à unidade")

    print(f"\nunidades de trabalho: "
          f"{con.execute('SELECT count(*) FROM unidade').fetchone()[0]}")
    con.close()
    return 0


# --------------------------------------------------------------------------- #
# O que está vivo agora
# --------------------------------------------------------------------------- #
#
# Tudo aqui lê só a máquina local: as sessões do tmux e o estado do laço. Nada
# de rede, para o painel poder atualizar de segundo em segundo sem gastar
# chamada de API nem disputar nada com a esteira.

RE_BRIEF = re.compile(r"^[^/]*?-([0-9A-Za-z]+)-(spec|implement|review|integrate)\.brief\.md$")


def tarefa_da_sessao(nome, prefixo):
    """O id da tarefa mora no fim do nome da sessão. O laço tem nome próprio e
    não é uma sessão de trabalho — por isso a checagem contra 'loop-'."""
    if not nome or not nome.startswith(prefixo):
        return None
    resto = nome[len(prefixo):]
    return resto if resto and "-" not in resto else None


def etapa_do_brief(arquivos, tarefa):
    """A etapa não está no nome da sessão; está no da ordem de serviço."""
    for a in arquivos:
        m = RE_BRIEF.match(a)
        if m and m.group(1) == tarefa:
            return m.group(2)
    return None


def soma_rss_kb(saida):
    """`ps -o rss= -g <pid>` devolve uma linha por processo do grupo, em kB."""
    return sum(int(x) for x in (saida or "").split() if x.isdigit())


def chave_amostra(ts, tarefa):
    """Uma amostra por tarefa por minuto: coletar de novo no mesmo minuto
    atualiza a linha em vez de criar outra."""
    return f"{(ts or '')[:16]}|{tarefa or ''}"


def _tmux(args):
    try:
        r = subprocess.run(["tmux"] + args, capture_output=True, text=True, timeout=10)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def prefixo_da_esteira(nome, tamanho=16):
    """Espelha o que o motor faz para nomear a sessão."""
    s = unicodedata.normalize("NFKD", nome or "").encode("ascii", "ignore").decode()
    s = re.sub(r"[^a-zA-Z0-9]+", "-", s).strip("-").lower()
    return "orq-" + s[:tamanho].strip("-") + "-"


def sessoes_vivas(prefixo, raiz_estado):
    """As sessões de trabalho vivas agora, com a memória que cada uma ocupa."""
    arquivos = [p.name for p in pathlib.Path(raiz_estado).glob("*.brief.md")]
    fora = []
    for nome in _tmux(["list-sessions", "-F",
                       "#{session_name}\t#{session_created}"]).splitlines():
        partes = nome.split("\t")
        tarefa = tarefa_da_sessao(partes[0], prefixo)
        if not tarefa:
            continue
        rss = 0
        for pane in _tmux(["list-panes", "-t", partes[0], "-F", "#{pane_pid}"]).split():
            rss += soma_rss_kb(_tmux_ps(pane))
        criada = None
        if len(partes) > 1 and partes[1].isdigit():
            criada = datetime.datetime.fromtimestamp(
                int(partes[1]), datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
        fora.append({"tmux": partes[0], "tarefa": tarefa,
                     "etapa": etapa_do_brief(arquivos, tarefa),
                     "criada_em": criada, "rss_mb": round(rss / 1024, 1)})
    return fora


def _tmux_ps(pane_pid):
    try:
        r = subprocess.run(["ps", "-o", "rss=", "-g", pane_pid],
                           capture_output=True, text=True, timeout=10)
        return r.stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def gravar_amostras(con, vivas):
    """Grava a memória das sessões vivas.

    O motor sabe medir isto e não grava. Amostrar por fora é aditivo: não toca
    numa linha do motor, e a partir da primeira coleta passa a existir memória
    por etapa — que retroativamente nao existe e nunca vai existir.
    """
    agora = datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    n = 0
    for v in vivas:
        if not v.get("rss_mb"):
            continue
        r = con.execute("SELECT id FROM unidade WHERE tarefa=?", (v["tarefa"],)).fetchone()
        con.execute(
            "INSERT INTO amostra_memoria (ts, unidade_id, tarefa, etapa, rss_mb, chave)"
            " VALUES (?,?,?,?,?,?) ON CONFLICT (chave) DO UPDATE SET"
            "  rss_mb = max(amostra_memoria.rss_mb, excluded.rss_mb),"
            "  etapa = COALESCE(excluded.etapa, amostra_memoria.etapa)",
            (agora, r[0] if r else None, v["tarefa"], v.get("etapa"), v["rss_mb"],
             chave_amostra(agora, v["tarefa"])))
        n += 1
    con.commit()
    return n


def estado_vivo(con, raiz_estado, nome_esteira):
    """A fotografia do agora, para o painel. Só leitura local."""
    raiz = pathlib.Path(raiz_estado)
    vivas = sessoes_vivas(prefixo_da_esteira(nome_esteira), raiz)
    for v in vivas:
        r = con.execute("SELECT codigo, titulo FROM unidade WHERE tarefa=?",
                        (v["tarefa"],)).fetchone()
        v["unidade"] = r["codigo"] if r else v["tarefa"]
        v["titulo"] = r["titulo"] if r else None

    esperas, quarentena, ticks, despachos = [], [], None, None
    for laco in sorted(raiz.glob("loop-*.json")):
        try:
            d = json.loads(laco.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        ticks, despachos = d.get("ticks"), d.get("dispatched")
        for tarefa, h in (d.get("hold") or {}).items():
            r = con.execute("SELECT codigo, titulo FROM unidade WHERE tarefa=?",
                            (tarefa,)).fetchone()
            esperas.append({"tarefa": tarefa, "unidade": r["codigo"] if r else tarefa,
                            "titulo": r["titulo"] if r else None,
                            "desde": h.get("at"), "status": h.get("status"),
                            "motivo": (h.get("reason") or "")[:400]})
        quarentena += list(d.get("quarantine") or [])

    laco_vivo = any(l.startswith("orq-loop-")
                    for l in _tmux(["list-sessions", "-F", "#{session_name}"]).splitlines())
    return {
        "agora": datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "laco_rodando": laco_vivo,
        "sessoes": vivas,
        "esperas": sorted(esperas, key=lambda e: e.get("desde") or ""),
        "quarentena": quarentena,
        "ticks": ticks, "despachos": despachos,
    }


# --------------------------------------------------------------------------- #
# A exportação
# --------------------------------------------------------------------------- #

# O que este dado NÃO diz. Viaja junto com ele, sempre: número sem a ressalva
# vira decisão errada, e quem abre o arquivo daqui a seis meses não vai lembrar.
LIMITES = (
    "Memoria por sessao ou por etapa NAO existe. O motor sabe medir o consumo "
    "real de cada sessao viva, mas nao grava; o unico registro de memoria e da "
    "maquina inteira, com tres amostras de 02/09/2026.",
    "Duracao e DEDUZIDA, nao medida: e o intervalo entre o despacho e o "
    "arquivamento. As sessoes sem despacho correspondente vem com "
    "inicio_deduzido=1 e ficam fora das medias de tempo.",
    "Resultado de portao nao foi extraido: ele so existe dentro da captura de "
    "terminal, em texto corrido com codigos de cor.",
    "Custo em dinheiro nao e calculado enquanto a tabela preco_modelo estiver "
    "vazia. Tokens estao contados.",
    "Nada anterior a 31/08/2026 tem rastro: a esteira so passou a arquivar "
    "sessao a partir dali.",
    "Retrabalho e quarentena vem do estado do laco, que e uma fotografia do "
    "momento da coleta e nao um historico; por isso nao tem hora.",
)


def exportar(con):
    """Tudo o que o armazém sabe, em estruturas simples."""
    nomes = [r[0] for r in con.execute(
        "SELECT name FROM sqlite_master WHERE type IN ('table','view')"
        " AND name NOT LIKE 'sqlite_%' ORDER BY type DESC, name")]
    tabelas = {}
    for nome in nomes:
        tabelas[nome] = [dict(r) for r in con.execute(f"SELECT * FROM {nome}")]
    return {
        "gerado_em": datetime.datetime.now(datetime.UTC)
                     .strftime("%Y-%m-%dT%H:%M:%SZ"),
        "limites": list(LIMITES),
        "tabelas": tabelas,
    }


def cmd_exportar(args):
    con = abrir(args.armazem)
    dados = exportar(con)
    con.close()
    texto = json.dumps(dados, ensure_ascii=False, indent=2)
    if args.saida == "-":
        print(texto)
    else:
        alvo = pathlib.Path(args.saida)
        alvo.write_text(texto)
        tamanho = alvo.stat().st_size / 1024
        print(f"{alvo} — {tamanho:.0f} KB")
        for nome, linhas in dados["tabelas"].items():
            print(f"  {len(linhas):5d}  {nome}")
    return 0



# --------------------------------------------------------------------------- #
# O painel
# --------------------------------------------------------------------------- #

MODELO_PAINEL = pathlib.Path(__file__).resolve().parent.parent / "modelos" / "painel.html"


def dados_do_painel(con):
    """A forma achatada que a página consome. O texto do comentário vem
    aparado: o painel não precisa dele inteiro, e o bruto continua completo em
    `orq-medir exportar`."""
    def ler(nome):
        return [dict(r) for r in con.execute(f"SELECT * FROM {nome}")]

    eventos = ler("evento")
    for e in eventos:
        if e.get("texto") and len(e["texto"]) > 240:
            e["texto"] = e["texto"][:240] + "…"

    return {
        "gerado_em": datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "limites": list(LIMITES),
        "unidade": ler("unidade"), "maquina": ler("maquina"), "esteira": ler("esteira"),
        "sessao": ler("v_sessao"), "evento": eventos, "commit": ler("commit_unidade"),
        "consumo": ler("consumo"),
        "tempo_etapa": ler("v_tempo_por_etapa"), "consumo_etapa": ler("v_consumo_por_etapa"),
        "memoria": ler("v_memoria_por_etapa"),
        "retrabalho": ler("v_retrabalho"), "ciclo": ler("v_ciclo_por_unidade"),
        "producao": ler("v_producao_por_unidade"), "espera": ler("v_espera_humana"),
    }


def _nome_da_esteira(con):
    r = con.execute("SELECT nome FROM esteira ORDER BY id LIMIT 1").fetchone()
    return r[0] if r else ""


def cmd_painel(args):
    alvo = pathlib.Path(args.saida)
    alvo.mkdir(parents=True, exist_ok=True)
    if not MODELO_PAINEL.exists():
        print(f"modelo não encontrado: {MODELO_PAINEL}")
        return 1
    con = abrir(args.armazem)
    (alvo / "painel.html").write_text(MODELO_PAINEL.read_text())
    (alvo / "dados.json").write_text(
        json.dumps(dados_do_painel(con), ensure_ascii=False, separators=(",", ":")))
    (alvo / "vivo.json").write_text(
        json.dumps(estado_vivo(con, FONTES[0][2], _nome_da_esteira(con)),
                   ensure_ascii=False, separators=(",", ":")))
    con.close()
    for f in ("painel.html", "dados.json", "vivo.json"):
        print(f"  {(alvo/f).stat().st_size/1024:8.0f} KB  {alvo/f}")
    print("\nAbrir o painel exige servi-lo — abrir o arquivo direto não funciona:")
    print(f"  orq-medir servir")
    return 0


def cmd_servir(args):
    """Servidor mínimo, preso ao endereço local.

    Nunca ouve fora do laço de retorno: o painel carrega título de tarefa e texto
    de comentário do projeto, e expor isso na internet seria uma decisão de outra
    natureza. O acesso de fora se faz por túnel.
    """
    import http.server

    modelo = MODELO_PAINEL.read_text()
    armazem = args.armazem

    class Mao(http.server.BaseHTTPRequestHandler):
        def _envia(self, corpo, tipo):
            dados = corpo.encode()
            self.send_response(200)
            self.send_header("Content-Type", tipo + "; charset=utf-8")
            self.send_header("Content-Length", str(len(dados)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(dados)

        def do_GET(self):
            caminho = self.path.split("?")[0]
            try:
                if caminho in ("/", "/painel.html"):
                    return self._envia(modelo, "text/html")
                if caminho == "/dados.json":
                    con = abrir(armazem)
                    try:
                        return self._envia(json.dumps(dados_do_painel(con), ensure_ascii=False),
                                           "application/json")
                    finally:
                        con.close()
                if caminho == "/vivo.json":
                    con = abrir(armazem)
                    try:
                        estado = estado_vivo(con, FONTES[0][2], _nome_da_esteira(con))
                        gravar_amostras(con, estado["sessoes"])
                        return self._envia(json.dumps(estado, ensure_ascii=False),
                                           "application/json")
                    finally:
                        con.close()
            except Exception as erro:                       # noqa: BLE001
                self.send_error(500, str(erro)[:200])
                return
            self.send_error(404)

        def log_message(self, *_):
            pass                                            # o diário do sistema já registra

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", args.porta), Mao)
    print(f"painel em http://127.0.0.1:{args.porta} (só endereço local)")
    print("de outra máquina, abra um túnel:")
    print(f"  ssh -N -L {args.porta}:127.0.0.1:{args.porta} {os.environ.get('USER','orq')}@<endereço da vps>")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="orq-medir",
        description="Mede a esteira a partir do rastro que ela já deixa.")
    p.add_argument("--armazem", default=str(ARMAZEM_PADRAO),
                   help="onde fica o armazém (padrão: %(default)s)")
    sub = p.add_subparsers(dest="comando", required=True)

    s = sub.add_parser("esquema", help="cria ou atualiza o armazém")
    s.set_defaults(func=cmd_esquema)

    s = sub.add_parser("coletar", help="varre as fontes e preenche; seguro repetir")
    s.add_argument("--sem-rede", action="store_true",
                   help="não consulta o ClickUp")
    s.set_defaults(func=cmd_coletar)

    s = sub.add_parser("resumo", help="imprime os números principais")
    s.set_defaults(func=cmd_resumo)

    s = sub.add_parser("exportar", help="o JSON bruto de tudo")
    s.add_argument("--saida", default="-", help="arquivo de destino (padrão: a tela)")
    s.set_defaults(func=cmd_exportar)

    s = sub.add_parser("painel", help="gera a página e os dados num diretório")
    s.add_argument("--saida", default=str(pathlib.Path.home() / ".claude/orchestrator/painel"),
                   help="diretório de destino (padrão: %(default)s)")
    s.set_defaults(func=cmd_painel)

    s = sub.add_parser("servir", help="serve o painel no endereço local")
    s.add_argument("--porta", type=int, default=8787, help="porta (padrão: %(default)s)")
    s.set_defaults(func=cmd_servir)

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
