# Copie para ~/.config/orquestrador/credenciais.env e proteja: chmod 600
#
# Token PESSOAL do ClickUp (Settings → Apps → API Token). Ele carrega a sua
# autoria: tudo que a esteira escrever aparece como escrito por você. Não use
# token de outra pessoa, e não deixe este arquivo entrar em repositório nenhum.
CLICKUP_API_KEY=pk_SEUID_SEU-TOKEN-AQUI

# ── Aviso: como a esteira te encontra quando precisa de você ────────────────
# Numa máquina sem tela, notificação de sistema não existe e o registro em
# arquivo não é lido por ninguém — a espera humana fica silenciosa. Escolha um
# destino de verdade. Vários, separados por vírgula, também vale.
#
# ORQ_AVISO_DESTINO=macos
# ORQ_AVISO_DESTINO=clickup
#   ORQ_AVISO_CANAL=xxxxxxx-0000        canal de conversa (a sua DM serve)
#   ORQ_AVISO_WORKSPACE=0000000000      id do espaço de trabalho
#   ORQ_AVISO_MENCIONAR=00000000        seu id, para a mensagem te marcar
#   ORQ_AVISO_RODAPE=esteira na VPS — ssh orq@host, depois: orq status
# ORQ_AVISO_DESTINO=webhook
#   ORQ_AVISO_WEBHOOK=https://...       recebe um POST em JSON
