[Unit]
Description=Coleta as métricas da esteira a cada cinco minutos

[Timer]
OnCalendar=*:0/5
# Persistent recupera a coleta perdida enquanto a máquina esteve fora do ar.
Persistent=true
# Espalha o disparo para não cair junto com o pico da esteira.
RandomizedDelaySec=45

[Install]
WantedBy=timers.target
