#!/usr/bin/env python3
"""`claude` de mentira para os testes do lançador (OA-05): nenhum teste
automatizado sobe uma sessão real do Claude Code.

Registra os argumentos recebidos (se FAKE_CLAUDE_LOG apontar para um
arquivo) e dorme — o bastante para os testes de sessão viva checarem via
tmux/PID antes de decidir encerrar.
"""
import json
import os
import sys
import time

registro = os.environ.get("FAKE_CLAUDE_LOG")
if registro:
    with open(registro, "a") as f:
        f.write(json.dumps(sys.argv[1:]) + "\n")

time.sleep(float(os.environ.get("FAKE_CLAUDE_SLEEP", "30")))
