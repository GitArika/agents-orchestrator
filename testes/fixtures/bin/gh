#!/usr/bin/env python3
"""`gh` de mentira para os testes: nenhum teste automatizado deve depender da
API real do GitHub nem de um repositório `acme/x` que não existe.

Quatro formatos de `gh pr view <numero> --repo <repo>`:

  * `--json number` — o que `_pr_existe` (OA-05) chama. Sai 0 (PR existe) se
    `<numero>` estiver na lista `FAKE_GH_PRS_OK` (separada por vírgula), ou
    se essa variável for "*" (todos existem — o padrão para testes que não
    estão testando ESTA checagem). Sai 1 (PR não existe) caso contrário.

  * SEM `--json` — a visão padrão, que também busca o status dos checks de CI.
    Responde como `--json number`, exceto com `FAKE_GH_SEM_CHECKS=1`: aí falha
    como falha um token sem leitura de checks, com o PR existindo. Nada no
    motor deve chamar esta forma; a variável existe para provar isso.

  * `--json state,mergedAt,...` — o que `_consultar_pr`/`vigiar_prs` (OA-08)
    chama. Imprime um JSON montado por PR a partir de três variáveis, todas
    por número de PR:
      `FAKE_GH_PR_STATE_<numero>`  — OPEN | MERGED | CLOSED (padrão OPEN)
      `FAKE_GH_PR_REVIEW_<numero>` — ex. CHANGES_REQUESTED (padrão vazio/null)
      `FAKE_GH_PR_DRAFT_<numero>`  — 1/true (padrão falso)
    `FAKE_GH_PR_FAIL_<numero>=1` (ou `FAKE_GH_FAIL_ALL=1`) simula o `gh`
    fora do ar: sai 1 com uma mensagem em stderr, sem imprimir JSON nenhum.

  * `--json reviews` — o que `_coletar_retrabalho` (OA-09) chama. Imprime
    `{"reviews": <FAKE_GH_PR_REVIEWS_<numero>, um array JSON, padrão []>}`.

`gh api --paginate repos/<owner>/<repo>/pulls/<numero>/comments` — os
comentários de LINHA que `_coletar_retrabalho` (OA-09) busca à parte (é uma
chamada REST, não `pr view`). Imprime `FAKE_GH_PR_COMMENTS_<numero>` (um
array JSON, padrão []).

`gh auth status` e `gh pr list --repo <repo> --limit N` — o que `_prova_gh`
(OA-12) chama. `FAKE_GH_AUTH_OK` (padrão "1") e `FAKE_GH_PR_LIST_OK`
(padrão "1"): "0" simula a falha correspondente, saindo 1 com stderr.
"""
import json
import os
import re
import sys

if len(sys.argv) >= 3 and sys.argv[1] == "auth" and sys.argv[2] == "status":
    if os.environ.get("FAKE_GH_AUTH_OK", "1") == "1":
        sys.stderr.write("Logged in to github.com as teste (fake)\n")
        sys.exit(0)
    sys.stderr.write("You are not logged into any GitHub hosts.\n")
    sys.exit(1)

if len(sys.argv) >= 2 and sys.argv[1] == "pr" and len(sys.argv) > 2 and sys.argv[2] == "list":
    if os.environ.get("FAKE_GH_PR_LIST_OK", "1") == "1":
        print("[]")
        sys.exit(0)
    sys.stderr.write("gh: erro simulado de rede\n")
    sys.exit(1)

if len(sys.argv) >= 3 and sys.argv[1] == "pr" and sys.argv[2] == "view":
    numero = sys.argv[3] if len(sys.argv) > 3 else ""

    ok = os.environ.get("FAKE_GH_PRS_OK", "*")
    existe = ok == "*" or numero in {n.strip() for n in ok.split(",") if n.strip()}

    if "--json" in sys.argv:
        campos = sys.argv[sys.argv.index("--json") + 1]
        if campos == "number":
            if existe:
                print(json.dumps({"number": int(numero)}))
                sys.exit(0)
            sys.stderr.write(f"GraphQL: Could not resolve to a PullRequest with the number of {numero}.\n")
            sys.exit(1)
        if campos == "reviews":
            bruto = os.environ.get(f"FAKE_GH_PR_REVIEWS_{numero}", "[]")
            print(json.dumps({"reviews": json.loads(bruto)}))
            sys.exit(0)
        if (os.environ.get("FAKE_GH_FAIL_ALL") == "1"
                or os.environ.get(f"FAKE_GH_PR_FAIL_{numero}") == "1"):
            sys.stderr.write("gh: erro simulado de rede\n")
            sys.exit(1)
        estado = os.environ.get(f"FAKE_GH_PR_STATE_{numero}", "OPEN")
        review = os.environ.get(f"FAKE_GH_PR_REVIEW_{numero}", "") or None
        rascunho = os.environ.get(f"FAKE_GH_PR_DRAFT_{numero}", "").strip().lower() in (
            "1", "true", "sim")
        print(json.dumps({
            "state": estado, "mergedAt": None, "mergeCommit": None,
            "reviewDecision": review, "isDraft": rascunho, "updatedAt": "",
        }))
        sys.exit(0)

    if os.environ.get("FAKE_GH_SEM_CHECKS") == "1":
        sys.stderr.write("GraphQL: Resource not accessible by personal access token "
                         "(repository.pullRequest.statusCheckRollup.nodes.0)\n")
        sys.exit(1)
    sys.exit(0 if existe else 1)

if len(sys.argv) >= 2 and sys.argv[1] == "api":
    caminho_api = next((a for a in sys.argv[2:] if not a.startswith("-")), "")
    m = re.match(r"repos/[^/]+/[^/]+/pulls/(\d+)/comments", caminho_api)
    if m:
        numero = m.group(1)
        print(os.environ.get(f"FAKE_GH_PR_COMMENTS_{numero}", "[]"))
        sys.exit(0)
    sys.exit(1)

sys.exit(1)
