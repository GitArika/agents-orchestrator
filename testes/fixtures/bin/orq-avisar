#!/usr/bin/env python3
"""`orq-avisar` de mentira para os testes do roteamento de avisos (OA-11):
nenhum teste automatizado manda mensagem de verdade a canal nenhum — nem
Telegram, nem ClickUp, nem notificação do macOS —, mesmo que a máquina que
roda a suíte tenha credenciais reais em
~/.config/orquestrador/credenciais.env.

Registra cada chamada como uma linha JSON em `FAKE_AVISAR_LOG` (se definido):
título, mensagem, `--canal` (se houver) e `ORQ_UNIT`. Sem `FAKE_AVISAR_LOG`
definido, só sai 0 sem fazer nada — o padrão seguro que todo teste deste
repositório usa como `ORQ_NOTIFY_CMD`, para que disparar uma transição
roteada (bloqueada, despachada, pr_aberto...) durante a suíte nunca tente uma
entrega de verdade.
"""
import json
import os
import sys

registro = os.environ.get("FAKE_AVISAR_LOG")
if registro:
    argv = sys.argv[1:]
    canal = None
    if "--canal" in argv:
        i = argv.index("--canal")
        canal = argv[i + 1] if i + 1 < len(argv) else None
        argv = argv[:i] + argv[i + 2:]
    with open(registro, "a") as f:
        f.write(json.dumps({
            "titulo": argv[0] if len(argv) > 0 else "",
            "msg": argv[1] if len(argv) > 1 else "",
            "canal": canal,
            "unidade": os.environ.get("ORQ_UNIT", ""),
        }) + "\n")

sys.exit(0)
