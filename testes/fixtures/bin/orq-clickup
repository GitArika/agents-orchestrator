#!/usr/bin/env python3
"""`orq-clickup` de mentira para os testes: nenhum teste automatizado fala
com a API real do ClickUp — o `orq-clickup` de verdade é Node.js e precisa
de credencial e rede.

Entende `set-status <taskId> <status...>` — o único verbo que o motor chama
(`_espelhar_pronto`, OA-07). Sai 0 sempre, a menos que `FAKE_CLICKUP_FAIL=1`
esteja no ambiente (simula o ClickUp fora do ar: sai 1 com stderr). Se
`FAKE_CLICKUP_LOG` estiver definido, registra cada chamada bem-sucedida como
uma linha JSON — usado pelos testes que precisam provar O QUE foi escrito,
não só que a escrita não travou a esteira.
"""
import json
import os
import sys

if len(sys.argv) >= 2 and sys.argv[1] == "set-status":
    if os.environ.get("FAKE_CLICKUP_FAIL") == "1":
        sys.stderr.write("orq-clickup: erro simulado de rede\n")
        sys.exit(1)
    registro = os.environ.get("FAKE_CLICKUP_LOG")
    if registro:
        task_id = sys.argv[2] if len(sys.argv) > 2 else ""
        status = " ".join(sys.argv[3:])
        with open(registro, "a") as f:
            f.write(json.dumps({"taskId": task_id, "status": status}) + "\n")
    sys.exit(0)

sys.exit(1)
